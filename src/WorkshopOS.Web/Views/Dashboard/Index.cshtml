@model WorkshopOS.Web.Models.Reporting.DashboardViewModel
@using WorkshopOS.Web.Models.Reporting
@{
    ViewData["Title"] = Localizer["Dashboard_Title"];
    var periodLabel = UiFormatting.FormatReportingPeriod(Model.Header);
    var locationLabel = UiFormatting.FormatLocationScope(Model.Header.WorkshopLocationName);
}

<div class="wos-dashboard-v3" data-wos-dashboard-motion>
<div class="wos-dash-hero wos-dashboard-entrance">
    <div class="wos-dash-hero-inner">
        <div>
            <p class="wos-page-eyebrow" style="color: var(--wos-accent-teal);">@Localizer["Dashboard_Eyebrow"]</p>
            <h1>@Localizer["Dashboard_Title"]</h1>
            <p class="wos-dash-hero-meta">
                @locationLabel · @Model.Header.TimeZoneId · @Localizer["Common_GeneratedAt", UiFormatting.FormatGeneratedAt(Model.Header.GeneratedAtUtc, Model.Header.TimeZoneId)]
            </p>
        </div>
        <div class="wos-dash-hero-actions">
            <a class="btn btn-outline-light btn-sm" asp-controller="Reports" asp-action="Operations">@Localizer["Dashboard_OperationsReport"]</a>
            <a class="btn btn-outline-light btn-sm" asp-controller="Reports" asp-action="Commercial">@Localizer["Dashboard_CommercialReport"]</a>
        </div>
    </div>
</div>

<div class="wos-reveal wos-reveal-up">
    @await Html.PartialAsync("_ReportingFilter", Model.Filter)
</div>

<div class="wos-report-section wos-reveal wos-reveal-up">
    <div class="wos-report-section-header">
        <h2>@Localizer["Dashboard_Section_CurrentSnapshot"]</h2>
        <p>@Localizer["Dashboard_Section_CurrentSnapshot_Description"]</p>
    </div>
    <div class="wos-kpi-grid" data-wos-reveal-stagger>
        <div class="wos-card wos-kpi-card is-snapshot">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_ActiveRepairOrders"]</div>
            <div class="wos-metric-value">@Model.CurrentSnapshot.ActiveRepairOrders</div>
            <a asp-controller="RepairOrders" asp-action="Index" class="wos-kpi-link">@Localizer["Dashboard_Link_ViewRepairOrders"]</a>
        </div>
        <div class="wos-card wos-kpi-card is-snapshot">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_UnassignedJobs"]</div>
            <div class="wos-metric-value">@Model.CurrentSnapshot.UnassignedRepairOrders</div>
            <a asp-controller="Operations" asp-action="Index" asp-route-unassignedOnly="true" class="wos-kpi-link">@Localizer["Dashboard_Link_OperationsBoard"]</a>
        </div>
        <div class="wos-card wos-kpi-card is-snapshot">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_UrgentJobs"]</div>
            <div class="wos-metric-value">@Model.CurrentSnapshot.UrgentRepairOrders</div>
        </div>
        <div class="wos-card wos-kpi-card is-snapshot">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_TechniciansInProgress"]</div>
            <div class="wos-metric-value">@Model.CurrentSnapshot.TechniciansCurrentlyWorking</div>
        </div>
        <div class="wos-card wos-kpi-card is-snapshot">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_OpenDvi"]</div>
            <div class="wos-metric-value">@Model.CurrentSnapshot.OpenDviInspections</div>
            <a asp-controller="Inspections" asp-action="Index" class="wos-kpi-link">@Localizer["Dashboard_Link_ViewInspections"]</a>
        </div>
        <div class="wos-card wos-kpi-card is-snapshot">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_EstimatesAwaitingDecision"]</div>
            <div class="wos-metric-value">@Model.CurrentSnapshot.EstimatesAwaitingDecision</div>
            <a asp-controller="Estimates" asp-action="Index" class="wos-kpi-link">@Localizer["Dashboard_Link_ViewEstimates"]</a>
        </div>
        <div class="wos-card wos-kpi-card is-snapshot">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_OutstandingInvoices"]</div>
            <div class="wos-metric-value">@Model.CurrentSnapshot.OutstandingInvoices</div>
            @if (Model.CurrentSnapshot.CurrentOutstandingAmounts.Count == 0)
            {
                <div class="small text-muted mt-1">@Localizer["Dashboard_NoOutstandingInvoices"]</div>
            }
            else
            {
                foreach (var amount in Model.CurrentSnapshot.CurrentOutstandingAmounts)
                {
                    <div class="small wos-money-line mt-1">@ReportingDisplayFormatter.FormatMoney(amount)</div>
                }
            }
            <a asp-controller="Invoices" asp-action="Index" class="wos-kpi-link">@Localizer["Dashboard_Link_ViewInvoices"]</a>
        </div>
        <div class="wos-card wos-kpi-card is-snapshot">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_CommerciallyClosableJobs"]</div>
            <div class="wos-metric-value">@Model.CurrentSnapshot.CommerciallyClosableJobs</div>
            <a asp-controller="RepairOrders" asp-action="Index" class="wos-kpi-link">@Localizer["Dashboard_Link_ReviewJobs"]</a>
        </div>
    </div>
</div>

<div class="wos-report-section wos-reveal wos-reveal-up">
    <div class="wos-report-section-header">
        <h2>@Localizer["Dashboard_Section_PeriodPerformance"]</h2>
        <p>@Localizer["Dashboard_Section_PeriodPerformance_Description", periodLabel]</p>
    </div>
    <div class="wos-kpi-grid" data-wos-reveal-stagger>
        <div class="wos-card wos-kpi-card is-period">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_AppointmentsScheduled", periodLabel]</div>
            <div class="wos-metric-value">@Model.SelectedPeriod.AppointmentsScheduled</div>
            <a asp-controller="Appointments" asp-action="Index" class="wos-kpi-link">@Localizer["Dashboard_Link_Appointments"]</a>
        </div>
        <div class="wos-card wos-kpi-card is-period">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_RepairOrdersOpened", periodLabel]</div>
            <div class="wos-metric-value">@Model.SelectedPeriod.RepairOrdersOpened</div>
        </div>
        <div class="wos-card wos-kpi-card is-period">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_RepairOrdersCompleted", periodLabel]</div>
            <div class="wos-metric-value">@Model.SelectedPeriod.RepairOrdersCompleted</div>
        </div>
        <div class="wos-card wos-kpi-card is-period">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_InspectionsCompleted", periodLabel]</div>
            <div class="wos-metric-value">@Model.SelectedPeriod.InspectionsCompleted</div>
        </div>
        <div class="wos-card wos-kpi-card is-period">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_CriticalFindings", periodLabel]</div>
            <div class="wos-metric-value">@Model.SelectedPeriod.CriticalInspectionFindings</div>
        </div>
        <div class="wos-card wos-kpi-card is-period">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_EstimatesPresented", periodLabel]</div>
            <div class="wos-metric-value">@Model.SelectedPeriod.EstimatesPresented</div>
        </div>
        <div class="wos-card wos-kpi-card is-period">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_DecisionApprovalRate"]</div>
            <div class="wos-metric-value">@ReportingDisplayFormatter.FormatApprovalRate(Model.SelectedPeriod.DecisionApprovalRate)</div>
        </div>
        <div class="wos-card wos-kpi-card is-period">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_CommerciallyClosed", periodLabel]</div>
            <div class="wos-metric-value">@Model.SelectedPeriod.CommerciallyClosedJobs</div>
        </div>
    </div>
</div>

<div class="wos-report-section wos-reveal wos-reveal-up">
    <div class="wos-report-section-header">
        <h2>@Localizer["Dashboard_Section_CommercialHealth"]</h2>
        <p>@Localizer["Dashboard_Section_CommercialHealth_Description"]</p>
    </div>
    <div class="wos-kpi-grid" data-wos-reveal-stagger>
        <div class="wos-card wos-kpi-card is-commercial">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_InvoicesIssued", periodLabel]</div>
            <div class="wos-metric-value">@Model.SelectedPeriod.InvoicesIssued</div>
        </div>
        <div class="wos-card wos-kpi-card is-commercial">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_RecordedPayments", periodLabel]</div>
            @if (Model.SelectedPeriod.RecordedPayments.Count == 0)
            {
                <div class="text-muted mt-2">@Localizer["Dashboard_NoActivityInPeriod"]</div>
            }
            else
            {
                foreach (var payment in Model.SelectedPeriod.RecordedPayments)
                {
                    <div class="wos-metric-value fs-5 mt-1">@ReportingDisplayFormatter.FormatMoney(payment)</div>
                }
            }
        </div>
        <div class="wos-card wos-kpi-card is-commercial">
            <div class="wos-metric-label">@Localizer["Dashboard_Kpi_InvoicedAmounts", periodLabel]</div>
            @if (Model.SelectedPeriod.InvoicedAmounts.Count == 0)
            {
                <div class="text-muted mt-2">@Localizer["Dashboard_NoActivityInPeriod"]</div>
            }
            else
            {
                foreach (var amount in Model.SelectedPeriod.InvoicedAmounts)
                {
                    <div class="wos-metric-value fs-5 mt-1">@ReportingDisplayFormatter.FormatMoney(amount)</div>
                }
            }
        </div>
    </div>
</div>
</div>
