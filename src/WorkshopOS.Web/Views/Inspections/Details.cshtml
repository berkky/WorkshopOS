@model WorkshopOS.Web.Models.Inspections.InspectionDetailsViewModel
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = $"Inspection — {Model.RepairOrderNumber}";
    var isCompleted = Model.Status == WorkshopOS.Domain.Inspections.InspectionStatus.Completed;
}

@await Html.PartialAsync("_DetailWorkspaceHeader", new DetailWorkspaceHeaderViewModel
{
    Eyebrow = Localizer["Inspections_Eyebrow"].Value,
    Title = Model.RepairOrderNumber,
    Meta = new HtmlString($"""
        {Model.CustomerDisplayName} · {Model.VehicleSummary} · {Model.WorkshopLocationName}
        · <a href="{Url.Action("Details", "RepairOrders", new { repairOrderId = Model.RepairOrderId })}">@Localizer["Appointments_ViewRepairOrder"]</a>
        """),
    StatusBadges = await Html.PartialAsync("_StatusBadge", StatusPresentation.ForInspection(Model.Status))
})

<div class="wos-action-cluster mb-4">
    @if (Model.CanStart && Model.Status == WorkshopOS.Domain.Inspections.InspectionStatus.Draft)
    {
        <form asp-action="Start" asp-route-inspectionId="@Model.InspectionId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-wos-primary">@Localizer["Inspections_StartInspection"]</button>
        </form>
    }
    <a asp-controller="Estimates" asp-action="Index" asp-route-repairOrderId="@Model.RepairOrderId" class="btn btn-outline-secondary">@Localizer["RepairOrders_Estimates"]</a>
    <a asp-action="Index" class="btn btn-wos-quiet">@Localizer["Inspections_AllInspections"]</a>
</div>

@if (TempData["InspectionError"] is string inspectionError)
{
    <div class="alert alert-warning">@inspectionError</div>
}

<div class="wos-inspection-summary">
    <div class="wos-inspection-stat">
        <div class="wos-inspection-stat-label">@Localizer["Inspections_TotalItems"]</div>
        <div class="wos-inspection-stat-value">@Model.Summary.Total</div>
    </div>
    <div class="wos-inspection-stat">
        <div class="wos-inspection-stat-label">@Localizer["Inspections_Inspected"]</div>
        <div class="wos-inspection-stat-value">@Model.Summary.Inspected</div>
    </div>
    <div class="wos-inspection-stat">
        <div class="wos-inspection-stat-label">@Localizer["Inspections_Good"]</div>
        <div class="wos-inspection-stat-value"><partial name="_StatusBadge" model="StatusPresentation.ForInspectionCondition(WorkshopOS.Domain.Inspections.InspectionCondition.Good)" /> @Model.Summary.Good</div>
    </div>
    <div class="wos-inspection-stat">
        <div class="wos-inspection-stat-label">@Localizer["Inspections_Monitor"]</div>
        <div class="wos-inspection-stat-value"><partial name="_StatusBadge" model="StatusPresentation.ForInspectionCondition(WorkshopOS.Domain.Inspections.InspectionCondition.Monitor)" /> @Model.Summary.Monitor</div>
    </div>
    <div class="wos-inspection-stat">
        <div class="wos-inspection-stat-label">@Localizer["Inspections_Attention"]</div>
        <div class="wos-inspection-stat-value"><partial name="_StatusBadge" model="StatusPresentation.ForInspectionCondition(WorkshopOS.Domain.Inspections.InspectionCondition.Attention)" /> @Model.Summary.Attention</div>
    </div>
    <div class="wos-inspection-stat">
        <div class="wos-inspection-stat-label">@Localizer["Inspections_Critical"]</div>
        <div class="wos-inspection-stat-value"><partial name="_StatusBadge" model="StatusPresentation.ForInspectionCondition(WorkshopOS.Domain.Inspections.InspectionCondition.Critical)" /> @Model.Summary.Critical</div>
    </div>
    <div class="wos-inspection-stat">
        <div class="wos-inspection-stat-label">@Localizer["Inspections_PhotoEvidence"]</div>
        <div class="wos-inspection-stat-value">@Model.ActivePhotoCount</div>
    </div>
</div>

<div class="wos-detail-grid mb-4">
    <section class="wos-detail-panel">
        <h2 class="wos-detail-panel-title">@Localizer["Appointments_JobContext"]</h2>
        <dl class="wos-dl">
            <div class="wos-dl-row">
                <dt>@Localizer["Common_Status"]</dt>
                <dd><partial name="_StatusBadge" model="StatusPresentation.ForInspection(Model.Status)" /></dd>
            </div>
            <div class="wos-dl-row">
                <dt>@Localizer["Common_Customer"]</dt>
                <dd>@Model.CustomerDisplayName</dd>
            </div>
            <div class="wos-dl-row">
                <dt>@Localizer["Common_Vehicle"]</dt>
                <dd>@Model.VehicleSummary</dd>
            </div>
            <div class="wos-dl-row">
                <dt>@Localizer["Common_Location"]</dt>
                <dd>@Model.WorkshopLocationName</dd>
            </div>
            @if (Model.StartedAtUtc.HasValue)
            {
                <div class="wos-dl-row">
                    <dt>@Localizer["Inspections_Started"]</dt>
                    <dd>@UiFormatting.FormatDateTime(Model.StartedAtUtc.Value)</dd>
                </div>
            }
            @if (Model.CompletedAtUtc.HasValue)
            {
                <div class="wos-dl-row">
                    <dt>@Localizer["Common_Completed"]</dt>
                    <dd>@UiFormatting.FormatDateTime(Model.CompletedAtUtc.Value)</dd>
                </div>
            }
        </dl>
    </section>
</div>

@if (Model.CanUpdateItems)
{
    <form asp-action="UpdateItems" asp-route-inspectionId="@Model.InspectionId" method="post">
        @Html.AntiForgeryToken()
        @{
            var itemIndex = 0;
        }
        @foreach (var sectionGroup in Model.Sections)
        {
            <section class="wos-inspection-section">
                <h2 class="wos-inspection-section-title">@sectionGroup.Section</h2>
                <div class="wos-table-wrap">
                    <table class="table table-striped mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>@Localizer["Inspections_Item"]</th>
                                <th>@Localizer["Inspections_Condition"]</th>
                                <th>@Localizer["Inspections_Notes"]</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in sectionGroup.Items.OrderBy(candidate => candidate.SortOrder))
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>
                                    <input type="hidden" name="editableItems[@itemIndex].InspectionItemId" value="@item.InspectionItemId" />
                                    <select name="editableItems[@itemIndex].Condition" class="form-select" aria-label="@string.Format(Localizer["Inspections_ConditionAria"].Value, item.Name)">
                                        @foreach (var condition in Enum.GetValues<WorkshopOS.Domain.Inspections.InspectionCondition>())
                                        {
                                            <option value="@condition" selected="@(item.Condition == condition)">@condition</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input name="editableItems[@itemIndex].Notes" value="@item.Notes" class="form-control" maxlength="2000" aria-label="@string.Format(Localizer["Inspections_NotesAria"].Value, item.Name)" />
                                </td>
                            </tr>
                            itemIndex++;
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        <div class="mb-4 mt-3">
            <button type="submit" class="btn btn-wos-primary">@Localizer["Inspections_SaveInspection"]</button>
        </div>
    </form>
    @if (Model.CanComplete)
    {
        <form asp-action="Complete" asp-route-inspectionId="@Model.InspectionId" method="post" class="mb-4">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success">@Localizer["Inspections_CompleteInspection"]</button>
        </form>
    }
}
else
{
    @foreach (var sectionGroup in Model.Sections)
    {
        <section class="wos-inspection-section">
            <h2 class="wos-inspection-section-title">@sectionGroup.Section</h2>
            <div class="wos-table-wrap">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>@Localizer["Inspections_Item"]</th>
                            <th>@Localizer["Inspections_Condition"]</th>
                            <th>@Localizer["Inspections_Notes"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in sectionGroup.Items.OrderBy(candidate => candidate.SortOrder))
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>
                                <partial name="_StatusBadge" model="StatusPresentation.ForInspectionCondition(item.Condition)" />
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(item.Notes) ? Localizer["Common_NoValue"].Value : item.Notes)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (isCompleted)
    {
        <p class="text-muted">@Localizer["Inspections_CompletedReadOnly"]</p>
    }
}

@if (Model.Sections.Any(section => section.Items.Any(item => item.Media.Count > 0)) || Model.CanUploadMedia)
{
    ViewData["InspectionId"] = Model.InspectionId;
    ViewData["CanRemoveMedia"] = Model.CanRemoveMedia;
    <section class="wos-workspace-section">
        <h2 class="wos-section-title">@Localizer["Inspections_PhotoEvidence"]</h2>
        @foreach (var sectionGroup in Model.Sections)
        {
            @foreach (var item in sectionGroup.Items.OrderBy(candidate => candidate.SortOrder))
            {
                <div class="wos-detail-panel mb-3">
                    <div class="fw-semibold">@sectionGroup.Section — @item.Name</div>
                    <div class="small text-muted mb-2">@string.Format(Localizer["Inspections_PhotoCount"].Value, item.Media.Count)</div>
                    @if (item.Media.Count > 0)
                    {
                        @await Html.PartialAsync("_InspectionItemMedia", item)
                    }
                    @if (Model.CanUploadMedia)
                    {
                        <form asp-action="UploadPhoto"
                              asp-route-inspectionId="@Model.InspectionId"
                              asp-route-inspectionItemId="@item.InspectionItemId"
                              method="post"
                              enctype="multipart/form-data"
                              class="row g-2 align-items-end mt-2 wos-filter-bar">
                            @Html.AntiForgeryToken()
                            <div class="col-md-5">
                                <label class="form-label">@Localizer["Inspections_PhotoLabel"]</label>
                                <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">@Localizer["Inspections_CaptionOptional"]</label>
                                <input type="text" name="caption" class="form-control" maxlength="500" />
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-outline-primary">@Localizer["Inspections_UploadPhoto"]</button>
                            </div>
                        </form>
                    }
                </div>
            }
        }
    </section>
}
