@model WorkshopOS.Web.Models.Inspections.InspectionListViewModel
@{
    ViewData["Title"] = Localizer["Inspections_Title"].Value;
}

<header class="wos-page-header">
    <div>
        <h1 class="wos-page-title">@Localizer["Inspections_Title"]</h1>
        <p class="wos-page-description">@string.Format(Localizer["Inspections_CountInView"].Value, Model.TotalCount)</p>
    </div>
    <div class="wos-page-actions">
        <a asp-controller="RepairOrders" asp-action="Index" class="btn btn-outline-secondary">@Localizer["RepairOrders_Title"]</a>
    </div>
</header>

<form asp-action="Index" method="get" class="wos-filter-bar row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label">@Localizer["Common_Search"]</label>
        <input name="search" value="@Model.Search" class="form-control" placeholder="@Localizer["Inspections_SearchPlaceholder"]" />
    </div>
    <div class="col-md-2">
        <label class="form-label">@Localizer["Common_Status"]</label>
        <select name="status" class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<WorkshopOS.Domain.Inspections.InspectionStatus>()">
            <option value="">@Localizer["Common_AllStatuses"]</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">@Localizer["Common_Location"]</label>
        <select name="workshopLocationId" class="form-select">
            <option value="">@Localizer["Common_AllLocations"]</option>
            @foreach (var location in Model.LocationOptions)
            {
                <option value="@location.WorkshopLocationId" selected="@(Model.WorkshopLocationId == location.WorkshopLocationId)">@location.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">@Localizer["Common_Filter"]</button>
    </div>
</form>

@if (Model.Inspections.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = Localizer["Inspections_NoInspections"].Value, Description = Localizer["Inspections_NoFilters"].Value })
}
else
{
    <div class="wos-table-wrap wos-desktop-table">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@Localizer["Inspections_RepairOrder"]</th>
                    <th>@Localizer["Common_Customer"]</th>
                    <th>@Localizer["Common_Vehicle"]</th>
                    <th>@Localizer["Common_Location"]</th>
                    <th>@Localizer["Common_Status"]</th>
                    <th>@Localizer["Common_Progress"]</th>
                    <th>@Localizer["Common_Created"]</th>
                    <th>@Localizer["Common_Completed"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var inspection in Model.Inspections)
            {
                <tr>
                    <td>
                        <a asp-controller="RepairOrders" asp-action="Details" asp-route-repairOrderId="@inspection.RepairOrderId">@inspection.RepairOrderNumber</a>
                    </td>
                    <td>@inspection.CustomerDisplayName</td>
                    <td>@inspection.VehicleSummary</td>
                    <td>@inspection.WorkshopLocationName</td>
                    <td><partial name="_StatusBadge" model="StatusPresentation.ForInspection(inspection.Status)" /></td>
                    <td>@inspection.InspectedItems / @inspection.TotalItems</td>
                    <td>@UiFormatting.FormatDateTime(inspection.CreatedAtUtc)</td>
                    <td>@(inspection.CompletedAtUtc.HasValue ? UiFormatting.FormatDateTime(inspection.CompletedAtUtc.Value) : Localizer["Common_NoValue"].Value)</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-inspectionId="@inspection.InspectionId" class="btn btn-sm btn-outline-primary">@Localizer["Common_View"]</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
