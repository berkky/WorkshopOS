@model WorkshopOS.Web.Models.Inspections.InspectionListViewModel
@{
    ViewData["Title"] = "Inspections";
}

<header class="wos-page-header">
    <div>
        <h1 class="wos-page-title">Digital vehicle inspections</h1>
        <p class="wos-page-description">@Model.TotalCount inspection(s) in current view</p>
    </div>
    <div class="wos-page-actions">
        <a asp-controller="RepairOrders" asp-action="Index" class="btn btn-outline-secondary">Repair orders</a>
    </div>
</header>

<form asp-action="Index" method="get" class="wos-filter-bar row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label">Search</label>
        <input name="search" value="@Model.Search" class="form-control" placeholder="Repair order, customer, vehicle" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Status</label>
        <select name="status" class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<WorkshopOS.Domain.Inspections.InspectionStatus>()">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Location</label>
        <select name="workshopLocationId" class="form-select">
            <option value="">All locations</option>
            @foreach (var location in Model.LocationOptions)
            {
                <option value="@location.WorkshopLocationId" selected="@(Model.WorkshopLocationId == location.WorkshopLocationId)">@location.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
    </div>
</form>

@if (Model.Inspections.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = "No inspections", Description = "No inspections match the current filters." })
}
else
{
    <div class="wos-table-wrap wos-desktop-table">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Repair order</th>
                    <th>Customer</th>
                    <th>Vehicle</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Progress</th>
                    <th>Created</th>
                    <th>Completed</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var inspection in Model.Inspections)
            {
                <tr>
                    <td>
                        <a asp-controller="RepairOrders" asp-action="Details" asp-route-repairOrderId="@inspection.RepairOrderId">@inspection.RepairOrderNumber</a>
                    </td>
                    <td>@inspection.CustomerDisplayName</td>
                    <td>@inspection.VehicleSummary</td>
                    <td>@inspection.WorkshopLocationName</td>
                    <td><partial name="_StatusBadge" model="StatusPresentation.ForInspection(inspection.Status)" /></td>
                    <td>@inspection.InspectedItems / @inspection.TotalItems</td>
                    <td>@inspection.CreatedAtUtc.ToString("u")</td>
                    <td>@(inspection.CompletedAtUtc.HasValue ? inspection.CompletedAtUtc.Value.ToString("u") : "—")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-inspectionId="@inspection.InspectionId" class="btn btn-sm btn-outline-primary">View</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
