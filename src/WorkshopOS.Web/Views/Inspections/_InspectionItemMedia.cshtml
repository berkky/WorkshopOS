@model WorkshopOS.Web.Models.Inspections.InspectionItemDisplayViewModel

<div class="d-flex flex-wrap gap-3">
@foreach (var media in Model.Media)
{
    <div class="border rounded p-2" style="max-width: 220px;">
        <img src="/inspection-media/@media.MediaId/content"
             alt="Photo evidence for @Model.Name"
             loading="lazy"
             class="img-fluid rounded"
             style="max-height: 160px; object-fit: contain;" />
        @if (!string.IsNullOrWhiteSpace(media.Caption))
        {
            <div class="small mt-1">@media.Caption</div>
        }
        <div class="small text-muted">@media.UploadedAtUtc.ToString("u")</div>
        @if (ViewData["CanRemoveMedia"] as bool? == true)
        {
            <form asp-controller="Inspections"
                  asp-action="RemovePhoto"
                  asp-route-inspectionId="@ViewData["InspectionId"]"
                  asp-route-mediaId="@media.MediaId"
                  method="post"
                  class="mt-1">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
            </form>
        }
    </div>
}
</div>
