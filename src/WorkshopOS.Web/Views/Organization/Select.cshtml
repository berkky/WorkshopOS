@model WorkshopOS.Web.Models.Organizations.OrganizationSelectionViewModel
@{
    ViewData["Title"] = Localizer["Organization_Title"];
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = Localizer["Organization_Eyebrow"].Value,
    Title = Localizer["Organization_Title"].Value,
    Description = Localizer["Organization_Description"].Value
})

<form asp-action="Select" asp-controller="Organization" method="post" class="wos-form-shell">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReturnUrl" />
    <partial name="_FormValidationSummary" />

    <section class="wos-form-section">
        <h2 class="wos-form-section-title">@Localizer["Organization_Section_Available"]</h2>
        <div class="wos-choice-group">
            @for (var index = 0; index < Model.Organizations.Count; index++)
            {
                var organization = Model.Organizations[index];
                <div class="form-check">
                    <input class="form-check-input"
                           type="radio"
                           name="OrganizationId"
                           id="organization-@organization.OrganizationId"
                           value="@organization.OrganizationId"
                           @(index == 0 ? "checked" : null) />
                    <label class="form-check-label" for="organization-@organization.OrganizationId">
                        @organization.OrganizationName
                        <span class="text-muted">(@organization.MembershipRole)</span>
                    </label>
                </div>
            }
        </div>
    </section>

    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">@Localizer["Common_Continue"]</button>
    </div>
</form>
