@model WorkshopOS.Web.Models.Organizations.OrganizationSelectionViewModel
@{
    ViewData["Title"] = "Select organization";
}

<h1 class="display-6">Select organization</h1>
<p class="text-muted">Choose which workshop workspace to use for this session.</p>

<form asp-action="Select" asp-controller="Organization" method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @for (var index = 0; index < Model.Organizations.Count; index++)
    {
        var organization = Model.Organizations[index];
        <div class="form-check mb-2">
            <input class="form-check-input"
                   type="radio"
                   name="OrganizationId"
                   id="organization-@organization.OrganizationId"
                   value="@organization.OrganizationId"
                   @(index == 0 ? "checked" : null) />
            <label class="form-check-label" for="organization-@organization.OrganizationId">
                @organization.OrganizationName
                <span class="text-muted">(@organization.MembershipRole)</span>
            </label>
        </div>
    }

    <button type="submit" class="btn btn-primary mt-3">Continue</button>
</form>
