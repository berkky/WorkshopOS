@model WorkshopOS.Web.Models.Catalog.PartCatalogFormViewModel
@{
    ViewData["Title"] = "Create part";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Parts catalog",
    Title = "Create part",
    Description = "Add a part SKU for estimates, billing, and inventory tracking."
})

<form method="post" class="wos-form-shell">
    @Html.AntiForgeryToken()
    <partial name="_PartCatalogFormFields" model="Model" />
    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">Save</button>
        <a asp-action="Index" class="btn btn-wos-quiet">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
