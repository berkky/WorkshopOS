@model WorkshopOS.Web.Models.Catalog.PartCatalogFormViewModel
@{
    ViewData["Title"] = Localizer["PartCatalog_EditTitle"].Value;
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = Localizer["PartCatalog_Eyebrow"].Value,
    Title = Localizer["PartCatalog_EditTitle"].Value,
    Description = Model.Name
})

<form method="post" class="wos-form-shell">
    @Html.AntiForgeryToken()
    <partial name="_PartCatalogFormFields" model="Model" />
    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">@Localizer["Common_Save"]</button>
        <a asp-action="Index" class="btn btn-wos-quiet">@Localizer["Common_Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
