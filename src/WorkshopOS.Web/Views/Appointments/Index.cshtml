@model WorkshopOS.Web.Models.Appointments.AppointmentListViewModel
@{
    ViewData["Title"] = "Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="display-6">Appointments</h1>
        <p class="text-muted mb-0">@Model.TotalCount appointment(s) in current view</p>
    </div>
    <div>
        <a asp-action="Calendar" class="btn btn-outline-secondary">Calendar</a>
        @if (Model.CanManageAppointments)
        {
            <a asp-action="Create" class="btn btn-primary">Create appointment</a>
        }
    </div>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-2">
        <select name="workshopLocationId" class="form-select">
            <option value="">All locations</option>
            @foreach (var location in Model.LocationOptions)
            {
                <option value="@location.WorkshopLocationId" selected="@(Model.WorkshopLocationId == location.WorkshopLocationId)">@location.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<WorkshopOS.Domain.Appointments.AppointmentStatus>()">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
    </div>
</form>

@if (Model.Appointments.Count == 0)
{
    <div class="alert alert-light border">No appointments match the current filters.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>When</th>
                <th>Location</th>
                <th>Customer</th>
                <th>Vehicle</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var appointment in Model.Appointments)
        {
            <tr>
                <td>
                    @appointment.ScheduledStartLocal.ToString("g")
                    <div class="text-muted small">to @appointment.ScheduledEndLocal.ToString("t") (@appointment.TimeZoneId)</div>
                </td>
                <td>@appointment.WorkshopLocationName</td>
                <td>@appointment.CustomerDisplayName</td>
                <td>@appointment.VehicleSummary</td>
                <td>@appointment.Status</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-appointmentId="@appointment.AppointmentId" class="btn btn-sm btn-outline-primary">View</a>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @if ((int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize) > 1)
    {
        var totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
        <nav>
            <ul class="pagination">
                @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.Page ? "active" : null)">
                        <a class="page-link" asp-action="Index" asp-route-page="@pageNumber" asp-route-pageSize="@Model.PageSize" asp-route-workshopLocationId="@Model.WorkshopLocationId" asp-route-status="@Model.Status">@pageNumber</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
