@model WorkshopOS.Web.Models.Appointments.AppointmentListViewModel
@{
    ViewData["Title"] = "Appointments";
    var paginationRouteValues = new Dictionary<string, string>();
    if (Model.WorkshopLocationId.HasValue)
    {
        paginationRouteValues["workshopLocationId"] = Model.WorkshopLocationId.Value.ToString();
    }
    if (Model.Status.HasValue)
    {
        paginationRouteValues["status"] = Model.Status.Value.ToString();
    }
}

<header class="wos-page-header">
    <div>
        <h1 class="wos-page-title">Appointments</h1>
        <p class="wos-page-description">@Model.TotalCount appointment(s) in current view</p>
    </div>
    <div class="wos-page-actions">
        <a asp-action="Calendar" class="btn btn-outline-secondary">Calendar</a>
        @if (Model.CanManageAppointments)
        {
            <a asp-action="Create" class="btn btn-wos-primary">Create appointment</a>
        }
    </div>
</header>

<form asp-action="Index" method="get" class="wos-filter-bar row g-3 align-items-end mb-4">
    <div class="col-md-2">
        <label class="form-label">Location</label>
        <select name="workshopLocationId" class="form-select">
            <option value="">All locations</option>
            @foreach (var location in Model.LocationOptions)
            {
                <option value="@location.WorkshopLocationId" selected="@(Model.WorkshopLocationId == location.WorkshopLocationId)">@location.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Status</label>
        <select name="status" class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<WorkshopOS.Domain.Appointments.AppointmentStatus>()">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
    </div>
</form>

@if (Model.Appointments.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = "No appointments", Description = "No appointments match the current filters." })
}
else
{
    <div class="wos-table-wrap wos-desktop-table">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Location</th>
                    <th>Customer</th>
                    <th>Vehicle</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var appointment in Model.Appointments)
            {
                <tr>
                    <td>
                        @appointment.ScheduledStartLocal.ToString("g")
                        <div class="text-muted small">to @appointment.ScheduledEndLocal.ToString("t") (@appointment.TimeZoneId)</div>
                    </td>
                    <td>@appointment.WorkshopLocationName</td>
                    <td>@appointment.CustomerDisplayName</td>
                    <td>@appointment.VehicleSummary</td>
                    <td><partial name="_StatusBadge" model="StatusPresentation.ForAppointment(appointment.Status)" /></td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-appointmentId="@appointment.AppointmentId" class="btn btn-sm btn-outline-primary">View</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="wos-mobile-list">
        @foreach (var appointment in Model.Appointments)
        {
            <a asp-action="Details" asp-route-appointmentId="@appointment.AppointmentId" class="wos-list-card">
                <div class="wos-list-card-title">@appointment.ScheduledStartLocal.ToString("g")</div>
                <div class="wos-list-card-meta">
                    <span>@appointment.CustomerDisplayName</span>
                    <span>@appointment.VehicleSummary</span>
                    <span>@appointment.WorkshopLocationName</span>
                </div>
                <div class="wos-list-card-footer">
                    <partial name="_StatusBadge" model="StatusPresentation.ForAppointment(appointment.Status)" />
                    <span class="text-muted small">View</span>
                </div>
            </a>
        }
    </div>

    @await Html.PartialAsync("_Pagination", new PaginationViewModel
    {
        Action = "Index",
        Page = Model.Page,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        RouteValues = paginationRouteValues
    })
}
