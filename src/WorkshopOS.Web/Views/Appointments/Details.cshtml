@model WorkshopOS.Web.Models.Appointments.AppointmentDetailsViewModel
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Appointment details";
    var scheduleTitle = $"{Model.ScheduledStartLocal:g} – {Model.ScheduledEndLocal:t}";
}

@await Html.PartialAsync("_DetailWorkspaceHeader", new DetailWorkspaceHeaderViewModel
{
    Eyebrow = "Appointment",
    Title = scheduleTitle,
    Meta = new HtmlString($"""
        {Model.CustomerDisplayName} · {Model.VehicleSummary}
        · {Model.WorkshopLocationName} ({Model.TimeZoneId})
        """),
    StatusBadges = await Html.PartialAsync("_StatusBadge", StatusPresentation.ForAppointment(Model.Status))
})

<div class="wos-action-cluster mb-4">
    @if (Model.CanManageAppointments && Model.Status != WorkshopOS.Domain.Appointments.AppointmentStatus.Cancelled)
    {
        <a asp-action="Edit" asp-route-appointmentId="@Model.AppointmentId" class="btn btn-outline-secondary">Edit</a>
        <a asp-action="Reschedule" asp-route-appointmentId="@Model.AppointmentId" class="btn btn-outline-secondary">Reschedule</a>
        <form asp-action="Cancel" asp-route-appointmentId="@Model.AppointmentId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-warning">Cancel appointment</button>
        </form>
    }
    <a asp-action="Calendar" class="btn btn-outline-secondary">Calendar</a>
    <a asp-action="Index" class="btn btn-wos-quiet">Back to list</a>
</div>

<div class="wos-detail-grid">
    <section class="wos-detail-panel">
        <h2 class="wos-detail-panel-title">Schedule</h2>
        <dl class="wos-dl">
            <div class="wos-dl-row">
                <dt>Status</dt>
                <dd><partial name="_StatusBadge" model="StatusPresentation.ForAppointment(Model.Status)" /></dd>
            </div>
            <div class="wos-dl-row">
                <dt>Start</dt>
                <dd>@Model.ScheduledStartLocal.ToString("g") (@Model.TimeZoneId)</dd>
            </div>
            <div class="wos-dl-row">
                <dt>End</dt>
                <dd>@Model.ScheduledEndLocal.ToString("g")</dd>
            </div>
            <div class="wos-dl-row">
                <dt>Location</dt>
                <dd>@Model.WorkshopLocationName</dd>
            </div>
            <div class="wos-dl-row">
                <dt>Created</dt>
                <dd>@Model.CreatedAtUtc.ToString("u")</dd>
            </div>
            <div class="wos-dl-row">
                <dt>Updated</dt>
                <dd>@Model.UpdatedAtUtc.ToString("u")</dd>
            </div>
        </dl>
    </section>
    <section class="wos-detail-panel">
        <h2 class="wos-detail-panel-title">Customer &amp; vehicle</h2>
        <dl class="wos-dl">
            <div class="wos-dl-row">
                <dt>Customer</dt>
                <dd><a asp-controller="Customers" asp-action="Details" asp-route-customerId="@Model.CustomerId">@Model.CustomerDisplayName</a></dd>
            </div>
            <div class="wos-dl-row">
                <dt>Vehicle</dt>
                <dd><a asp-controller="Vehicles" asp-action="Details" asp-route-vehicleId="@Model.VehicleId">@Model.VehicleSummary</a></dd>
            </div>
        </dl>
    </section>
</div>

@if (!string.IsNullOrWhiteSpace(Model.CustomerConcern))
{
    <section class="wos-workspace-section">
        <h2 class="wos-section-title">Customer concern</h2>
        <div class="wos-note-block">@Model.CustomerConcern</div>
    </section>
}

@if (!string.IsNullOrWhiteSpace(Model.InternalNotes))
{
    <section class="wos-workspace-section">
        <h2 class="wos-section-title">Internal notes</h2>
        <div class="wos-note-block">@Model.InternalNotes</div>
    </section>
}

<section class="wos-workspace-section">
    <h2 class="wos-section-title">Repair order</h2>
    @if (Model.LinkedRepairOrderId.HasValue)
    {
        <p>
            Linked repair order:
            <a asp-controller="RepairOrders" asp-action="Details" asp-route-repairOrderId="@Model.LinkedRepairOrderId" class="btn btn-sm btn-outline-primary ms-2">View repair order</a>
        </p>
    }
    else if (Model.CanManageRepairOrders)
    {
        <p class="wos-page-description mb-3">Convert this appointment into a repair order when the customer arrives.</p>
        <form asp-controller="RepairOrders" asp-action="CreateFromAppointment" asp-route-appointmentId="@Model.AppointmentId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-wos-primary">Create repair order</button>
        </form>
    }
    else
    {
        @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = "No repair order linked", Description = "A repair order has not been created from this appointment yet." })
    }
</section>
