@model WorkshopOS.Web.Models.Appointments.AppointmentDetailsViewModel
@{
    ViewData["Title"] = "Appointment details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="display-6">Appointment</h1>
    <div>
        @if (Model.CanManageAppointments && Model.Status != WorkshopOS.Domain.Appointments.AppointmentStatus.Cancelled)
        {
            <a asp-action="Edit" asp-route-appointmentId="@Model.AppointmentId" class="btn btn-outline-secondary">Edit</a>
            <a asp-action="Reschedule" asp-route-appointmentId="@Model.AppointmentId" class="btn btn-outline-secondary">Reschedule</a>
            <form asp-action="Cancel" asp-route-appointmentId="@Model.AppointmentId" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-warning">Cancel</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-link">Back to list</a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <h2 class="h5">Schedule</h2>
        <dl class="row">
            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">@Model.Status</dd>
            <dt class="col-sm-4">Start</dt>
            <dd class="col-sm-8">@Model.ScheduledStartLocal.ToString("g") (@Model.TimeZoneId)</dd>
            <dt class="col-sm-4">End</dt>
            <dd class="col-sm-8">@Model.ScheduledEndLocal.ToString("g")</dd>
            <dt class="col-sm-4">Location</dt>
            <dd class="col-sm-8">@Model.WorkshopLocationName</dd>
        </dl>
    </div>
    <div class="col-md-6">
        <h2 class="h5">Customer & vehicle</h2>
        <dl class="row">
            <dt class="col-sm-4">Customer</dt>
            <dd class="col-sm-8"><a asp-controller="Customers" asp-action="Details" asp-route-customerId="@Model.CustomerId">@Model.CustomerDisplayName</a></dd>
            <dt class="col-sm-4">Vehicle</dt>
            <dd class="col-sm-8"><a asp-controller="Vehicles" asp-action="Details" asp-route-vehicleId="@Model.VehicleId">@Model.VehicleSummary</a></dd>
            <dt class="col-sm-4">Created</dt>
            <dd class="col-sm-8">@Model.CreatedAtUtc.ToString("u")</dd>
            <dt class="col-sm-4">Updated</dt>
            <dd class="col-sm-8">@Model.UpdatedAtUtc.ToString("u")</dd>
        </dl>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.CustomerConcern))
{
    <h2 class="h5 mt-3">Customer concern</h2>
    <p class="border rounded p-3 bg-light">@Model.CustomerConcern</p>
}

@if (!string.IsNullOrWhiteSpace(Model.InternalNotes))
{
    <h2 class="h5 mt-3">Internal notes</h2>
    <p class="border rounded p-3 bg-light">@Model.InternalNotes</p>
}

<h2 class="h5 mt-4">Repair order</h2>
@if (Model.LinkedRepairOrderId.HasValue)
{
    <p>
        Linked repair order:
        <a asp-controller="RepairOrders" asp-action="Details" asp-route-repairOrderId="@Model.LinkedRepairOrderId">View repair order</a>
    </p>
}
else if (Model.CanManageRepairOrders)
{
    <form asp-controller="RepairOrders" asp-action="CreateFromAppointment" asp-route-appointmentId="@Model.AppointmentId" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary">Create repair order</button>
    </form>
}
else
{
    <p class="text-muted">No repair order linked yet.</p>
}
