@model WorkshopOS.Web.Models.Appointments.AppointmentFormViewModel

<partial name="_FormValidationSummary" />

<section class="wos-form-section">
    <h2 class="wos-form-section-title">@Localizer["Appointments_CustomerAndVehicle"]</h2>
    <div class="wos-form-grid">
        <div class="wos-field">
            <label asp-for="CustomerId" class="wos-field-label"></label>
            <select asp-for="CustomerId" class="form-select">
                <option value="">@Localizer["Common_SelectCustomer"]</option>
                @foreach (var customer in Model.CustomerOptions)
                {
                    <option value="@customer.CustomerId">@customer.DisplayName</option>
                }
            </select>
            <span asp-validation-for="CustomerId" class="wos-field-error"></span>
        </div>
        <div class="wos-field">
            <label asp-for="VehicleId" class="wos-field-label"></label>
            <select asp-for="VehicleId" class="form-select">
                <option value="">@Localizer["Common_SelectVehicle"]</option>
                @foreach (var vehicle in Model.VehicleOptions)
                {
                    <option value="@vehicle.VehicleId">@vehicle.Summary</option>
                }
            </select>
            <span asp-validation-for="VehicleId" class="wos-field-error"></span>
        </div>
    </div>
</section>

<section class="wos-form-section">
    <h2 class="wos-form-section-title">@Localizer["Field_WorkshopLocation"]</h2>
    <div class="wos-field wos-field-full">
        <label asp-for="WorkshopLocationId" class="wos-field-label"></label>
        <select asp-for="WorkshopLocationId" class="form-select">
            <option value="">@Localizer["Common_SelectLocation"]</option>
            @foreach (var location in Model.LocationOptions)
            {
                <option value="@location.WorkshopLocationId">@location.Name</option>
            }
        </select>
        <span asp-validation-for="WorkshopLocationId" class="wos-field-error"></span>
    </div>
</section>

@if (!Model.AppointmentId.HasValue)
{
    <section class="wos-form-section">
        <h2 class="wos-form-section-title">@Localizer["Common_Schedule"]</h2>
        <div class="wos-form-grid">
            <div class="wos-field">
                <label asp-for="LocalDate" class="wos-field-label"></label>
                <input asp-for="LocalDate" class="form-control" type="date" />
                <span asp-validation-for="LocalDate" class="wos-field-error"></span>
            </div>
        </div>
        <div class="wos-date-time-group mt-3">
            <div class="wos-field">
                <label asp-for="StartTime" class="wos-field-label"></label>
                <input asp-for="StartTime" class="form-control" type="time" />
                <span asp-validation-for="StartTime" class="wos-field-error"></span>
            </div>
            <div class="wos-field">
                <label asp-for="EndTime" class="wos-field-label"></label>
                <input asp-for="EndTime" class="form-control" type="time" />
                <span asp-validation-for="EndTime" class="wos-field-error"></span>
            </div>
        </div>
        <p class="wos-field-help mt-3 mb-0">@Localizer["Appointments_ScheduleHelp"]</p>
    </section>
}

<section class="wos-form-section">
    <h2 class="wos-form-section-title">@Localizer["Appointments_JobContext"]</h2>
    <div class="wos-form-grid">
        <div class="wos-field wos-field-full">
            <label asp-for="CustomerConcern" class="wos-field-label"></label>
            <textarea asp-for="CustomerConcern" class="form-control" rows="3"></textarea>
            <span asp-validation-for="CustomerConcern" class="wos-field-error"></span>
        </div>
        <div class="wos-field wos-field-full">
            <label asp-for="InternalNotes" class="wos-field-label"></label>
            <textarea asp-for="InternalNotes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="InternalNotes" class="wos-field-error"></span>
            <p class="wos-field-help">@Localizer["Appointments_InternalNotesHelp"]</p>
        </div>
    </div>
</section>
