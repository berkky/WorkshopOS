@model WorkshopOS.Web.Models.Appointments.AppointmentRescheduleViewModel
@{
    ViewData["Title"] = "Reschedule appointment";
}

<h1 class="display-6">Reschedule appointment</h1>
<p class="text-muted">@Model.Summary</p>

<form asp-action="Reschedule" asp-route-appointmentId="@Model.AppointmentId" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="WorkshopLocationId" class="form-label"></label>
        <select asp-for="WorkshopLocationId" class="form-select">
            @foreach (var location in Model.LocationOptions)
            {
                <option value="@location.WorkshopLocationId">@location.Name</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="LocalDate" class="form-label"></label>
        <input asp-for="LocalDate" class="form-control" type="date" />
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="StartTime" class="form-label"></label>
            <input asp-for="StartTime" class="form-control" type="time" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EndTime" class="form-label"></label>
            <input asp-for="EndTime" class="form-control" type="time" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Reschedule</button>
    <a asp-action="Details" asp-route-appointmentId="@Model.AppointmentId" class="btn btn-link">Cancel</a>
</form>
