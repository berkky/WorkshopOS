@model WorkshopOS.Web.Models.Appointments.AppointmentRescheduleViewModel
@{
    ViewData["Title"] = Localizer["Appointments_RescheduleTitle"].Value;
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = Localizer["Common_Appointments"].Value,
    Title = Localizer["Appointments_RescheduleTitle"].Value,
    Description = Model.Summary
})

<form asp-action="Reschedule" asp-route-appointmentId="@Model.AppointmentId" method="post" class="wos-form-shell">
    @Html.AntiForgeryToken()
    <partial name="_FormValidationSummary" />

    <section class="wos-form-section">
        <h2 class="wos-form-section-title">@Localizer["Field_WorkshopLocation"]</h2>
        <div class="wos-field wos-field-full">
            <label asp-for="WorkshopLocationId" class="wos-field-label"></label>
            <select asp-for="WorkshopLocationId" class="form-select">
                @foreach (var location in Model.LocationOptions)
                {
                    <option value="@location.WorkshopLocationId">@location.Name</option>
                }
            </select>
        </div>
    </section>

    <section class="wos-form-section">
        <h2 class="wos-form-section-title">@Localizer["Appointments_NewSchedule"]</h2>
        <div class="wos-form-grid">
            <div class="wos-field">
                <label asp-for="LocalDate" class="wos-field-label"></label>
                <input asp-for="LocalDate" class="form-control" type="date" />
                <span asp-validation-for="LocalDate" class="wos-field-error"></span>
            </div>
        </div>
        <div class="wos-date-time-group mt-3">
            <div class="wos-field">
                <label asp-for="StartTime" class="wos-field-label"></label>
                <input asp-for="StartTime" class="form-control" type="time" />
                <span asp-validation-for="StartTime" class="wos-field-error"></span>
            </div>
            <div class="wos-field">
                <label asp-for="EndTime" class="wos-field-label"></label>
                <input asp-for="EndTime" class="form-control" type="time" />
                <span asp-validation-for="EndTime" class="wos-field-error"></span>
            </div>
        </div>
        <p class="wos-field-help mt-3 mb-0">@Localizer["Appointments_RescheduleHelp"]</p>
    </section>

    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">@Localizer["Appointments_Reschedule"]</button>
        <a asp-action="Details" asp-route-appointmentId="@Model.AppointmentId" class="btn btn-wos-quiet">@Localizer["Common_Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
