@model WorkshopOS.Web.Models.Appointments.AppointmentFormViewModel
@{
    ViewData["Title"] = Model.AppointmentId.HasValue ? Localizer["Appointments_EditTitle"].Value : Localizer["Appointments_CreateTitle"].Value;
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = Localizer["Common_Appointments"].Value,
    Title = ViewData["Title"]!.ToString()!,
    Description = Model.AppointmentId.HasValue
        ? Localizer["Appointments_EditDescription"].Value
        : Localizer["Appointments_CreateDescription"].Value
})

<form asp-action="@(Model.AppointmentId.HasValue ? "Edit" : "Create")"
      asp-route-appointmentId="@Model.AppointmentId"
      method="post"
      class="wos-form-shell">
    @Html.AntiForgeryToken()
    <partial name="_AppointmentFormFields" model="Model" />
    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">@(Model.AppointmentId.HasValue ? Localizer["Common_SaveChanges"].Value : Localizer["Appointments_Create"].Value)</button>
        @if (Model.AppointmentId.HasValue)
        {
            <a asp-action="Details" asp-route-appointmentId="@Model.AppointmentId" class="btn btn-wos-quiet">@Localizer["Common_Cancel"]</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-wos-quiet">@Localizer["Common_Cancel"]</a>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
