@model WorkshopOS.Web.Models.Catalog.ServiceCatalogListViewModel
@{
    ViewData["Title"] = Localizer["ServiceCatalog_Title"].Value;
}

<header class="wos-page-header">
    <div>
        <h1 class="wos-page-title">@Localizer["ServiceCatalog_Title"]</h1>
        <p class="wos-page-description">@string.Format(Localizer["ServiceCatalog_Count"].Value, Model.TotalCount)</p>
    </div>
    @if (Model.CanManageCatalog)
    {
        <div class="wos-page-actions">
            <a class="btn btn-wos-primary" asp-action="Create">@Localizer["ServiceCatalog_AddService"]</a>
        </div>
    }
</header>

<form method="get" class="wos-filter-bar row g-3 align-items-end mb-4">
    <div class="col-md-5">
        <label class="form-label">@Localizer["Common_Search"]</label>
        <input name="search" value="@Model.Search" class="form-control" placeholder="@Localizer["ServiceCatalog_SearchPlaceholder"]" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">@Localizer["Common_Search"]</button>
    </div>
</form>

@if (Model.Services.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = Localizer["ServiceCatalog_NoServices"].Value, Description = Localizer["ServiceCatalog_NoFilters"].Value })
}
else
{
    <div class="wos-table-wrap">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>@Localizer["Common_Code"]</th>
                    <th>@Localizer["Common_Name"]</th>
                    <th>@Localizer["Common_Price"]</th>
                    <th>@Localizer["Common_Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var service in Model.Services)
            {
                <tr>
                    <td><code>@service.Code</code></td>
                    <td>@service.Name</td>
                    <td>@service.DefaultUnitPrice @service.CurrencyCode</td>
                    <td><partial name="_StatusBadge" model="StatusPresentation.ForActive(service.IsActive)" /></td>
                    <td class="text-end">
                        @if (Model.CanManageCatalog)
                        {
                            <a asp-action="Edit" asp-route-serviceCatalogItemId="@service.ServiceCatalogItemId" class="btn btn-sm btn-outline-primary">@Localizer["Common_Edit"]</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
