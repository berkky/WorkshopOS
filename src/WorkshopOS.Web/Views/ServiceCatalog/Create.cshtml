@model WorkshopOS.Web.Models.Catalog.ServiceCatalogFormViewModel
@{
    ViewData["Title"] = Model.ServiceCatalogItemId.HasValue ? "Edit service" : "Create service";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Service catalog",
    Title = ViewData["Title"]!.ToString()!,
    Description = "Define workshop services available for estimates and billing."
})

<form method="post" class="wos-form-shell">
    @Html.AntiForgeryToken()
    <partial name="_ServiceCatalogFormFields" model="Model" />
    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">Save</button>
        <a asp-action="Index" class="btn btn-wos-quiet">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
