@model WorkshopOS.Web.Models.Catalog.ServiceCatalogFormViewModel
@{
    ViewData["Title"] = Model.ServiceCatalogItemId.HasValue ? "Edit service" : "Create service";
}

<h1 class="display-6">@ViewData["Title"]</h1>

<form method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="DefaultUnitPrice" class="form-label"></label>
        <input asp-for="DefaultUnitPrice" class="form-control" type="number" step="0.01" min="0" />
    </div>
    @if (Model.ServiceCatalogItemId.HasValue)
    {
        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
    }
  <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
