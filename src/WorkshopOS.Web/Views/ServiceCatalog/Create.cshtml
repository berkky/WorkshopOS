@model WorkshopOS.Web.Models.Catalog.ServiceCatalogFormViewModel
@{
    ViewData["Title"] = Model.ServiceCatalogItemId.HasValue ? Localizer["ServiceCatalog_EditTitle"].Value : Localizer["ServiceCatalog_CreateTitle"].Value;
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = Localizer["ServiceCatalog_Eyebrow"].Value,
    Title = ViewData["Title"]!.ToString()!,
    Description = Localizer["ServiceCatalog_CreateDescription"].Value
})

<form method="post" class="wos-form-shell">
    @Html.AntiForgeryToken()
    <partial name="_ServiceCatalogFormFields" model="Model" />
    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">@Localizer["Common_Save"]</button>
        <a asp-action="Index" class="btn btn-wos-quiet">@Localizer["Common_Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
