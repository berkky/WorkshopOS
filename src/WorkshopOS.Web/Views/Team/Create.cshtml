@model WorkshopOS.Web.Models.Team.StaffMemberFormViewModel
@{
    ViewData["Title"] = "Add staff profile";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Team",
    Title = "Add staff profile",
    Description = "Create an operational staff record. Login access is managed separately via organization membership."
})

<form asp-action="Create" method="post" class="wos-form-shell wos-form-shell-wide">
    @Html.AntiForgeryToken()
    <partial name="_StaffMemberFormFields" model="Model" />
    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">Create staff profile</button>
        <a asp-action="Index" class="btn btn-wos-quiet">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
