@model WorkshopOS.Web.Models.Team.StaffMemberFormViewModel
@{
    ViewData["Title"] = "Edit staff profile";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Team",
    Title = "Edit staff profile",
    Description = Model.DisplayName
})

<form asp-action="Edit" asp-route-staffId="@Model.StaffMemberId" method="post" class="wos-form-shell wos-form-shell-wide">
    @Html.AntiForgeryToken()
    <partial name="_StaffMemberFormFields" model="Model" />
    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">Save changes</button>
        <a asp-action="Index" class="btn btn-wos-quiet">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
