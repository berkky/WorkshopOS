@model WorkshopOS.Web.Models.Team.StaffMemberFormViewModel
@{
    ViewData["Title"] = "Edit staff profile";
}

<h1 class="display-6">Edit staff profile</h1>

<form asp-action="Edit" asp-route-staffId="@Model.StaffMemberId" method="post">
    <partial name="_StaffMemberFormFields" model="Model" />
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
