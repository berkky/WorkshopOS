@model WorkshopOS.Web.Models.Team.StaffMemberFormViewModel
@{
    ViewData["Title"] = Localizer["Team_EditTitle"].Value;
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = Localizer["Team_Title"].Value,
    Title = Localizer["Team_EditTitle"].Value,
    Description = Model.DisplayName
})

<form asp-action="Edit" asp-route-staffId="@Model.StaffMemberId" method="post" class="wos-form-shell wos-form-shell-wide">
    @Html.AntiForgeryToken()
    <partial name="_StaffMemberFormFields" model="Model" />
    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">@Localizer["Common_SaveChanges"]</button>
        <a asp-action="Index" class="btn btn-wos-quiet">@Localizer["Common_Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
