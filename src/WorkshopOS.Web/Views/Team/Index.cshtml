@model WorkshopOS.Web.Models.Team.TeamIndexViewModel
@{
    ViewData["Title"] = Localizer["Team_Title"].Value;
}

<header class="wos-page-header">
    <div>
        <h1 class="wos-page-title">@Localizer["Team_PageTitle"]</h1>
        <p class="wos-page-description">@Localizer["Team_Description"]</p>
    </div>
    @if (Model.CanManageTeam)
    {
        <div class="wos-page-actions">
            <a class="btn btn-wos-primary" asp-action="Create">@Localizer["Team_AddStaff"]</a>
        </div>
    }
</header>

<section class="wos-workspace-section">
    <h2 class="wos-section-title">@Localizer["Team_StaffProfiles"]</h2>
    <div class="wos-table-wrap">
    <table class="table table-hover mb-0">
    <thead>
        <tr>
            <th>@Localizer["Common_Name"]</th>
            <th>@Localizer["Team_Position"]</th>
            <th>@Localizer["Common_Status"]</th>
            <th>@Localizer["Team_LoginAccess"]</th>
            <th>@Localizer["Team_Locations"]</th>
            @if (Model.CanManageTeam)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
    @foreach (var member in Model.StaffMembers)
    {
        <tr>
            <td>@member.DisplayName</td>
            <td>@member.Position</td>
            <td>@member.Status</td>
            <td>@member.LoginAccess</td>
            <td>@string.Join(", ", member.WorkshopLocations)</td>
            @if (Model.CanManageTeam)
            {
                <td class="text-end">
                    <a asp-action="Edit" asp-route-staffId="@member.StaffMemberId" class="btn btn-sm btn-outline-secondary">@Localizer["Common_Edit"]</a>
                    @if (member.Status == "Active")
                    {
                        <form asp-action="Deactivate" asp-route-staffId="@member.StaffMemberId" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-warning">@Localizer["Team_Deactivate"]</button>
                        </form>
                    }
                </td>
            }
        </tr>
    }
    </tbody>
    </table>
    </div>
</section>

<section class="wos-workspace-section">
    <h2 class="wos-section-title">@Localizer["Team_OrganizationAccess"]</h2>
    <p class="wos-page-description">@Localizer["Team_MembershipNote"]</p>
    <div class="wos-table-wrap">
    <table class="table table-hover mb-0">
    <thead>
        <tr>
            <th>@Localizer["Team_User"]</th>
            <th>@Localizer["Team_Role"]</th>
            <th>@Localizer["Common_Status"]</th>
            @if (Model.CanManageTeam)
            {
                <th>@Localizer["Team_Actions"]</th>
            }
        </tr>
    </thead>
    <tbody>
    @foreach (var membership in Model.Memberships)
    {
        <tr>
            <td>@membership.DisplayName</td>
            <td>@membership.Role</td>
            <td>@membership.Status</td>
            @if (Model.CanManageTeam)
            {
                <td>
                    <form asp-action="ChangeRole" asp-route-membershipId="@membership.MembershipId" method="post" class="d-inline-flex gap-1">
                        @Html.AntiForgeryToken()
                        <select name="NewRole" class="form-select form-select-sm">
                            @foreach (var role in Enum.GetNames(typeof(WorkshopOS.Domain.Organizations.OrganizationMembershipRole)))
                            {
                                <option value="@role" selected="@(membership.Role == role)">@role</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-primary">@Localizer["Team_SetRole"]</button>
                    </form>
                    <form asp-action="ChangeStatus" asp-route-membershipId="@membership.MembershipId" method="post" class="d-inline-flex gap-1 mt-1">
                        @Html.AntiForgeryToken()
                        <select name="NewStatus" class="form-select form-select-sm">
                            @foreach (var status in Enum.GetNames(typeof(WorkshopOS.Domain.Organizations.OrganizationMembershipStatus)))
                            {
                                <option value="@status" selected="@(membership.Status == status)">@status</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">@Localizer["Team_SetStatus"]</button>
                    </form>
                </td>
            }
        </tr>
    }
    </tbody>
    </table>
    </div>
</section>
