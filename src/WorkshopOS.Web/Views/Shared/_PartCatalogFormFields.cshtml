@model WorkshopOS.Web.Models.Catalog.PartCatalogFormViewModel

<partial name="_FormValidationSummary" />

<section class="wos-form-section">
    <h2 class="wos-form-section-title">@Localizer["PartCatalog_Section_Identity"]</h2>
    <div class="wos-form-grid">
        <div class="wos-field">
            <label asp-for="Sku" class="wos-field-label"></label>
            <input asp-for="Sku" class="form-control" />
            <span asp-validation-for="Sku" class="wos-field-error"></span>
        </div>
        <div class="wos-field wos-field-full">
            <label asp-for="Name" class="wos-field-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="wos-field-error"></span>
        </div>
        <div class="wos-field wos-field-full">
            <label asp-for="Description" class="wos-field-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>
    </div>
</section>

<section class="wos-form-section">
    <h2 class="wos-form-section-title">@Localizer["PartCatalog_Section_Pricing"]</h2>
    <div class="wos-form-grid">
        <div class="wos-field">
            <label asp-for="DefaultUnitPrice" class="wos-field-label"></label>
            <input asp-for="DefaultUnitPrice" class="form-control" type="number" step="0.01" min="0" />
            @if (Model.PartCatalogItemId.HasValue)
            {
                <p class="wos-field-help">@Localizer["PartCatalog_PriceChangeHelp"]</p>
            }
        </div>
    </div>
</section>

@if (Model.PartCatalogItemId.HasValue)
{
    <section class="wos-form-section">
        <h2 class="wos-form-section-title">@Localizer["PartCatalog_Section_Availability"]</h2>
        <div class="wos-choice-group">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
                <p class="wos-field-help mb-0">@Localizer["PartCatalog_DeactivateHelp"]</p>
            </div>
        </div>
    </section>
}
