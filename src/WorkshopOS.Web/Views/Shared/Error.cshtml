@model ErrorViewModel
@inject IHostEnvironment HostEnvironment
@{
    ViewData["Title"] = Localizer["Error_Title"];
}

<h1 class="text-danger">@Localizer["Error_Heading"]</h1>
<h2 class="text-danger">@Localizer["Error_Subheading"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Localizer["Error_RequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}

@if (HostEnvironment.IsDevelopment())
{
    <h3>@Localizer["Error_DevelopmentMode"]</h3>
    <p>
        @Html.Raw(Localizer["Error_DevelopmentMode_Swap"].Value)
    </p>
    <p>
        @Html.Raw(Localizer["Error_DevelopmentMode_Warning"].Value)
    </p>
}
