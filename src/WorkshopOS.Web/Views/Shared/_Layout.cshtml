<!DOCTYPE html>

<html lang="@WorkshopCultures.ToHtmlLang(CultureInfo.CurrentUICulture.Name)">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - WorkshopOS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/workshopos-fonts.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/workshopos-tokens.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/workshopos-components.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/workshopos-public.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/WorkshopOS.Web.styles.css" asp-append-version="true" />

</head>

<body class="wos-public-body @ViewData["BodyClass"]" data-wos-processing-text="@Localizer["Common_Processing"]">

<a class="wos-skip-link" href="#main-content">@Localizer["Layout_SkipToMain"]</a>

<header class="wos-public-header">

    <div class="wos-public-header-inner">

        <a class="wos-public-brand" asp-controller="Home" asp-action="Index">

            <span class="wos-public-brand-mark" aria-hidden="true">W</span>

            WorkshopOS

        </a>

        <nav class="wos-public-nav" aria-label="@Localizer["Layout_PublicNavigation"]">

            <partial name="_LanguageSwitcher" />

            <a class="btn btn-sm btn-wos-quiet" asp-controller="Account" asp-action="Login">@Localizer["Layout_SignIn"]</a>

            <a class="btn btn-sm btn-wos-primary" asp-controller="Onboarding" asp-action="Index">@Localizer["Layout_GetStarted"]</a>

        </nav>

    </div>

</header>

<main id="main-content" role="main">

    @RenderBody()

</main>

<footer class="wos-public-footer">

    <div class="wos-public-footer-inner">

        <div class="wos-public-footer-brand">WorkshopOS</div>

        <div class="wos-public-footer-links">

            <a asp-controller="Account" asp-action="Login">@Localizer["Layout_SignIn"]</a>

            <a asp-controller="Onboarding" asp-action="Index">@Localizer["Layout_GetStarted"]</a>

        </div>

        <div class="wos-public-footer-copy">@Localizer["Layout_FooterCopy"]</div>

    </div>

</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>

</html>
