@using WorkshopOS.Infrastructure.Authorization
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool IsActive(string targetController, string? targetAction = null) =>
        string.Equals(controller, targetController, StringComparison.OrdinalIgnoreCase)
        && (targetAction is null || string.Equals(action, targetAction, StringComparison.OrdinalIgnoreCase));

    var canViewReporting = (await AuthorizationService.AuthorizeAsync(User, null, PolicyNames.ReportingViewer)).Succeeded;
    var canManageCatalog = (await AuthorizationService.AuthorizeAsync(User, null, PolicyNames.CatalogManager)).Succeeded;
    var canManageTeam = (await AuthorizationService.AuthorizeAsync(User, null, PolicyNames.OrganizationManager)).Succeeded;
}
<!DOCTYPE html>
<html lang="@WorkshopCultures.ToHtmlLang(CultureInfo.CurrentUICulture.Name)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkshopOS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/workshopos-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workshopos-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workshopos-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WorkshopOS.Web.styles.css" asp-append-version="true" />
</head>
<body class="wos-app-body" data-wos-processing-text="@Localizer["Common_Processing"]">
<a class="wos-skip-link" href="#main-content">@Localizer["Layout_SkipToMain"]</a>
<div class="wos-app">
    <aside class="wos-sidebar" aria-label="@Localizer["Layout_PrimaryNavigation"]">
        <div class="wos-sidebar-brand">
            <a asp-controller="Dashboard" asp-action="Index">
                <span class="wos-sidebar-brand-mark" aria-hidden="true">W</span>
                <span>
                    WorkshopOS
                    <small>@Localizer["Layout_BrandTagline"]</small>
                </span>
            </a>
        </div>
        <nav class="wos-sidebar-nav">
            @if (canViewReporting)
            {
                <div class="wos-nav-section">
                    <div class="wos-nav-section-label">@Localizer["Nav_Overview"]</div>
                    <a class="wos-nav-link @(IsActive("Dashboard") ? "is-active" : "")" asp-controller="Dashboard" asp-action="Index">@Localizer["Nav_Dashboard"]</a>
                    <a class="wos-nav-link @(IsActive("Reports", "Operations") ? "is-active" : "")" asp-controller="Reports" asp-action="Operations">@Localizer["Nav_OperationsReport"]</a>
                    <a class="wos-nav-link @(IsActive("Reports", "Commercial") ? "is-active" : "")" asp-controller="Reports" asp-action="Commercial">@Localizer["Nav_CommercialReport"]</a>
                </div>
            }
            <div class="wos-nav-section">
                <div class="wos-nav-section-label">@Localizer["Nav_WorkshopFloor"]</div>
                <a class="wos-nav-link @(IsActive("Operations") ? "is-active" : "")" asp-controller="Operations" asp-action="Index">@Localizer["Nav_OperationsBoard"]</a>
                <a class="wos-nav-link @(IsActive("Work") ? "is-active" : "")" asp-controller="Work" asp-action="MyJobs">@Localizer["Nav_MyWork"]</a>
                <a class="wos-nav-link @(IsActive("Appointments") ? "is-active" : "")" asp-controller="Appointments" asp-action="Index">@Localizer["Nav_Appointments"]</a>
                <a class="wos-nav-link @(IsActive("RepairOrders") ? "is-active" : "")" asp-controller="RepairOrders" asp-action="Index">@Localizer["Nav_RepairOrders"]</a>
                <a class="wos-nav-link @(IsActive("Inspections") ? "is-active" : "")" asp-controller="Inspections" asp-action="Index">@Localizer["Nav_Inspections"]</a>
            </div>
            <div class="wos-nav-section">
                <div class="wos-nav-section-label">@Localizer["Nav_Customers"]</div>
                <a class="wos-nav-link @(IsActive("Customers") ? "is-active" : "")" asp-controller="Customers" asp-action="Index">@Localizer["Nav_Customers"]</a>
                <a class="wos-nav-link @(IsActive("Vehicles") ? "is-active" : "")" asp-controller="Vehicles" asp-action="Index">@Localizer["Nav_Vehicles"]</a>
            </div>
            <div class="wos-nav-section">
                <div class="wos-nav-section-label">@Localizer["Nav_Commercial"]</div>
                <a class="wos-nav-link @(IsActive("Estimates") ? "is-active" : "")" asp-controller="Estimates" asp-action="Index">@Localizer["Nav_Estimates"]</a>
                @if (canManageCatalog)
                {
                    <a class="wos-nav-link @(IsActive("ServiceCatalog") ? "is-active" : "")" asp-controller="ServiceCatalog" asp-action="Index">@Localizer["Nav_ServiceCatalog"]</a>
                    <a class="wos-nav-link @(IsActive("PartCatalog") ? "is-active" : "")" asp-controller="PartCatalog" asp-action="Index">@Localizer["Nav_PartsCatalog"]</a>
                }
                <a class="wos-nav-link @(IsActive("Inventory") ? "is-active" : "")" asp-controller="Inventory" asp-action="Index">@Localizer["Nav_Inventory"]</a>
                <a class="wos-nav-link @(IsActive("Invoices") ? "is-active" : "")" asp-controller="Invoices" asp-action="Index">@Localizer["Nav_Invoices"]</a>
            </div>
            @if (canManageTeam)
            {
                <div class="wos-nav-section">
                    <div class="wos-nav-section-label">@Localizer["Nav_Organization"]</div>
                    <a class="wos-nav-link @(IsActive("Team") ? "is-active" : "")" asp-controller="Team" asp-action="Index">@Localizer["Nav_Team"]</a>
                </div>
            }
        </nav>
        <div class="wos-sidebar-footer">
            <partial name="_AccountCenter" />
        </div>
    </aside>

    <div class="wos-app-main">
        <header class="wos-topbar">
            <a class="wos-topbar-brand" asp-controller="Dashboard" asp-action="Index">
                <span class="wos-sidebar-brand-mark" aria-hidden="true">W</span>
                WorkshopOS
            </a>
            <div class="d-flex align-items-center gap-2">
                <partial name="_AccountCenter" />
                <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#wosMobileNav" aria-controls="wosMobileNav" aria-label="@Localizer["Layout_OpenNavigation"]">
                    @Localizer["Layout_Menu"]
                </button>
            </div>
        </header>

        <main id="main-content" class="wos-content" role="main" data-wos-page-entry>
            <partial name="_AlertMessages" />
            @RenderBody()
        </main>
    </div>
</div>

<div class="offcanvas offcanvas-start wos-offcanvas-nav" tabindex="-1" id="wosMobileNav" aria-labelledby="wosMobileNavLabel">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title h5" id="wosMobileNavLabel">@Localizer["Layout_Navigation"]</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@Localizer["Layout_CloseNavigation"]"></button>
    </div>
    <div class="offcanvas-body">
        <nav aria-label="@Localizer["Layout_MobileNavigation"]">
            @if (canViewReporting)
            {
                <a class="wos-nav-link @(IsActive("Dashboard") ? "is-active" : "")" asp-controller="Dashboard" asp-action="Index">@Localizer["Nav_Dashboard"]</a>
                <a class="wos-nav-link" asp-controller="Reports" asp-action="Operations">@Localizer["Nav_OperationsReport"]</a>
                <a class="wos-nav-link" asp-controller="Reports" asp-action="Commercial">@Localizer["Nav_CommercialReport"]</a>
            }
            <a class="wos-nav-link" asp-controller="Operations" asp-action="Index">@Localizer["Nav_OperationsBoard"]</a>
            <a class="wos-nav-link" asp-controller="Work" asp-action="MyJobs">@Localizer["Nav_MyWork"]</a>
            <a class="wos-nav-link" asp-controller="Appointments" asp-action="Index">@Localizer["Nav_Appointments"]</a>
            <a class="wos-nav-link" asp-controller="RepairOrders" asp-action="Index">@Localizer["Nav_RepairOrders"]</a>
            <a class="wos-nav-link" asp-controller="Inspections" asp-action="Index">@Localizer["Nav_Inspections"]</a>
            <a class="wos-nav-link" asp-controller="Customers" asp-action="Index">@Localizer["Nav_Customers"]</a>
            <a class="wos-nav-link" asp-controller="Vehicles" asp-action="Index">@Localizer["Nav_Vehicles"]</a>
            <a class="wos-nav-link" asp-controller="Estimates" asp-action="Index">@Localizer["Nav_Estimates"]</a>
            <a class="wos-nav-link" asp-controller="Inventory" asp-action="Index">@Localizer["Nav_Inventory"]</a>
            <a class="wos-nav-link" asp-controller="Invoices" asp-action="Index">@Localizer["Nav_Invoices"]</a>
            <div class="wos-offcanvas-account mt-4 pt-4">
                <div class="wos-nav-section-label">@Localizer["Account_MenuHeading"]</div>
                <a class="wos-nav-link" asp-controller="Account" asp-action="Profile">@Localizer["Account_MyProfile"]</a>
                <a class="wos-nav-link" asp-controller="Account" asp-action="Settings">@Localizer["Account_Settings"]</a>
                <a class="wos-nav-link" asp-controller="Account" asp-action="Security">@Localizer["Account_Security"]</a>
            </div>
        </nav>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
