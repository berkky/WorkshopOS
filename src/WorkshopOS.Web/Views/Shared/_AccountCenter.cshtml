@inject WorkshopOS.Web.Services.IAccountCenterService AccountCenter
@{
    var snapshot = await AccountCenter.GetSnapshotAsync(User);
    if (snapshot is null)
    {
        return;
    }

    var contextLabel = !string.IsNullOrWhiteSpace(snapshot.MembershipRoleLabel)
        ? snapshot.MembershipRoleLabel
        : snapshot.OrganizationName ?? snapshot.Email;
    var panelId = $"wos-account-panel-{Guid.NewGuid():N}";
}

<div class="wos-account-center" data-wos-account-menu>
    <button type="button"
            class="wos-account-trigger"
            data-wos-account-trigger
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="@panelId">
        <span class="wos-account-avatar" aria-hidden="true">@snapshot.Initials</span>
        <span class="wos-account-trigger-copy">
            <span class="wos-account-trigger-name">@snapshot.Email</span>
            <span class="wos-account-trigger-meta">@contextLabel</span>
        </span>
        <span class="wos-account-trigger-chevron" aria-hidden="true"></span>
    </button>
    <div class="wos-account-panel" id="@panelId" data-wos-account-panel role="menu">
        <div class="wos-account-panel-header">
            <span class="wos-account-avatar wos-account-avatar-lg" aria-hidden="true">@snapshot.Initials</span>
            <div>
                <div class="wos-account-panel-name">@snapshot.Email</div>
                @if (!string.IsNullOrWhiteSpace(snapshot.OrganizationName))
                {
                    <div class="wos-account-panel-meta">@snapshot.OrganizationName</div>
                }
            </div>
        </div>
        <div class="wos-account-panel-links">
            <a class="wos-account-menu-link" asp-controller="Account" asp-action="Profile" role="menuitem">
                <svg class="wos-account-menu-icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="5" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M2.5 14c0-3 2.5-5 5.5-5s5.5 2 5.5 5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                @Localizer["Account_MyProfile"]
            </a>
            <a class="wos-account-menu-link" asp-controller="Account" asp-action="Settings" role="menuitem">
                <svg class="wos-account-menu-icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="2.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                @Localizer["Account_Settings"]
            </a>
            <a class="wos-account-menu-link" asp-controller="Account" asp-action="Security" role="menuitem">
                <svg class="wos-account-menu-icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="4" y="7" width="8" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                @Localizer["Account_Security"]
            </a>
            @if (snapshot.CanSwitchWorkspace)
            {
                <a class="wos-account-menu-link" asp-controller="Organization" asp-action="Select" role="menuitem">
                    <svg class="wos-account-menu-icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="5" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="9" y="8" width="5" height="5" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7 5.5h2M7 10.5H9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    @Localizer["Account_SwitchWorkspace"]
                </a>
            }
        </div>
        <div class="wos-account-panel-language">
            <partial name="_LanguageSwitcher" />
        </div>
        <div class="wos-account-panel-footer">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="wos-account-menu-link wos-account-menu-link-danger" role="menuitem">
                    <svg class="wos-account-menu-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 2.5H3.5A1.5 1.5 0 0 0 2 4v8a1.5 1.5 0 0 0 1.5 1.5H6M10.5 11.5 14 8l-3.5-3.5M14 8H6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    @Localizer["Layout_SignOut"]
                </button>
            </form>
        </div>
    </div>
</div>
