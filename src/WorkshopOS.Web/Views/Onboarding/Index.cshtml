@model WorkshopOS.Web.Models.Onboarding.OwnerOnboardingViewModel
@{
    ViewData["Title"] = "Create your workshop";
}

<div class="wos-auth-shell">
    <div class="wos-auth-card is-wide">
        <div class="wos-auth-brand-strip">
            <div class="wos-public-brand-mark" aria-hidden="true">W</div>
        </div>
        <h1 class="wos-page-title text-center mb-2">Create your workshop</h1>
        <p class="wos-page-description text-center mb-5">Set up your owner account and first workshop location. Your premium workspace awaits.</p>

        <form asp-action="Index" asp-controller="Onboarding" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="wos-form-section">
                <div class="wos-form-section-title">Owner account</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="OwnerDisplayName" class="form-label"></label>
                        <input asp-for="OwnerDisplayName" class="form-control" autocomplete="name" />
                        <span asp-validation-for="OwnerDisplayName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="wos-form-section">
                <div class="wos-form-section-title">Organization &amp; location</div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="OrganizationName" class="form-label"></label>
                        <input asp-for="OrganizationName" class="form-control" placeholder="e.g. Apex Auto Workshop" />
                        <span asp-validation-for="OrganizationName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="WorkshopLocationName" class="form-label"></label>
                        <input asp-for="WorkshopLocationName" class="form-control" placeholder="Main workshop" />
                        <span asp-validation-for="WorkshopLocationName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="WorkshopLocationCode" class="form-label"></label>
                        <input asp-for="WorkshopLocationCode" class="form-control" placeholder="MAIN" />
                        <span asp-validation-for="WorkshopLocationCode" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TimeZoneId" class="form-label"></label>
                        <input asp-for="TimeZoneId" class="form-control" placeholder="Europe/Istanbul" />
                        <span asp-validation-for="TimeZoneId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CurrencyCode" class="form-label"></label>
                        <input asp-for="CurrencyCode" class="form-control" placeholder="TRY" maxlength="3" />
                        <span asp-validation-for="CurrencyCode" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="wos-form-footer border-0 pt-0">
                <button type="submit" class="btn btn-wos-primary btn-lg flex-grow-1">Create workshop</button>
                <a class="btn btn-wos-secondary" asp-controller="Account" asp-action="Login">Sign in instead</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
