@model WorkshopOS.Web.Models.Billing.InvoiceListViewModel
@{
    ViewData["Title"] = Localizer["Invoices_Title"].Value;
}

<header class="wos-page-header">
    <div>
        <h1 class="wos-page-title">@Localizer["Invoices_Title"]</h1>
        <p class="wos-page-description">@string.Format(Localizer["Invoices_CountInView"].Value, Model.TotalCount)</p>
    </div>
    <div class="wos-page-actions">
        <a asp-controller="RepairOrders" asp-action="Index" class="btn btn-outline-secondary">@Localizer["RepairOrders_Title"]</a>
    </div>
</header>

<form asp-action="Index" method="get" class="wos-filter-bar row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label">@Localizer["Common_Search"]</label>
        <input name="search" value="@Model.Search" class="form-control" placeholder="@Localizer["Invoices_SearchPlaceholder"]" />
    </div>
    <div class="col-md-2">
        <label class="form-label">@Localizer["Common_Status"]</label>
        <select name="status" class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<WorkshopOS.Domain.Billing.InvoiceStatus>()">
            <option value="">@Localizer["Common_AllStatuses"]</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">@Localizer["Common_Payment"]</label>
        <select name="paymentState" class="form-select" asp-for="PaymentState" asp-items="Html.GetEnumSelectList<WorkshopOS.Application.Billing.InvoicePaymentState>()">
            <option value="">@Localizer["Common_AllPaymentStates"]</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">@Localizer["Common_Location"]</label>
        <select name="workshopLocationId" class="form-select">
            <option value="">@Localizer["Common_AllLocations"]</option>
            @foreach (var location in Model.LocationOptions)
            {
                <option value="@location.WorkshopLocationId" selected="@(Model.WorkshopLocationId == location.WorkshopLocationId)">@location.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">@Localizer["Common_Filter"]</button>
    </div>
</form>

@if (Model.Invoices.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = Localizer["Invoices_NoInvoices"].Value, Description = Localizer["Invoices_NoFilters"].Value })
}
else
{
    <div class="wos-table-wrap wos-desktop-table">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@Localizer["Invoices_Eyebrow"]</th>
                    <th>@Localizer["Inspections_RepairOrder"]</th>
                    <th>@Localizer["Common_Customer"]</th>
                    <th>@Localizer["Common_Vehicle"]</th>
                    <th>@Localizer["Common_Location"]</th>
                    <th>@Localizer["Common_Status"]</th>
                    <th>@Localizer["Common_Payment"]</th>
                    <th>@Localizer["Common_Total"]</th>
                    <th>@Localizer["Common_Created"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var invoice in Model.Invoices)
            {
                <tr>
                    <td>@invoice.Number</td>
                    <td>@invoice.RepairOrderNumber</td>
                    <td>@invoice.CustomerDisplayName</td>
                    <td>@invoice.VehicleSummary</td>
                    <td>@invoice.WorkshopLocationName</td>
                    <td><partial name="_StatusBadge" model="StatusPresentation.ForInvoice(invoice.Status)" /></td>
                    <td><partial name="_StatusBadge" model="StatusPresentation.ForPaymentState(invoice.PaymentState)" /></td>
                    <td>@invoice.Total @invoice.CurrencyCode</td>
                    <td>@UiFormatting.FormatDateTime(invoice.CreatedAtUtc)</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-invoiceId="@invoice.InvoiceId" class="btn btn-sm btn-outline-secondary">@Localizer["Common_View"]</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="wos-mobile-list">
        @foreach (var invoice in Model.Invoices)
        {
            <a asp-action="Details" asp-route-invoiceId="@invoice.InvoiceId" class="wos-list-card">
                <div class="wos-list-card-title">@invoice.Number</div>
                <div class="wos-list-card-meta">
                    <span>@invoice.CustomerDisplayName · @invoice.VehicleSummary</span>
                    <span>@invoice.Total @invoice.CurrencyCode</span>
                </div>
                <div class="wos-list-card-footer">
                    <partial name="_StatusBadge" model="StatusPresentation.ForPaymentState(invoice.PaymentState)" />
                    <span class="text-muted small">@Localizer["Common_View"]</span>
                </div>
            </a>
        }
    </div>
}
