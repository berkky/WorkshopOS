@model WorkshopOS.Web.Models.Billing.InvoiceDetailsViewModel
@{
    ViewData["Title"] = Model.Number;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="display-6">@Model.Number</h1>
        <p class="text-muted mb-0">
            Repair order
            <a asp-controller="RepairOrders" asp-action="Details" asp-route-repairOrderId="@Model.RepairOrderId">@Model.RepairOrderNumber</a>
        </p>
    </div>
    <div>
        @if (Model.CanEditItems && Model.CanManageBilling)
        {
            <a asp-action="Edit" asp-route-invoiceId="@Model.InvoiceId" class="btn btn-outline-secondary">Edit draft</a>
        }
        <a asp-action="Index" class="btn btn-link">All invoices</a>
    </div>
</div>

@if (TempData["InvoiceError"] is string invoiceError)
{
    <div class="alert alert-warning">@invoiceError</div>
}

@if (Model.RepairOrderCommerciallyClosed)
{
    <div class="alert alert-info">This repair order has been commercially closed. Billing is read-only.</div>
}

<div class="row mb-4">
    <div class="col-md-6">
        <h2 class="h5">Invoice summary</h2>
        <dl class="row">
            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">@Model.Status</dd>
            <dt class="col-sm-4">Payment</dt>
            <dd class="col-sm-8">@Model.PaymentState</dd>
            <dt class="col-sm-4">Customer</dt>
            <dd class="col-sm-8">@Model.CustomerDisplayName</dd>
            <dt class="col-sm-4">Vehicle</dt>
            <dd class="col-sm-8">@Model.VehicleSummary</dd>
            <dt class="col-sm-4">Location</dt>
            <dd class="col-sm-8">@Model.WorkshopLocationName</dd>
            @if (Model.SourceEstimateId.HasValue)
            {
                <dt class="col-sm-4">Source estimate</dt>
                <dd class="col-sm-8">
                    <a asp-controller="Estimates" asp-action="Details" asp-route-estimateId="@Model.SourceEstimateId">@Model.SourceEstimateNumber</a>
                </dd>
            }
            <dt class="col-sm-4">Total</dt>
            <dd class="col-sm-8">@Model.Total @Model.CurrencyCode</dd>
            <dt class="col-sm-4">Paid</dt>
            <dd class="col-sm-8">@Model.AmountPaid @Model.CurrencyCode</dd>
            <dt class="col-sm-4">Balance</dt>
            <dd class="col-sm-8">@Model.RemainingBalance @Model.CurrencyCode</dd>
            @if (Model.IssuedAtUtc.HasValue)
            {
                <dt class="col-sm-4">Issued</dt>
                <dd class="col-sm-8">@Model.IssuedAtUtc.Value.ToString("u")</dd>
            }
            @if (Model.VoidedAtUtc.HasValue)
            {
                <dt class="col-sm-4">Voided</dt>
                <dd class="col-sm-8">@Model.VoidedAtUtc.Value.ToString("u")</dd>
            }
        </dl>
        @if (!string.IsNullOrWhiteSpace(Model.CommercialNotes))
        {
            <h3 class="h6">Commercial notes</h3>
            <p class="border rounded p-3 bg-light">@Model.CommercialNotes</p>
        }
    </div>
</div>

<h2 class="h5">Line items</h2>
@if (Model.Items.Count == 0)
{
    <p class="text-muted">No line items.</p>
}
else
{
    <table class="table table-sm table-striped mb-4">
        <thead>
            <tr>
                <th>Type</th>
                <th>Description</th>
                <th>Qty</th>
                <th>Unit price</th>
                <th>Line total</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Type</td>
                <td>@item.Description</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice</td>
                <td>@item.LineTotal</td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="4" class="text-end">Invoice total</th>
                <th>@Model.Total @Model.CurrencyCode</th>
            </tr>
        </tfoot>
    </table>
}

<h2 class="h5">Payments</h2>
@if (Model.Payments.Count == 0)
{
    <p class="text-muted">No payments recorded.</p>
}
else
{
    <table class="table table-sm table-striped mb-4">
        <thead>
            <tr>
                <th>Recorded</th>
                <th>Method</th>
                <th>Amount</th>
                <th>Reference</th>
                <th>Note</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var payment in Model.Payments)
        {
            <tr>
                <td>@payment.RecordedAtUtc.ToString("u")</td>
                <td>@payment.PaymentMethod</td>
                <td>@payment.Amount @Model.CurrencyCode</td>
                <td>@(payment.Reference ?? "—")</td>
                <td>@(payment.Note ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
}

@if (Model.CanManageBilling && Model.CanRecordPayment)
{
    <h2 class="h5">Record payment</h2>
    <form asp-action="RecordPayment" asp-route-invoiceId="@Model.InvoiceId" method="post" class="row g-2 mb-4">
        @Html.AntiForgeryToken()
        <div class="col-md-2">
            <input name="Amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="Amount" required />
        </div>
        <div class="col-md-2">
            <select name="PaymentMethod" class="form-select" asp-items="Html.GetEnumSelectList<WorkshopOS.Domain.Billing.PaymentMethod>()"></select>
        </div>
        <div class="col-md-2">
            <input name="Reference" class="form-control" placeholder="Reference" maxlength="100" />
        </div>
        <div class="col-md-3">
            <input name="Note" class="form-control" placeholder="Note" maxlength="500" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Record payment</button>
        </div>
    </form>
}

@if (Model.CanManageBilling)
{
    <div class="d-flex flex-wrap gap-2">
        @if (Model.CanIssue)
        {
            <form asp-action="Issue" asp-route-invoiceId="@Model.InvoiceId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">Issue invoice</button>
            </form>
        }
        @if (Model.CanVoid)
        {
            <form asp-action="Void" asp-route-invoiceId="@Model.InvoiceId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-warning">Void invoice</button>
            </form>
        }
    </div>
}
