@model WorkshopOS.Web.Models.Billing.InvoiceDetailsViewModel
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Model.Number;
}

@await Html.PartialAsync("_DetailWorkspaceHeader", new DetailWorkspaceHeaderViewModel
{
    Eyebrow = "Invoice",
    Title = Model.Number,
    Meta = new HtmlString($"""
        {Model.CustomerDisplayName} · {Model.VehicleSummary}
        · <a href="{Url.Action("Details", "RepairOrders", new { repairOrderId = Model.RepairOrderId })}">RO {Model.RepairOrderNumber}</a>
        """),
    StatusBadges = await Html.PartialAsync("_StatusBadge", StatusPresentation.ForInvoice(Model.Status))
})

<div class="wos-action-cluster mb-4">
    @if (Model.CanEditItems && Model.CanManageBilling)
    {
        <a asp-action="Edit" asp-route-invoiceId="@Model.InvoiceId" class="btn btn-outline-secondary">Edit draft</a>
    }
    <a asp-action="Index" class="btn btn-wos-quiet">All invoices</a>
</div>

@if (TempData["InvoiceError"] is string invoiceError)
{
    <div class="alert alert-warning">@invoiceError</div>
}

@if (Model.RepairOrderCommerciallyClosed)
{
    <div class="alert alert-info">This repair order has been commercially closed. Billing is read-only.</div>
}

<div class="wos-detail-grid mb-4">
    <section class="wos-detail-panel">
        <h2 class="wos-detail-panel-title">Invoice summary</h2>
        <dl class="wos-dl">
            <div class="wos-dl-row">
                <dt>Status</dt>
                <dd><partial name="_StatusBadge" model="StatusPresentation.ForInvoice(Model.Status)" /></dd>
            </div>
            <div class="wos-dl-row">
                <dt>Payment</dt>
                <dd><partial name="_StatusBadge" model="StatusPresentation.ForPaymentState(Model.PaymentState)" /></dd>
            </div>
            <div class="wos-dl-row">
                <dt>Customer</dt>
                <dd>@Model.CustomerDisplayName</dd>
            </div>
            <div class="wos-dl-row">
                <dt>Vehicle</dt>
                <dd>@Model.VehicleSummary</dd>
            </div>
            <div class="wos-dl-row">
                <dt>Location</dt>
                <dd>@Model.WorkshopLocationName</dd>
            </div>
            @if (Model.SourceEstimateId.HasValue)
            {
                <div class="wos-dl-row">
                    <dt>Source estimate</dt>
                    <dd>
                        <a asp-controller="Estimates" asp-action="Details" asp-route-estimateId="@Model.SourceEstimateId">@Model.SourceEstimateNumber</a>
                    </dd>
                </div>
            }
            <div class="wos-dl-row">
                <dt>Total</dt>
                <dd>@Model.Total @Model.CurrencyCode</dd>
            </div>
            <div class="wos-dl-row">
                <dt>Paid</dt>
                <dd>@Model.AmountPaid @Model.CurrencyCode</dd>
            </div>
            <div class="wos-dl-row">
                <dt>Balance</dt>
                <dd>@Model.RemainingBalance @Model.CurrencyCode</dd>
            </div>
            @if (Model.IssuedAtUtc.HasValue)
            {
                <div class="wos-dl-row">
                    <dt>Issued</dt>
                    <dd>@Model.IssuedAtUtc.Value.ToString("u")</dd>
                </div>
            }
            @if (Model.VoidedAtUtc.HasValue)
            {
                <div class="wos-dl-row">
                    <dt>Voided</dt>
                    <dd>@Model.VoidedAtUtc.Value.ToString("u")</dd>
                </div>
            }
        </dl>
        @if (!string.IsNullOrWhiteSpace(Model.CommercialNotes))
        {
            <h3 class="wos-detail-panel-title mt-4">Commercial notes</h3>
            <div class="wos-note-block">@Model.CommercialNotes</div>
        }
    </section>
</div>

<h2 class="wos-section-title">Line items</h2>
@if (Model.Items.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = "No line items", Description = "Add line items while this invoice is in draft." })
}
else
{
    <div class="wos-table-wrap">
    <table class="table table-striped mb-0">
        <thead>
            <tr>
                <th>Type</th>
                <th>Description</th>
                <th>Qty</th>
                <th>Unit price</th>
                <th>Line total</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Type</td>
                <td>@item.Description</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice</td>
                <td>@item.LineTotal</td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="4" class="text-end">Invoice total</th>
                <th>@Model.Total @Model.CurrencyCode</th>
            </tr>
        </tfoot>
    </table>
    </div>
}

<h2 class="wos-section-title">Payments</h2>
@if (Model.Payments.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = "No payments recorded", Description = "Payment ledger entries appear here after staff record them." })
}
else
{
    <div class="wos-table-wrap">
    <table class="table table-striped mb-4">
        <thead>
            <tr>
                <th>Recorded</th>
                <th>Method</th>
                <th>Amount</th>
                <th>Reference</th>
                <th>Note</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var payment in Model.Payments)
        {
            <tr>
                <td>@payment.RecordedAtUtc.ToString("u")</td>
                <td>@payment.PaymentMethod</td>
                <td>@payment.Amount @Model.CurrencyCode</td>
                <td>@(payment.Reference ?? "—")</td>
                <td>@(payment.Note ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}

@if (Model.CanManageBilling && Model.CanRecordPayment)
{
    <div class="wos-payment-entry">
        <h2 class="wos-payment-entry-title">Record payment</h2>
        <p class="wos-payment-entry-note">Records a payment ledger entry in WorkshopOS. This does not process card or online payments.</p>
        <form asp-action="RecordPayment" asp-route-invoiceId="@Model.InvoiceId" method="post" class="wos-filter-bar row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-2">
                <label class="form-label">Amount</label>
                <input name="Amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">Method</label>
                <select name="PaymentMethod" class="form-select" asp-items="Html.GetEnumSelectList<WorkshopOS.Domain.Billing.PaymentMethod>()"></select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Reference</label>
                <input name="Reference" class="form-control" placeholder="Optional" maxlength="100" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Note</label>
                <input name="Note" class="form-control" placeholder="Optional" maxlength="500" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-wos-primary w-100">Record payment</button>
            </div>
        </form>
    </div>
}

@if (Model.CanManageBilling)
{
    <div class="d-flex flex-wrap gap-2">
        @if (Model.CanIssue)
        {
            <form asp-action="Issue" asp-route-invoiceId="@Model.InvoiceId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">Issue invoice</button>
            </form>
        }
        @if (Model.CanVoid)
        {
            <form asp-action="Void" asp-route-invoiceId="@Model.InvoiceId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-warning">Void invoice</button>
            </form>
        }
    </div>
}
