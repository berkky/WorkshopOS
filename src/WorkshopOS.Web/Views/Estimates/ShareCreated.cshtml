@model WorkshopOS.Web.Models.CustomerPortal.EstimateShareCreatedViewModel
@{
    ViewData["Title"] = Model.IsRotation ? Localizer["Estimates_ShareRotatedPageTitle"].Value : Localizer["Estimates_ShareCreatedPageTitle"].Value;
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = Localizer["Estimates_Title"].Value,
    Title = Model.IsRotation ? Localizer["Estimates_ShareRotatedTitle"].Value : Localizer["Estimates_ShareCreatedTitle"].Value,
    Description = Localizer["Estimates_ShareDescription"].Value
})

<div class="alert alert-warning">
    @Localizer["Estimates_ShareWarning"]
</div>

<section class="wos-form-section mb-4">
    <h2 class="wos-form-section-title">@Localizer["Estimates_SecureCustomerLink"]</h2>
    <div class="wos-field wos-field-full">
        <label class="wos-field-label" for="share-link">@Localizer["Estimates_LinkUrl"]</label>
        <div class="input-group">
            <input id="share-link" class="form-control" readonly value="" />
            <button type="button" class="btn btn-outline-secondary" id="copy-share-link">@Localizer["Estimates_CopyLink"]</button>
        </div>
        <p class="wos-field-help mt-2 mb-0">@string.Format(Localizer["Estimates_ExpiresAt"].Value, UiFormatting.FormatDateTime(Model.ExpiresAtUtc))</p>
    </div>
    <div class="wos-form-actions border-0 pt-3 mt-0">
        <a asp-action="Details" asp-route-estimateId="@Model.EstimateId" class="btn btn-wos-quiet">@Localizer["Estimates_BackToEstimate"]</a>
    </div>
</section>

@section Scripts {
<script>
(function () {
    var publicId = '@Model.PublicId';
    var token = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RawToken));
    var relativePath = '/portal/access/' + publicId + '#token=' + encodeURIComponent(token);
    var absoluteLink = window.location.origin + relativePath;
    var input = document.getElementById('share-link');
    input.value = absoluteLink;

    document.getElementById('copy-share-link').addEventListener('click', function () {
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(absoluteLink);
        } else {
            input.select();
            document.execCommand('copy');
        }
    });
})();
</script>
}
