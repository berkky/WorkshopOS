@model WorkshopOS.Web.Models.CustomerPortal.EstimateShareCreatedViewModel
@{
    ViewData["Title"] = Model.IsRotation ? "Rotated secure link" : "Secure customer link";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Estimates",
    Title = Model.IsRotation ? "New secure customer link" : "Secure customer link created",
    Description = "This link is shown once. Copy it now and send it to your customer."
})

<div class="alert alert-warning">
    The secure link below contains a private access token. It will not be shown again after you leave this page.
</div>

<section class="wos-form-section mb-4">
    <h2 class="wos-form-section-title">Secure customer link</h2>
    <div class="wos-field wos-field-full">
        <label class="wos-field-label" for="share-link">Link URL</label>
        <div class="input-group">
            <input id="share-link" class="form-control" readonly value="" />
            <button type="button" class="btn btn-outline-secondary" id="copy-share-link">Copy link</button>
        </div>
        <p class="wos-field-help mt-2 mb-0">Expires @Model.ExpiresAtUtc.ToString("u")</p>
    </div>
    <div class="wos-form-actions border-0 pt-3 mt-0">
        <a asp-action="Details" asp-route-estimateId="@Model.EstimateId" class="btn btn-wos-quiet">Back to estimate</a>
    </div>
</section>

@section Scripts {
<script>
(function () {
    var publicId = '@Model.PublicId';
    var token = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RawToken));
    var relativePath = '/portal/access/' + publicId + '#token=' + encodeURIComponent(token);
    var absoluteLink = window.location.origin + relativePath;
    var input = document.getElementById('share-link');
    input.value = absoluteLink;

    document.getElementById('copy-share-link').addEventListener('click', function () {
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(absoluteLink);
        } else {
            input.select();
            document.execCommand('copy');
        }
    });
})();
</script>
}
