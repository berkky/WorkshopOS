@model WorkshopOS.Web.Models.Estimates.EstimateDetailsViewModel
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Model.Number;
    var isDraft = Model.Status == WorkshopOS.Domain.Estimates.EstimateStatus.Draft;
    var isSent = Model.Status == WorkshopOS.Domain.Estimates.EstimateStatus.Sent;
    var isTerminal = Model.Status is WorkshopOS.Domain.Estimates.EstimateStatus.Approved
        or WorkshopOS.Domain.Estimates.EstimateStatus.Declined;
}

@await Html.PartialAsync("_DetailWorkspaceHeader", new DetailWorkspaceHeaderViewModel
{
    Eyebrow = Localizer["Estimates_Eyebrow"].Value,
    Title = Model.Number,
    Meta = new HtmlString($"""
        {Model.CustomerDisplayName} · {Model.VehicleSummary} · {Model.Total} {Model.CurrencyCode}
        · <a href="{Url.Action("Details", "RepairOrders", new { repairOrderId = Model.RepairOrderId })}">RO {Model.RepairOrderNumber}</a>
        """),
    StatusBadges = await Html.PartialAsync("_StatusBadge", StatusPresentation.ForEstimate(Model.Status))
})

<div class="wos-action-cluster mb-4">
    @if (Model.CanEditItems)
    {
        <a asp-action="Edit" asp-route-estimateId="@Model.EstimateId" class="btn btn-outline-secondary">@Localizer["Estimates_EditDraft"]</a>
    }
    <a asp-action="Index" class="btn btn-wos-quiet">@Localizer["Estimates_AllEstimates"]</a>
</div>

@if (TempData["EstimateError"] is string estimateError)
{
    <div class="alert alert-warning">@estimateError</div>
}

@if (isSent)
{
    <div class="alert alert-info">
        @Localizer["Estimates_AwaitingDecision"]
    </div>
}

<div class="wos-detail-grid mb-4">
    <section class="wos-detail-panel">
        <h2 class="wos-detail-panel-title">@Localizer["Appointments_JobContext"]</h2>
        <dl class="wos-dl">
            <div class="wos-dl-row">
                <dt>@Localizer["Common_Status"]</dt>
                <dd><partial name="_StatusBadge" model="StatusPresentation.ForEstimate(Model.Status)" /></dd>
            </div>
            <div class="wos-dl-row">
                <dt>@Localizer["Common_Customer"]</dt>
                <dd>@Model.CustomerDisplayName</dd>
            </div>
            <div class="wos-dl-row">
                <dt>@Localizer["Common_Vehicle"]</dt>
                <dd>@Model.VehicleSummary</dd>
            </div>
            <div class="wos-dl-row">
                <dt>@Localizer["Common_Location"]</dt>
                <dd>@Model.WorkshopLocationName</dd>
            </div>
            <div class="wos-dl-row">
                <dt>@Localizer["Estimates_Currency"]</dt>
                <dd>@Model.CurrencyCode</dd>
            </div>
            <div class="wos-dl-row">
                <dt>@Localizer["Common_Total"]</dt>
                <dd>@Model.Total @Model.CurrencyCode</dd>
            </div>
            @if (Model.SentAtUtc.HasValue)
            {
                <div class="wos-dl-row">
                    <dt>@Localizer["Common_Presented"]</dt>
                    <dd>@UiFormatting.FormatDateTime(Model.SentAtUtc.Value)</dd>
                </div>
            }
            @if (Model.ApprovedAtUtc.HasValue)
            {
                <div class="wos-dl-row">
                    <dt>@Localizer["Estimates_ApprovalRecorded"]</dt>
                    <dd>
                        @UiFormatting.FormatDateTime(Model.ApprovedAtUtc.Value)
                        @if (Model.Share?.PortalDecision == WorkshopOS.Domain.Estimates.EstimateShareDecision.Approved)
                        {
                            <span class="text-muted">@Localizer["Estimates_PortalApproval"]</span>
                        }
                        else
                        {
                            <span class="text-muted">@Localizer["Estimates_StaffApproval"]</span>
                        }
                    </dd>
                </div>
            }
            @if (Model.DeclinedAtUtc.HasValue)
            {
                <div class="wos-dl-row">
                    <dt>@Localizer["Estimates_DeclineRecorded"]</dt>
                    <dd>
                        @UiFormatting.FormatDateTime(Model.DeclinedAtUtc.Value)
                        @if (Model.Share?.PortalDecision == WorkshopOS.Domain.Estimates.EstimateShareDecision.Declined)
                        {
                            <span class="text-muted">@Localizer["Estimates_PortalDecline"]</span>
                        }
                        else
                        {
                            <span class="text-muted">@Localizer["Estimates_StaffDecline"]</span>
                        }
                    </dd>
                </div>
            }
        </dl>
    </section>
    <section class="wos-detail-panel">
        @if (Model.InspectionFindings.Count > 0 && Model.LatestInspectionId.HasValue)
        {
            <h2 class="h5">@Localizer["Estimates_InspectionFindings"]</h2>
            <p class="small text-muted">
                Latest inspection
                <a asp-controller="Inspections" asp-action="Details" asp-route-inspectionId="@Model.LatestInspectionId">@Localizer["Estimates_ViewDvi"]</a>
            </p>
            <ul class="list-unstyled small">
                @foreach (var finding in Model.InspectionFindings)
                {
                    <li class="mb-1">
                        <strong>@finding.Section</strong> — @finding.Name:
                        @finding.Condition
                        @if (!string.IsNullOrWhiteSpace(finding.Notes))
                        {
                            <span class="text-muted">(@finding.Notes)</span>
                        }
                    </li>
                }
            </ul>
        }
        @if (!string.IsNullOrWhiteSpace(Model.CustomerMessage))
        {
            <h2 class="wos-detail-panel-title mt-3">@Localizer["Estimates_CustomerMessage"]</h2>
            <div class="wos-note-block">@Model.CustomerMessage</div>
        }
    </section>
</div>

@if (TempData["InvoiceError"] is string invoiceError)
{
    <div class="alert alert-warning">@invoiceError</div>
}

@if (Model.LinkedInvoiceId.HasValue)
{
    <div class="alert alert-light border">
        @Localizer["Invoices_Eyebrow"]
        <a asp-controller="Invoices" asp-action="Details" asp-route-invoiceId="@Model.LinkedInvoiceId">@Model.LinkedInvoiceNumber</a>
        @Localizer["Estimates_InvoiceCreated"]
    </div>
}

@if (Model.CanCreateInvoice)
{
    <form asp-controller="Invoices" asp-action="CreateFromEstimate" asp-route-estimateId="@Model.EstimateId" method="post" class="mb-4">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-primary">@Localizer["Estimates_CreateInvoiceFromEstimate"]</button>
    </form>
}

@if (Model.CanManageShares && Model.Share is not null)
{
    <h2 class="h5 mt-2">@Localizer["Estimates_ShareWithCustomer"]</h2>
    <dl class="row">
        <dt class="col-sm-3">@Localizer["Estimates_ShareStatus"]</dt>
        <dd class="col-sm-9">@Model.Share.Status</dd>
        @if (Model.Share.CreatedAtUtc.HasValue)
        {
            <dt class="col-sm-3">@Localizer["Common_Created"]</dt>
            <dd class="col-sm-9">@UiFormatting.FormatDateTime(Model.Share.CreatedAtUtc.Value)</dd>
        }
        @if (Model.Share.ExpiresAtUtc.HasValue)
        {
            <dt class="col-sm-3">@Localizer["Common_Expires"]</dt>
            <dd class="col-sm-9">@UiFormatting.FormatDateTime(Model.Share.ExpiresAtUtc.Value)</dd>
        }
        @if (Model.Share.LastAccessedAtUtc.HasValue)
        {
            <dt class="col-sm-3">@Localizer["Estimates_LastAccessed"]</dt>
            <dd class="col-sm-9">@UiFormatting.FormatDateTime(Model.Share.LastAccessedAtUtc.Value)</dd>
        }
        @if (Model.Share.PortalDecision.HasValue)
        {
            <dt class="col-sm-3">@Localizer["Estimates_PortalDecision"]</dt>
            <dd class="col-sm-9">
                @Model.Share.PortalDecision
                @if (Model.Share.PortalDecisionAtUtc.HasValue)
                {
                    <span>— @UiFormatting.FormatDateTime(Model.Share.PortalDecisionAtUtc.Value)</span>
                }
            </dd>
        }
    </dl>

    <div class="d-flex flex-wrap gap-2 mb-4">
        @if (Model.Share.CanCreate)
        {
            <form asp-action="CreateShare" asp-route-estimateId="@Model.EstimateId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary">@Localizer["Estimates_CreateSecureLink"]</button>
            </form>
        }
        @if (Model.Share.CanRotate)
        {
            <form asp-action="RotateShare" asp-route-estimateId="@Model.EstimateId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary">@Localizer["Estimates_RotateLink"]</button>
            </form>
        }
        @if (Model.Share.CanRevoke)
        {
            <form asp-action="RevokeShare" asp-route-estimateId="@Model.EstimateId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-warning">@Localizer["Estimates_RevokeLink"]</button>
            </form>
        }
    </div>
}

<h2 class="wos-section-title">@Localizer["Estimates_LineItems"]</h2>
@if (Model.Items.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = Localizer["Estimates_NoLineItems"].Value, Description = Localizer["Estimates_NoLineItemsDesc"].Value })
}
else
{
    <div class="wos-table-wrap">
    <table class="table table-striped mb-0">
        <thead>
            <tr>
                <th>@Localizer["Common_Type"]</th>
                <th>@Localizer["Common_Description"]</th>
                <th>@Localizer["Common_Quantity"]</th>
                <th>@Localizer["Common_UnitPrice"]</th>
                <th>@Localizer["Common_LineTotal"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Type</td>
                <td>@item.Description</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice</td>
                <td>@item.LineTotal</td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="4" class="text-end">@Localizer["Estimates_EstimateTotal"]</th>
                <th>@Model.Total @Model.CurrencyCode</th>
            </tr>
        </tfoot>
    </table>
    </div>
}

@if (Model.CanRecordApproval || Model.CanRecordDecline)
{
    <div class="d-flex gap-2 mt-3">
        @if (Model.CanRecordApproval)
        {
            <form asp-action="RecordApproval" asp-route-estimateId="@Model.EstimateId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">@Localizer["Estimates_RecordApproval"]</button>
            </form>
        }
        @if (Model.CanRecordDecline)
        {
            <form asp-action="RecordDecline" asp-route-estimateId="@Model.EstimateId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-warning">@Localizer["Estimates_RecordDecline"]</button>
            </form>
        }
    </div>
}
