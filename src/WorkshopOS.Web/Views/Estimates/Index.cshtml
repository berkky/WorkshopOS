@model WorkshopOS.Web.Models.Estimates.EstimateListViewModel
@{
    ViewData["Title"] = "Estimates";
}

<header class="wos-page-header">
    <div>
        <h1 class="wos-page-title">Estimates</h1>
        <p class="wos-page-description">@Model.TotalCount estimate(s) in current view</p>
    </div>
    <div class="wos-page-actions">
        <a asp-controller="RepairOrders" asp-action="Index" class="btn btn-outline-secondary">Repair orders</a>
    </div>
</header>

<form asp-action="Index" method="get" class="wos-filter-bar row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label">Search</label>
        <input name="search" value="@Model.Search" class="form-control" placeholder="Estimate, repair order, customer" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Status</label>
        <select name="status" class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<WorkshopOS.Domain.Estimates.EstimateStatus>()">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Location</label>
        <select name="workshopLocationId" class="form-select">
            <option value="">All locations</option>
            @foreach (var location in Model.LocationOptions)
            {
                <option value="@location.WorkshopLocationId" selected="@(Model.WorkshopLocationId == location.WorkshopLocationId)">@location.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
    </div>
</form>

@if (Model.Estimates.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = "No estimates", Description = "No estimates match the current filters." })
}
else
{
    <div class="wos-table-wrap wos-desktop-table">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Estimate</th>
                    <th>Repair order</th>
                    <th>Customer</th>
                    <th>Vehicle</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var estimate in Model.Estimates)
            {
                <tr>
                    <td>@estimate.Number</td>
                    <td>@estimate.RepairOrderNumber</td>
                    <td>@estimate.CustomerDisplayName</td>
                    <td>@estimate.VehicleSummary</td>
                    <td>@estimate.WorkshopLocationName</td>
                    <td><partial name="_StatusBadge" model="StatusPresentation.ForEstimate(estimate.Status)" /></td>
                    <td>@estimate.Total @estimate.CurrencyCode</td>
                    <td>@estimate.CreatedAtUtc.ToString("u")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-estimateId="@estimate.EstimateId" class="btn btn-sm btn-outline-secondary">View</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
