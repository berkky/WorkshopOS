@model WorkshopOS.Web.Models.Estimates.EstimateListViewModel
@{
    ViewData["Title"] = Localizer["Estimates_Title"].Value;
}

<header class="wos-page-header">
    <div>
        <h1 class="wos-page-title">@Localizer["Estimates_Title"]</h1>
        <p class="wos-page-description">@string.Format(Localizer["Estimates_CountInView"].Value, Model.TotalCount)</p>
    </div>
    <div class="wos-page-actions">
        <a asp-controller="RepairOrders" asp-action="Index" class="btn btn-outline-secondary">@Localizer["RepairOrders_Title"]</a>
    </div>
</header>

<form asp-action="Index" method="get" class="wos-filter-bar row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label">@Localizer["Common_Search"]</label>
        <input name="search" value="@Model.Search" class="form-control" placeholder="@Localizer["Estimates_SearchPlaceholder"]" />
    </div>
    <div class="col-md-2">
        <label class="form-label">@Localizer["Common_Status"]</label>
        <select name="status" class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<WorkshopOS.Domain.Estimates.EstimateStatus>()">
            <option value="">@Localizer["Common_AllStatuses"]</option>
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">@Localizer["Common_Location"]</label>
        <select name="workshopLocationId" class="form-select">
            <option value="">@Localizer["Common_AllLocations"]</option>
            @foreach (var location in Model.LocationOptions)
            {
                <option value="@location.WorkshopLocationId" selected="@(Model.WorkshopLocationId == location.WorkshopLocationId)">@location.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">@Localizer["Common_Filter"]</button>
    </div>
</form>

@if (Model.Estimates.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = Localizer["Estimates_NoEstimates"].Value, Description = Localizer["Estimates_NoFilters"].Value })
}
else
{
    <div class="wos-table-wrap wos-desktop-table">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@Localizer["Estimates_Estimate"]</th>
                    <th>@Localizer["Inspections_RepairOrder"]</th>
                    <th>@Localizer["Common_Customer"]</th>
                    <th>@Localizer["Common_Vehicle"]</th>
                    <th>@Localizer["Common_Location"]</th>
                    <th>@Localizer["Common_Status"]</th>
                    <th>@Localizer["Common_Total"]</th>
                    <th>@Localizer["Common_Created"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var estimate in Model.Estimates)
            {
                <tr>
                    <td>@estimate.Number</td>
                    <td>@estimate.RepairOrderNumber</td>
                    <td>@estimate.CustomerDisplayName</td>
                    <td>@estimate.VehicleSummary</td>
                    <td>@estimate.WorkshopLocationName</td>
                    <td><partial name="_StatusBadge" model="StatusPresentation.ForEstimate(estimate.Status)" /></td>
                    <td>@estimate.Total @estimate.CurrencyCode</td>
                    <td>@UiFormatting.FormatDateTime(estimate.CreatedAtUtc)</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-estimateId="@estimate.EstimateId" class="btn btn-sm btn-outline-secondary">@Localizer["Common_View"]</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
