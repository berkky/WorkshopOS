@{
    ViewData["Title"] = Localizer["Landing_PageTitle"];
}

<section class="wos-hero" id="wos-hero">
    <div class="wos-hero-inner">
        <div class="wos-hero-copy">
            <p class="wos-page-eyebrow">@Localizer["Landing_Hero_Eyebrow"]</p>
            <h1>@Localizer["Landing_Hero_HeadingPrefix"]<span class="wos-hero-accent">@Localizer["Landing_Hero_HeadingAccent"]</span>@Localizer["Landing_Hero_HeadingSuffix"]</h1>
            <p class="wos-hero-lead">
                @Localizer["Landing_Hero_Lead"]
            </p>
            <div class="wos-hero-actions">
                <a class="btn btn-wos-primary btn-lg wos-hero-cta" asp-controller="Onboarding" asp-action="Index">@Localizer["Landing_Hero_StartWorkshop"]</a>
                <a class="btn btn-outline-light btn-lg wos-hero-cta" asp-controller="Account" asp-action="Login">@Localizer["Landing_Hero_SignIn"]</a>
            </div>
            <div class="wos-hero-stats">
                <div class="wos-hero-stat">
                    <strong>@Localizer["Landing_Hero_Stat_Operations_Title"]</strong>
                    @Localizer["Landing_Hero_Stat_Operations_Desc"]
                </div>
                <div class="wos-hero-stat">
                    <strong>@Localizer["Landing_Hero_Stat_Commercial_Title"]</strong>
                    @Localizer["Landing_Hero_Stat_Commercial_Desc"]
                </div>
                <div class="wos-hero-stat">
                    <strong>@Localizer["Landing_Hero_Stat_Intelligence_Title"]</strong>
                    @Localizer["Landing_Hero_Stat_Intelligence_Desc"]
                </div>
            </div>
        </div>

        <div class="wos-hero-scene" aria-hidden="true">
            <div class="wos-hero-visual-stage">
                <div class="wos-hero-layer wos-hero-layer--glow" data-depth="0.2" data-z="-120"></div>

                <div class="wos-hero-layer wos-hero-layer--rings" data-depth="0.4" data-z="-60">
                    <div class="wos-hero-ring wos-hero-ring--outer"></div>
                    <div class="wos-hero-ring wos-hero-ring--inner"></div>
                    <div class="wos-hero-platform"></div>
                </div>

                <div class="wos-hero-layer wos-hero-layer--vehicle" data-depth="0.3" data-z="-40">
                    <img class="wos-hero-vehicle" src="~/images/workshopos/hero-vehicle-wireframe.svg" alt="" width="800" height="320" />
                </div>

                <div class="wos-hero-layer wos-hero-layer--dashboard" data-depth="1.2" data-z="40">
                    <div class="wos-hero-glass wos-hero-dashboard">
                        <div class="wos-hero-glass-header">
                            <span class="wos-hero-glass-dot"></span>
                            <span class="wos-hero-glass-dot"></span>
                            <span class="wos-hero-glass-dot"></span>
                            <span class="wos-hero-glass-title">@Localizer["Landing_Hero_GlassTitle"]</span>
                        </div>
                        <div class="wos-hero-kpi-row">
                            <div class="wos-hero-kpi">
                                <span class="wos-hero-kpi-label">@Localizer["Landing_Hero_Kpi_ActiveRos"]</span>
                                <span class="wos-hero-kpi-value">12</span>
                            </div>
                            <div class="wos-hero-kpi">
                                <span class="wos-hero-kpi-label">@Localizer["Landing_Hero_Kpi_Unassigned"]</span>
                                <span class="wos-hero-kpi-value wos-hero-kpi-value--warn">3</span>
                            </div>
                            <div class="wos-hero-kpi">
                                <span class="wos-hero-kpi-label">@Localizer["Landing_Hero_Kpi_Urgent"]</span>
                                <span class="wos-hero-kpi-value wos-hero-kpi-value--urgent">2</span>
                            </div>
                        </div>
                        <div class="wos-hero-dash-bar">
                            <span style="width:72%"></span>
                        </div>
                        <p class="wos-hero-preview-note">@Localizer["Landing_Hero_PreviewNote"]</p>
                    </div>
                </div>

                <div class="wos-hero-layer wos-hero-layer--chart" data-depth="1.6" data-z="70">
                    <div class="wos-hero-glass wos-hero-chart-panel">
                        <span class="wos-hero-chart-label">@Localizer["Landing_Hero_ChartLabel"]</span>
                        <svg class="wos-hero-chart-svg" viewBox="0 0 200 60" preserveAspectRatio="none">
                            <defs>
                                <linearGradient id="chart-fill" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#3b6cf5" stop-opacity="0.35"/>
                                    <stop offset="100%" stop-color="#3b6cf5" stop-opacity="0"/>
                                </linearGradient>
                            </defs>
                            <path class="wos-hero-chart-area" d="M0 50 L30 42 L60 45 L90 28 L120 32 L150 18 L180 24 L200 12 L200 60 L0 60 Z" fill="url(#chart-fill)"/>
                            <path class="wos-hero-chart-line" d="M0 50 L30 42 L60 45 L90 28 L120 32 L150 18 L180 24 L200 12" fill="none" stroke="#22d3ee" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </div>
                </div>

                <div class="wos-hero-layer wos-hero-layer--status" data-depth="1.4" data-z="55">
                    <div class="wos-hero-glass wos-hero-status-ring">
                        <svg viewBox="0 0 80 80" class="wos-hero-ring-svg">
                            <circle cx="40" cy="40" r="32" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="4"/>
                            <circle cx="40" cy="40" r="32" fill="none" stroke="url(#status-gradient)" stroke-width="4" stroke-dasharray="160 60" stroke-linecap="round" class="wos-hero-ring-progress"/>
                            <defs>
                                <linearGradient id="status-gradient" x1="0" y1="0" x2="1" y2="1">
                                    <stop offset="0%" stop-color="#3b6cf5"/>
                                    <stop offset="100%" stop-color="#22d3ee"/>
                                </linearGradient>
                            </defs>
                        </svg>
                        <span class="wos-hero-status-label">@Localizer["Landing_Hero_StatusDviOpen"]</span>
                    </div>
                </div>

                <div class="wos-hero-layer wos-hero-layer--float wos-hero-float--appointment" data-depth="2" data-z="90">
                    <div class="wos-hero-float-card">
                        <span class="wos-hero-float-icon">📅</span>
                        <div>
                            <span class="wos-hero-float-title">@Localizer["Landing_Hero_Float_Appointment_Title"]</span>
                            <span class="wos-hero-float-meta">@Localizer["Landing_Hero_Float_Appointment_Meta"]</span>
                        </div>
                    </div>
                </div>

                <div class="wos-hero-layer wos-hero-layer--float wos-hero-float--inspection" data-depth="2.2" data-z="100">
                    <div class="wos-hero-float-card wos-hero-float-card--alert">
                        <span class="wos-hero-float-icon">🔍</span>
                        <div>
                            <span class="wos-hero-float-title">@Localizer["Landing_Hero_Float_Inspection_Title"]</span>
                            <span class="wos-hero-float-meta">@Localizer["Landing_Hero_Float_Inspection_Meta"]</span>
                        </div>
                    </div>
                </div>

                <div class="wos-hero-layer wos-hero-layer--float wos-hero-float--parts" data-depth="1.8" data-z="80">
                    <div class="wos-hero-float-card">
                        <span class="wos-hero-float-icon">📦</span>
                        <div>
                            <span class="wos-hero-float-title">@Localizer["Landing_Hero_Float_Parts_Title"]</span>
                            <span class="wos-hero-float-meta">@Localizer["Landing_Hero_Float_Parts_Meta"]</span>
                        </div>
                    </div>
                </div>

                <div class="wos-hero-layer wos-hero-layer--particles" data-depth="0.5" data-z="-20">
                    <span class="wos-hero-particle"></span>
                    <span class="wos-hero-particle"></span>
                    <span class="wos-hero-particle"></span>
                    <span class="wos-hero-particle"></span>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="wos-hero-feature-strip" aria-hidden="true">
    <div class="wos-hero-feature-strip-inner">
        <span>@Localizer["Landing_FeatureStrip_RepairOrders"]</span>
        <span>@Localizer["Landing_FeatureStrip_Inspections"]</span>
        <span>@Localizer["Landing_FeatureStrip_Estimates"]</span>
        <span>@Localizer["Landing_FeatureStrip_Inventory"]</span>
        <span>@Localizer["Landing_FeatureStrip_Invoicing"]</span>
        <span>@Localizer["Landing_FeatureStrip_Reporting"]</span>
    </div>
</div>

<section class="wos-section" aria-labelledby="features-heading">
    <div class="wos-section-inner">
        <div class="wos-section-header">
            <p class="wos-section-eyebrow">@Localizer["Landing_Features_Eyebrow"]</p>
            <h2 id="features-heading">@Localizer["Landing_Features_Heading"]</h2>
            <p>@Localizer["Landing_Features_Lead"]</p>
        </div>
        <div class="wos-feature-grid">
            <article class="wos-card wos-feature-card">
                <div class="wos-feature-icon" aria-hidden="true">⚙</div>
                <h3>@Localizer["Landing_Feature_Operations_Title"]</h3>
                <p>@Localizer["Landing_Feature_Operations_Desc"]</p>
            </article>
            <article class="wos-card wos-feature-card">
                <div class="wos-feature-icon" aria-hidden="true">🔍</div>
                <h3>@Localizer["Landing_Feature_Dvi_Title"]</h3>
                <p>@Localizer["Landing_Feature_Dvi_Desc"]</p>
            </article>
            <article class="wos-card wos-feature-card">
                <div class="wos-feature-icon" aria-hidden="true">✓</div>
                <h3>@Localizer["Landing_Feature_Estimate_Title"]</h3>
                <p>@Localizer["Landing_Feature_Estimate_Desc"]</p>
            </article>
            <article class="wos-card wos-feature-card">
                <div class="wos-feature-icon" aria-hidden="true">📦</div>
                <h3>@Localizer["Landing_Feature_Catalog_Title"]</h3>
                <p>@Localizer["Landing_Feature_Catalog_Desc"]</p>
            </article>
            <article class="wos-card wos-feature-card">
                <div class="wos-feature-icon" aria-hidden="true">💳</div>
                <h3>@Localizer["Landing_Feature_Billing_Title"]</h3>
                <p>@Localizer["Landing_Feature_Billing_Desc"]</p>
            </article>
            <article class="wos-card wos-feature-card">
                <div class="wos-feature-icon" aria-hidden="true">📊</div>
                <h3>@Localizer["Landing_Feature_Reporting_Title"]</h3>
                <p>@Localizer["Landing_Feature_Reporting_Desc"]</p>
            </article>
        </div>
    </div>
</section>

<section class="wos-section wos-flow-section" aria-labelledby="flow-heading">
    <div class="wos-section-inner">
        <div class="wos-section-header">
            <p class="wos-section-eyebrow">@Localizer["Landing_Flow_Eyebrow"]</p>
            <h2 id="flow-heading">@Localizer["Landing_Flow_Heading"]</h2>
            <p>@Localizer["Landing_Flow_Lead"]</p>
        </div>
        <div class="wos-flow-steps">
            <div class="wos-flow-step">
                <h3>@Localizer["Landing_Flow_Step1_Title"]</h3>
                <p>@Localizer["Landing_Flow_Step1_Desc"]</p>
            </div>
            <div class="wos-flow-step">
                <h3>@Localizer["Landing_Flow_Step2_Title"]</h3>
                <p>@Localizer["Landing_Flow_Step2_Desc"]</p>
            </div>
            <div class="wos-flow-step">
                <h3>@Localizer["Landing_Flow_Step3_Title"]</h3>
                <p>@Localizer["Landing_Flow_Step3_Desc"]</p>
            </div>
            <div class="wos-flow-step">
                <h3>@Localizer["Landing_Flow_Step4_Title"]</h3>
                <p>@Localizer["Landing_Flow_Step4_Desc"]</p>
            </div>
        </div>
    </div>
</section>

<section class="wos-section wos-trust-section" aria-labelledby="trust-heading">
    <div class="wos-section-inner">
        <div class="wos-section-header">
            <p class="wos-section-eyebrow" style="color: var(--wos-accent-teal);">@Localizer["Landing_Trust_Eyebrow"]</p>
            <h2 id="trust-heading" style="color: #fff;">@Localizer["Landing_Trust_Heading"]</h2>
            <p style="color: var(--wos-text-muted-on-dark);">@Localizer["Landing_Trust_Lead"]</p>
        </div>
        <div class="wos-trust-grid">
            <div class="wos-trust-card">
                <div class="wos-trust-icon" aria-hidden="true">🔒</div>
                <h3>@Localizer["Landing_Trust_MultiTenant_Title"]</h3>
                <p>@Localizer["Landing_Trust_MultiTenant_Desc"]</p>
            </div>
            <div class="wos-trust-card">
                <div class="wos-trust-icon" aria-hidden="true">🏢</div>
                <h3>@Localizer["Landing_Trust_MultiLocation_Title"]</h3>
                <p>@Localizer["Landing_Trust_MultiLocation_Desc"]</p>
            </div>
            <div class="wos-trust-card">
                <div class="wos-trust-icon" aria-hidden="true">🔗</div>
                <h3>@Localizer["Landing_Trust_Portal_Title"]</h3>
                <p>@Localizer["Landing_Trust_Portal_Desc"]</p>
            </div>
        </div>
    </div>
</section>

<section class="wos-cta-band" aria-labelledby="cta-heading">
    <h2 id="cta-heading">@Localizer["Landing_Cta_Heading"]</h2>
    <p>@Localizer["Landing_Cta_Lead"]</p>
    <div class="d-flex flex-wrap gap-3 justify-content-center">
        <a class="btn btn-wos-primary btn-lg" asp-controller="Onboarding" asp-action="Index">@Localizer["Landing_Cta_Create"]</a>
        <a class="btn btn-wos-secondary btn-lg" asp-controller="Account" asp-action="Login">@Localizer["Landing_Cta_SignIn"]</a>
    </div>
</section>

@section Scripts {
    <script src="~/js/workshopos-hero.js" asp-append-version="true"></script>
}
