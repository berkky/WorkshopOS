@model IReadOnlyList<WorkshopOS.Web.Models.Operations.OperationsBoardItemViewModel>

@if (Model.Count == 0)
{
    <div class="wos-empty wos-card mb-3">
        <div class="wos-empty-title">@Localizer["Operations_NoRepairOrders"]</div>
        <p class="mb-0">@Localizer["Operations_NoRepairOrdersColumn"]</p>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        <a class="wos-board-card" asp-controller="RepairOrders" asp-action="Details" asp-route-repairOrderId="@item.RepairOrderId">
            <div class="d-flex justify-content-between align-items-start gap-2">
                <div class="min-w-0">
                    <div class="fw-semibold">@item.Number</div>
                    <partial name="_StatusBadge" model="StatusPresentation.ForRepairOrderPriority(item.Priority)" />
                    <div class="small text-muted mt-2">@item.CustomerDisplayName · @item.VehicleSummary</div>
                    <div class="small">@item.WorkshopLocationName</div>
                    <div class="small text-muted">
                        @Localizer["Operations_TechnicianLabel"]
                        @if (string.IsNullOrWhiteSpace(item.AssignedTechnicianDisplayName))
                        {
                            <span class="text-warning">@Localizer["Common_Unassigned"]</span>
                        }
                        else
                        {
                            <span>
                                @item.AssignedTechnicianDisplayName
                                @if (item.TechnicianWorkStatus.HasValue)
                                {
                                    <partial name="_StatusBadge" model="StatusPresentation.ForTechnicianWork(item.TechnicianWorkStatus.Value)" />
                                }
                            </span>
                        }
                    </div>
                </div>
                <partial name="_StatusBadge" model="StatusPresentation.ForRepairOrder(item.Status)" />
            </div>
        </a>
    }
}
