@model WorkshopOS.Web.Models.Inventory.InventoryAdjustFormViewModel
@using WorkshopOS.Application.Catalog
@using WorkshopOS.Application.Team
@{
    ViewData["Title"] = "Adjust inventory";
    var partOptions = (IReadOnlyList<PartCatalogListItem>)ViewBag.PartOptions;
    var locationOptions = (IReadOnlyList<WorkshopLocationOption>)ViewBag.LocationOptions;
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Inventory",
    Title = "Adjust inventory",
    Description = "Record a stock movement. This updates the on-hand balance ledger — not online payment processing."
})

<form method="post" class="wos-form-shell">
    @Html.AntiForgeryToken()
    <partial name="_FormValidationSummary" />

    <section class="wos-form-section">
        <h2 class="wos-form-section-title">Part &amp; location</h2>
        <div class="wos-form-grid">
            <div class="wos-field">
                <label asp-for="PartCatalogItemId" class="wos-field-label"></label>
                <select asp-for="PartCatalogItemId" class="form-select" required>
                    <option value="">Select part</option>
                    @foreach (var part in partOptions)
                    {
                        <option value="@part.PartCatalogItemId">@part.Sku — @part.Name</option>
                    }
                </select>
            </div>
            <div class="wos-field">
                <label asp-for="WorkshopLocationId" class="wos-field-label"></label>
                <select asp-for="WorkshopLocationId" class="form-select" required>
                    <option value="">Select location</option>
                    @foreach (var location in locationOptions)
                    {
                        <option value="@location.WorkshopLocationId">@location.Name</option>
                    }
                </select>
            </div>
        </div>
    </section>

    <section class="wos-form-section">
        <h2 class="wos-form-section-title">Movement</h2>
        <div class="wos-form-grid wos-form-grid-2">
            <div class="wos-field">
                <label asp-for="MovementType" class="wos-field-label"></label>
                <select asp-for="MovementType" class="form-select" asp-items="Html.GetEnumSelectList<WorkshopOS.Domain.Inventory.PartInventoryMovementType>()"></select>
            </div>
            <div class="wos-field">
                <label asp-for="Quantity" class="wos-field-label"></label>
                <input asp-for="Quantity" class="form-control" type="number" step="0.001" min="0.001" />
                <p class="wos-field-help">Enter a positive quantity. Decreases are applied based on movement type.</p>
            </div>
            <div class="wos-field wos-field-full">
                <label asp-for="Reason" class="wos-field-label"></label>
                <input asp-for="Reason" class="form-control" maxlength="500" />
                <p class="wos-field-help">Required context for audit trail (receipt, correction, usage, etc.).</p>
            </div>
        </div>
    </section>

    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">Record adjustment</button>
        <a asp-action="Index" class="btn btn-wos-quiet">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
