@model WorkshopOS.Web.Models.Inventory.InventoryListViewModel
@{
    ViewData["Title"] = "Inventory";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="display-6">Inventory</h1>
        <p class="text-muted mb-0">@Model.TotalCount balance row(s)</p>
    </div>
    @if (Model.CanAdjustInventory)
    {
        <a class="btn btn-primary" asp-action="Adjust">Adjust stock</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <select name="workshopLocationId" class="form-select">
            <option value="">All locations</option>
            @foreach (var location in Model.LocationOptions)
            {
                <option value="@location.WorkshopLocationId" selected="@(Model.WorkshopLocationId == location.WorkshopLocationId)">@location.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" name="lowOrZeroStockOnly" value="true" id="lowStock" @(Model.LowOrZeroStockOnly ? "checked" : null) />
            <label class="form-check-label" for="lowStock">Low / zero stock only</label>
        </div>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-light border">No inventory balances match the current filters.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>SKU</th>
                <th>Part</th>
                <th>Location</th>
                <th>On hand</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td><code>@item.PartSku</code></td>
                <td>@item.PartName @(item.PartIsActive ? "" : "(inactive)")</td>
                <td>@item.WorkshopLocationName</td>
                <td>@item.QuantityOnHand</td>
                <td class="text-end">
                    <a asp-action="History" asp-route-partCatalogItemId="@item.PartCatalogItemId" asp-route-workshopLocationId="@item.WorkshopLocationId" class="btn btn-sm btn-outline-secondary">History</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
