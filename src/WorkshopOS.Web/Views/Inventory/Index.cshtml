@model WorkshopOS.Web.Models.Inventory.InventoryListViewModel
@{
    ViewData["Title"] = Localizer["Inventory_Title"].Value;
}

<header class="wos-page-header">
    <div>
        <h1 class="wos-page-title">@Localizer["Inventory_Title"]</h1>
        <p class="wos-page-description">@string.Format(Localizer["Inventory_CountInView"].Value, Model.TotalCount)</p>
    </div>
    @if (Model.CanAdjustInventory)
    {
        <div class="wos-page-actions">
            <a class="btn btn-wos-primary" asp-action="Adjust">@Localizer["Inventory_AdjustStock"]</a>
        </div>
    }
</header>

<form method="get" class="wos-filter-bar row g-3 align-items-end mb-4">
    <div class="col-md-4">
        <label class="form-label">@Localizer["Common_Location"]</label>
        <select name="workshopLocationId" class="form-select">
            <option value="">@Localizer["Common_AllLocations"]</option>
            @foreach (var location in Model.LocationOptions)
            {
                <option value="@location.WorkshopLocationId" selected="@(Model.WorkshopLocationId == location.WorkshopLocationId)">@location.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <div class="form-check mt-4">
            <input class="form-check-input" type="checkbox" name="lowOrZeroStockOnly" value="true" id="lowStock" @(Model.LowOrZeroStockOnly ? "checked" : null) />
            <label class="form-check-label" for="lowStock">@Localizer["Inventory_LowZeroStock"]</label>
        </div>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">@Localizer["Common_Filter"]</button>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = Localizer["Inventory_NoBalances"].Value, Description = Localizer["Inventory_NoBalancesDesc"].Value })
}
else
{
    <div class="wos-table-wrap wos-desktop-table">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>@Localizer["Common_Sku"]</th>
                    <th>@Localizer["Inventory_Part"]</th>
                    <th>@Localizer["Common_Location"]</th>
                    <th>@Localizer["Inventory_OnHand"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td><code>@item.PartSku</code></td>
                    <td>@item.PartName @(item.PartIsActive ? "" : Localizer["Common_Inactive"].Value)</td>
                    <td>@item.WorkshopLocationName</td>
                    <td>@item.QuantityOnHand</td>
                    <td class="text-end">
                        <a asp-action="History" asp-route-partCatalogItemId="@item.PartCatalogItemId" asp-route-workshopLocationId="@item.WorkshopLocationId" class="btn btn-sm btn-outline-secondary">@Localizer["Common_History"]</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="wos-mobile-list">
        @foreach (var item in Model.Items)
        {
            <a asp-action="History" asp-route-partCatalogItemId="@item.PartCatalogItemId" asp-route-workshopLocationId="@item.WorkshopLocationId" class="wos-list-card">
                <div class="wos-list-card-title">@item.PartName</div>
                <div class="wos-list-card-meta">
                    <span><code>@item.PartSku</code></span>
                    <span>@item.WorkshopLocationName</span>
                    <span>@string.Format(Localizer["Inventory_OnHandLabel"].Value, item.QuantityOnHand)</span>
                </div>
            </a>
        }
    </div>
}
