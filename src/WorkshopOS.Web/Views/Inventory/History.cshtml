@model WorkshopOS.Web.Models.Inventory.InventoryHistoryViewModel
@{
    ViewData["Title"] = "Inventory history";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Inventory",
    Title = "Inventory history",
    Description = $"{Model.PartSku} — {Model.PartName} at {Model.WorkshopLocationName}"
})

@if (Model.Movements.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
    {
        Title = "No movements recorded",
        Description = "No inventory movements have been recorded for this part and location."
    })
}
else
{
    <div class="wos-table-wrap">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>When (UTC)</th>
                    <th>Type</th>
                    <th>Delta</th>
                    <th>Balance after</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var movement in Model.Movements)
            {
                <tr>
                    <td>@movement.OccurredAtUtc.ToString("u")</td>
                    <td>@movement.MovementType</td>
                    <td>@movement.QuantityDelta</td>
                    <td>@movement.BalanceAfter</td>
                    <td>@(string.IsNullOrWhiteSpace(movement.Reason) ? "—" : movement.Reason)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<div class="mt-4">
    <a asp-action="Index" class="btn btn-wos-quiet">Back to inventory</a>
</div>
