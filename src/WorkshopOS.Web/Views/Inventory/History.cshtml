@model WorkshopOS.Web.Models.Inventory.InventoryHistoryViewModel
@{
    ViewData["Title"] = Localizer["Inventory_HistoryTitle"].Value;
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = Localizer["Inventory_Title"].Value,
    Title = Localizer["Inventory_HistoryTitle"].Value,
    Description = $"{Model.PartSku} — {Model.PartName} at {Model.WorkshopLocationName}"
})

@if (Model.Movements.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
    {
        Title = Localizer["Inventory_NoMovements"].Value,
        Description = Localizer["Inventory_NoMovementsDesc"].Value
    })
}
else
{
    <div class="wos-table-wrap">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@Localizer["Inventory_WhenUtc"]</th>
                    <th>@Localizer["Common_Type"]</th>
                    <th>@Localizer["Inventory_Delta"]</th>
                    <th>@Localizer["Inventory_BalanceAfter"]</th>
                    <th>@Localizer["Inventory_Reason"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var movement in Model.Movements)
            {
                <tr>
                    <td>@UiFormatting.FormatDateTime(movement.OccurredAtUtc)</td>
                    <td>@movement.MovementType</td>
                    <td>@movement.QuantityDelta</td>
                    <td>@movement.BalanceAfter</td>
                    <td>@(string.IsNullOrWhiteSpace(movement.Reason) ? Localizer["Common_NoValue"].Value : movement.Reason)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<div class="mt-4">
    <a asp-action="Index" class="btn btn-wos-quiet">@Localizer["Inventory_BackToInventory"]</a>
</div>
