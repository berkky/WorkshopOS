@model WorkshopOS.Web.Models.RepairOrders.RepairOrderListViewModel
@using WorkshopOS.Web.Models.Shared
@{
    ViewData["Title"] = Localizer["RepairOrders_Title"].Value;
    var paginationRouteValues = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        paginationRouteValues["search"] = Model.Search;
    }
    if (Model.Status.HasValue)
    {
        paginationRouteValues["status"] = Model.Status.Value.ToString();
    }
    if (Model.WorkshopLocationId.HasValue)
    {
        paginationRouteValues["workshopLocationId"] = Model.WorkshopLocationId.Value.ToString();
    }
    if (Model.CustomerId.HasValue)
    {
        paginationRouteValues["customerId"] = Model.CustomerId.Value.ToString();
    }
    if (Model.VehicleId.HasValue)
    {
        paginationRouteValues["vehicleId"] = Model.VehicleId.Value.ToString();
    }
}

<header class="wos-page-header">
    <div>
        <h1 class="wos-page-title">@Localizer["RepairOrders_Title"]</h1>
        <p class="wos-page-description">@string.Format(Localizer["RepairOrders_CountInView"].Value, Model.TotalCount)</p>
    </div>
    @if (Model.CanManageRepairOrders)
    {
        <div class="wos-page-actions">
            <a asp-action="Create" class="btn btn-wos-primary">@Localizer["RepairOrders_Create"]</a>
        </div>
    }
</header>

<form asp-action="Index" method="get" class="wos-filter-bar row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label">@Localizer["Common_Search"]</label>
        <input name="search" value="@Model.Search" class="form-control" placeholder="@Localizer["RepairOrders_SearchPlaceholder"]" />
    </div>
    <div class="col-md-2">
        <label class="form-label">@Localizer["Common_Location"]</label>
        <select name="workshopLocationId" class="form-select">
            <option value="">@Localizer["Common_AllLocations"]</option>
            @foreach (var location in Model.LocationOptions)
            {
                <option value="@location.WorkshopLocationId" selected="@(Model.WorkshopLocationId == location.WorkshopLocationId)">@location.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">@Localizer["Common_Status"]</label>
        <select name="status" class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<WorkshopOS.Domain.RepairOrders.RepairOrderStatus>()">
            <option value="">@Localizer["Common_AllStatuses"]</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">@Localizer["Common_Filter"]</button>
    </div>
</form>

@if (Model.RepairOrders.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
    {
        Title = Model.HasActiveFilters ? Localizer["RepairOrders_NoMatching"].Value : Localizer["RepairOrders_NoYet"].Value,
        Description = Model.HasActiveFilters
            ? Localizer["RepairOrders_NoFilters"].Value
            : Localizer["RepairOrders_NoYetDesc"].Value
    })
}
else
{
    <div class="wos-table-wrap wos-desktop-table">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@Localizer["Common_Number"]</th>
                    <th>@Localizer["Common_Opened"]</th>
                    <th>@Localizer["Common_Location"]</th>
                    <th>@Localizer["Common_Customer"]</th>
                    <th>@Localizer["Common_Vehicle"]</th>
                    <th>@Localizer["Common_Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var repairOrder in Model.RepairOrders)
            {
                <tr>
                    <td>@repairOrder.Number</td>
                    <td>@UiFormatting.FormatDateTime(repairOrder.OpenedAtUtc)</td>
                    <td>@repairOrder.WorkshopLocationName</td>
                    <td>@repairOrder.CustomerDisplayName</td>
                    <td>@repairOrder.VehicleSummary</td>
                    <td><partial name="_StatusBadge" model="StatusPresentation.ForRepairOrder(repairOrder.Status)" /></td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-repairOrderId="@repairOrder.RepairOrderId" class="btn btn-sm btn-outline-primary">@Localizer["Common_View"]</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="wos-mobile-list">
        @foreach (var repairOrder in Model.RepairOrders)
        {
            <a asp-action="Details" asp-route-repairOrderId="@repairOrder.RepairOrderId" class="wos-list-card">
                <div class="wos-list-card-title">@repairOrder.Number</div>
                <div class="wos-list-card-meta">
                    <span>@repairOrder.CustomerDisplayName</span>
                    <span>@repairOrder.VehicleSummary</span>
                    <span>@repairOrder.WorkshopLocationName · @UiFormatting.FormatDateTime(repairOrder.OpenedAtUtc)</span>
                </div>
                <div class="wos-list-card-footer">
                    <partial name="_StatusBadge" model="StatusPresentation.ForRepairOrder(repairOrder.Status)" />
                    <span class="text-muted small">@Localizer["Common_View"]</span>
                </div>
            </a>
        }
    </div>

    @await Html.PartialAsync("_Pagination", new PaginationViewModel
    {
        Action = "Index",
        Page = Model.Page,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        RouteValues = paginationRouteValues
    })
}
