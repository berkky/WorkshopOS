@model WorkshopOS.Web.Models.RepairOrders.RepairOrderListViewModel
@{
    ViewData["Title"] = "Repair orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="display-6">Repair orders</h1>
        <p class="text-muted mb-0">@Model.TotalCount repair order(s) in current view</p>
    </div>
    @if (Model.CanManageRepairOrders)
    {
        <a asp-action="Create" class="btn btn-primary">Create repair order</a>
    }
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search number, customer, vehicle" />
    </div>
    <div class="col-md-2">
        <select name="workshopLocationId" class="form-select">
            <option value="">All locations</option>
            @foreach (var location in Model.LocationOptions)
            {
                <option value="@location.WorkshopLocationId" selected="@(Model.WorkshopLocationId == location.WorkshopLocationId)">@location.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<WorkshopOS.Domain.RepairOrders.RepairOrderStatus>()">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
    </div>
</form>

@if (Model.RepairOrders.Count == 0)
{
    <div class="alert alert-light border">No repair orders match the current filters.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Number</th>
                <th>Opened</th>
                <th>Location</th>
                <th>Customer</th>
                <th>Vehicle</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var repairOrder in Model.RepairOrders)
        {
            <tr>
                <td>@repairOrder.Number</td>
                <td>@repairOrder.OpenedAtUtc.ToString("u")</td>
                <td>@repairOrder.WorkshopLocationName</td>
                <td>@repairOrder.CustomerDisplayName</td>
                <td>@repairOrder.VehicleSummary</td>
                <td>@repairOrder.Status</td>
                <td><a asp-action="Details" asp-route-repairOrderId="@repairOrder.RepairOrderId">Details</a></td>
            </tr>
        }
        </tbody>
    </table>
}
