@model WorkshopOS.Web.Models.RepairOrders.RepairOrderFormViewModel
@{
    ViewData["Title"] = "Create repair order";
}

<h1 class="display-6">Create repair order</h1>
<p class="text-muted">Walk-in or unscheduled intake. Customer and vehicle must already exist in CRM.</p>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <partial name="_RepairOrderFormFields" model="Model" />
    <button type="submit" class="btn btn-primary">Create repair order</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
