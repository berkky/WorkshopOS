@model WorkshopOS.Web.Models.RepairOrders.RepairOrderFormViewModel
@{
    ViewData["Title"] = Localizer["RepairOrders_CreateTitle"].Value;
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = Localizer["RepairOrders_Title"].Value,
    Title = Localizer["RepairOrders_CreateTitle"].Value,
    Description = Localizer["RepairOrders_CreateDescription"].Value
})

<form asp-action="Create" method="post" class="wos-form-shell">
    @Html.AntiForgeryToken()
    <partial name="_RepairOrderFormFields" model="Model" />
    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">@Localizer["RepairOrders_Create"]</button>
        <a asp-action="Index" class="btn btn-wos-quiet">@Localizer["Common_Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
