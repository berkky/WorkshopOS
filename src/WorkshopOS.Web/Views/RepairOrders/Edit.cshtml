@model WorkshopOS.Web.Models.RepairOrders.RepairOrderFormViewModel
@{
    ViewData["Title"] = "Edit service intake";
}

<h1 class="display-6">Edit service intake</h1>
<p class="text-muted">Customer, vehicle, and appointment link cannot be changed here.</p>

<form asp-action="Edit" asp-route-repairOrderId="@Model.RepairOrderId" method="post">
    @Html.AntiForgeryToken()
    <partial name="_RepairOrderFormFields" model="Model" />
    <button type="submit" class="btn btn-primary">Save intake</button>
    <a asp-action="Details" asp-route-repairOrderId="@Model.RepairOrderId" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
