@model WorkshopOS.Web.Models.RepairOrders.RepairOrderFormViewModel
@{
    ViewData["Title"] = "Edit service intake";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Repair orders",
    Title = "Edit service intake",
    Description = "Customer, vehicle, and appointment link cannot be changed here."
})

<form asp-action="Edit" asp-route-repairOrderId="@Model.RepairOrderId" method="post" class="wos-form-shell">
    @Html.AntiForgeryToken()
    <partial name="_RepairOrderFormFields" model="Model" />
    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">Save intake</button>
        <a asp-action="Details" asp-route-repairOrderId="@Model.RepairOrderId" class="btn btn-wos-quiet">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
