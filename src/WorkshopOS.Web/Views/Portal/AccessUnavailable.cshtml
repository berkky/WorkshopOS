@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Localizer["Portal_UnavailableTitle"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/workshopos-fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workshopos-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workshopos-public.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="wos-public-body">
<main class="wos-auth-shell">
    <div class="wos-auth-card text-center" style="max-width: 560px;">
        <div class="wos-public-brand-mark mx-auto mb-3" aria-hidden="true">W</div>
        <h1 class="h4 mb-3">@Localizer["Portal_SecureLinkUnavailable"]</h1>
        <p class="text-muted mb-0">@Localizer["Portal_ContactWorkshop"]</p>
    </div>
</main>
</body>
</html>
