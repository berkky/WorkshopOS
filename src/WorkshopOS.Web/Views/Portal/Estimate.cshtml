@model WorkshopOS.Web.Models.CustomerPortal.CustomerPortalEstimateViewModel
@{
    Layout = "_CustomerPortalLayout";
    ViewData["Title"] = $"Estimate {Model.EstimateNumber}";
    var vehicle = Model.VehicleModelYear.HasValue
        ? $"{Model.VehicleMake} {Model.VehicleModel} ({Model.VehicleModelYear})"
        : $"{Model.VehicleMake} {Model.VehicleModel}";
}

<div class="portal-hero mb-4">
    <p class="portal-kicker mb-1">@Model.OrganizationDisplayName</p>
    <h1 class="h3 mb-1">Estimate @Model.EstimateNumber</h1>
    <p class="text-muted mb-0">Repair order @Model.RepairOrderNumber</p>
</div>

@if (TempData["PortalError"] is string portalError)
{
    <div class="alert alert-warning">@portalError</div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card portal-card h-100">
            <div class="card-body">
                <h2 class="h6 text-uppercase text-muted">Vehicle</h2>
                <p class="mb-1 fw-semibold">@vehicle</p>
                @if (!string.IsNullOrWhiteSpace(Model.VehicleRegistrationPlate))
                {
                    <p class="text-muted mb-3">@Model.VehicleRegistrationPlate</p>
                }
                <h2 class="h6 text-uppercase text-muted mt-4">Status</h2>
                <p class="mb-0">@Model.Status</p>
                @if (Model.PresentedAtUtc.HasValue)
                {
                    <p class="small text-muted mt-2 mb-0">Presented @Model.PresentedAtUtc.Value.ToString("u")</p>
                }
                @if (Model.PortalDecision.HasValue)
                {
                    <p class="small text-muted mt-2 mb-0">
                        Customer portal decision: @Model.PortalDecision
                        @if (Model.DecisionAtUtc.HasValue)
                        {
                            <span>— @Model.DecisionAtUtc.Value.ToString("u")</span>
                        }
                    </p>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        @if (!string.IsNullOrWhiteSpace(Model.CustomerMessage))
        {
            <div class="card portal-card mb-4">
                <div class="card-body">
                    <h2 class="h6 text-uppercase text-muted">Message from the workshop</h2>
                    <p class="mb-0">@Model.CustomerMessage</p>
                </div>
            </div>
        }

        <div class="card portal-card">
            <div class="card-body">
                <h2 class="h6 text-uppercase text-muted mb-3">Recommended work</h2>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Unit</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Description</td>
                                <td class="text-end">@item.Quantity</td>
                                <td class="text-end">@item.UnitPrice</td>
                                <td class="text-end">@item.LineTotal</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Estimate total</th>
                                <th class="text-end">@Model.Total @Model.CurrencyCode</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.CanApprove || Model.CanDecline)
{
    <div class="card portal-card mt-4">
        <div class="card-body d-flex flex-column flex-md-row gap-2 justify-content-between align-items-md-center">
            <div>
                <h2 class="h6 mb-1">Your decision</h2>
                <p class="text-muted small mb-0">Submit your approval or decline for this estimate. This is not a digital signature.</p>
            </div>
            <div class="d-flex gap-2">
                <form asp-controller="Portal" asp-action="Approve" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">Approve estimate</button>
                </form>
                <form asp-controller="Portal" asp-action="Decline" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary">Decline estimate</button>
                </form>
            </div>
        </div>
    </div>
}
else if (Model.Status == WorkshopOS.Domain.Estimates.EstimateStatus.Approved)
{
    <div class="alert alert-success mt-4 mb-0">Thank you. This estimate has been approved.</div>
}
else if (Model.Status == WorkshopOS.Domain.Estimates.EstimateStatus.Declined)
{
    <div class="alert alert-secondary mt-4 mb-0">This estimate has been declined.</div>
}

<form asp-controller="Portal" asp-action="Logout" method="post" class="mt-4">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-link px-0">End secure session</button>
</form>
