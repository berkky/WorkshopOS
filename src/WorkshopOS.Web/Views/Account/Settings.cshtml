@model WorkshopOS.Web.Models.Account.SettingsViewModel
@{
    ViewData["Title"] = Localizer["Account_Settings_Title"].Value;
}

<header class="wos-page-header">
    <div>
        <p class="wos-page-eyebrow">@Localizer["Account_Settings_Eyebrow"]</p>
        <h1 class="wos-page-title">@Localizer["Account_Settings_Title"]</h1>
        <p class="wos-page-description">@Localizer["Account_Settings_Description"]</p>
    </div>
    <div class="wos-page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Profile">@Localizer["Account_MyProfile"]</a>
    </div>
</header>

<section class="wos-settings-section">
    <h2 class="wos-settings-section-title">@Localizer["Account_Language"]</h2>
    <p class="wos-settings-section-lead">@Localizer["Account_Language_Description"]</p>
    <partial name="_LanguageSwitcher" />
</section>

<section class="wos-settings-section">
    <h2 class="wos-settings-section-title">@Localizer["Account_RegionalContext"]</h2>
    <div class="wos-settings-row">
        <div class="wos-settings-row-label">@Localizer["Account_TimeZone"]</div>
        <div class="wos-settings-row-value">@(Model.OrganizationTimeZoneId ?? Localizer["Common_NotAvailable"].Value)</div>
    </div>
</section>

<section class="wos-settings-section">
    <h2 class="wos-settings-section-title">@Localizer["Account_Workspace"]</h2>
    <div class="wos-settings-row">
        <div class="wos-settings-row-label">@Localizer["Account_Organization"]</div>
        <div class="wos-settings-row-value">@(Model.OrganizationName ?? Localizer["Common_NotAvailable"].Value)</div>
    </div>
    @if (Model.CanSwitchWorkspace)
    {
        <div class="mt-3">
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Organization" asp-action="Select">@Localizer["Account_SwitchWorkspace"]</a>
        </div>
    }
</section>

<section class="wos-settings-section">
    <h2 class="wos-settings-section-title">@Localizer["Account_Security"]</h2>
    <p class="wos-settings-section-lead">@Localizer["Account_Security_SettingsLead"]</p>
    <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Security">@Localizer["Account_ChangePassword"]</a>
</section>
