@model WorkshopOS.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = Localizer["Login_Title"];
}

<div class="wos-auth-shell">
    <div class="wos-auth-card">
        <div class="wos-auth-brand-strip">
            <div class="wos-public-brand-mark" aria-hidden="true">W</div>
        </div>
        <h1 class="wos-page-title text-center mb-2">@Localizer["Login_WelcomeBack"]</h1>
        <p class="wos-page-description text-center mb-4">@Localizer["Login_Description"]</p>

        <form asp-action="Login" asp-controller="Account" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <partial name="_FormValidationSummary" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" placeholder="@Localizer["Login_EmailPlaceholder"]" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-wos-primary btn-lg">@Localizer["Login_Submit"]</button>
                <a class="btn btn-wos-secondary" asp-controller="Onboarding" asp-action="Index">@Localizer["Login_CreateWorkshop"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
