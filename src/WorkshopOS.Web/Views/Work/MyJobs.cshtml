@model WorkshopOS.Web.Models.Work.MyWorkViewModel
@{
    ViewData["Title"] = Localizer["Work_Title"].Value;
}

<header class="wos-page-header">
    <div>
        <div class="wos-page-eyebrow">@Localizer["Work_Eyebrow"]</div>
        <h1 class="wos-page-title">@Localizer["Work_Title"]</h1>
        <p class="wos-page-description">@Localizer["Work_Description"]</p>
    </div>
    <div class="wos-page-actions">
        <a asp-controller="Operations" asp-action="Index" class="btn btn-outline-secondary">@Localizer["Work_OperationsBoard"]</a>
    </div>
</header>

@if (!Model.HasLinkedTechnicianProfile)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
    {
        Title = Localizer["Work_NoProfileTitle"].Value,
        Description = Localizer["Work_NoProfileDesc"].Value
    })
}
else if (Model.Items.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel
    {
        Title = Localizer["Work_NoAssignmentsTitle"].Value,
        Description = Localizer["Work_NoAssignmentsDesc"].Value
    })
}
else
{
    <div class="wos-table-wrap wos-desktop-table">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@Localizer["Inspections_RepairOrder"]</th>
                    <th>@Localizer["Common_Priority"]</th>
                    <th>@Localizer["Common_Customer"]</th>
                    <th>@Localizer["Common_Vehicle"]</th>
                    <th>@Localizer["Common_Location"]</th>
                    <th>@Localizer["Work_JobStatus"]</th>
                    <th>@Localizer["Work_YourWork"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var job in Model.Items)
            {
                <tr>
                    <td><a asp-controller="RepairOrders" asp-action="Details" asp-route-repairOrderId="@job.RepairOrderId">@job.Number</a></td>
                    <td><partial name="_StatusBadge" model="StatusPresentation.ForRepairOrderPriority(job.Priority)" /></td>
                    <td>@job.CustomerDisplayName</td>
                    <td>@job.VehicleSummary</td>
                    <td>@job.WorkshopLocationName</td>
                    <td><partial name="_StatusBadge" model="StatusPresentation.ForRepairOrder(job.RepairOrderStatus)" /></td>
                    <td><partial name="_StatusBadge" model="StatusPresentation.ForTechnicianWork(job.TechnicianWorkStatus)" /></td>
                    <td class="text-end">
                        @if (job.CanStartWork)
                        {
                            <form asp-action="Start" asp-route-repairOrderId="@job.RepairOrderId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-wos-primary">@Localizer["RepairOrders_StartWork"]</button>
                            </form>
                        }
                        @if (job.CanCompleteWork)
                        {
                            <form asp-action="Complete" asp-route-repairOrderId="@job.RepairOrderId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success">@Localizer["Common_Complete"]</button>
                            </form>
                        }
                        @if (job.LatestInspectionId.HasValue)
                        {
                            <a asp-controller="Inspections" asp-action="Details" asp-route-inspectionId="@job.LatestInspectionId" class="btn btn-sm btn-outline-secondary">
                                @(job.LatestInspectionStatus == WorkshopOS.Domain.Inspections.InspectionStatus.Draft ? Localizer["Work_StartInspection"].Value : Localizer["Work_ContinueInspection"].Value)
                            </a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="wos-mobile-list">
        @foreach (var job in Model.Items)
        {
            <a asp-controller="RepairOrders" asp-action="Details" asp-route-repairOrderId="@job.RepairOrderId" class="wos-list-card">
                <div class="wos-list-card-title">@job.Number</div>
                <div class="wos-list-card-meta">
                    <span>@job.CustomerDisplayName · @job.VehicleSummary</span>
                    <span>@job.WorkshopLocationName</span>
                </div>
                <div class="wos-list-card-footer">
                    <partial name="_StatusBadge" model="StatusPresentation.ForTechnicianWork(job.TechnicianWorkStatus)" />
                    <span class="text-muted small">@Localizer["Common_View"]</span>
                </div>
            </a>
        }
    </div>
}
