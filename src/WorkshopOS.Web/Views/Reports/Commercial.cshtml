@model WorkshopOS.Web.Models.Reporting.CommercialReportViewModel
@using WorkshopOS.Web.Models.Reporting
@{
    ViewData["Title"] = Localizer["Reports_CommercialTitle"].Value;
    var header = Model.Report.Header;
    var periodLabel = UiFormatting.FormatReportingPeriod(header);
    var locationLabel = UiFormatting.FormatLocationScope(header.WorkshopLocationName);
}

<header class="wos-page-header">
    <div>
        <p class="wos-page-eyebrow">@Localizer["Common_Reporting"]</p>
        <h1 class="wos-page-title">@Localizer["Reports_CommercialTitle"]</h1>
        <p class="wos-page-description">
            @locationLabel · @Localizer["Common_TimeZone"]: @header.TimeZoneId · @Localizer["Common_Generated"] @UiFormatting.FormatGeneratedAt(header.GeneratedAtUtc, header.TimeZoneId)
        </p>
    </div>
    <div class="wos-page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Dashboard" asp-action="Index">@Localizer["Common_Dashboard"]</a>
    </div>
</header>

@await Html.PartialAsync("_ReportingFilter", Model.Filter)

<h2 class="h5 mt-4">@string.Format(Localizer["Reports_EstimateFunnel"].Value, periodLabel)</h2>
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="text-muted small">@Localizer["Reports_Presented"]</div>
            <div class="fs-4">@Model.Report.SelectedPeriod.EstimatesPresented</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="text-muted small">@Localizer["Common_Approved"]</div>
            <div class="fs-4">@Model.Report.SelectedPeriod.EstimatesApproved</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="text-muted small">@Localizer["Common_Declined"]</div>
            <div class="fs-4">@Model.Report.SelectedPeriod.EstimatesDeclined</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="text-muted small">@Localizer["Reports_DecisionApprovalRate"]</div>
            <div class="fs-4">@ReportingDisplayFormatter.FormatApprovalRate(Model.Report.SelectedPeriod.DecisionApprovalRate)</div>
        </div>
    </div>
</div>

@if (Model.Report.DecisionSourceBreakdown is not null)
{
    <h3 class="h6">@string.Format(Localizer["Reports_DecisionSource"].Value, periodLabel)</h3>
    <table class="table table-sm table-bordered mb-4">
        <tbody>
        <tr><td>@Localizer["Reports_PortalApprovals"]</td><td>@Model.Report.DecisionSourceBreakdown.PortalApprovalsInPeriod</td></tr>
        <tr><td>@Localizer["Reports_PortalDeclines"]</td><td>@Model.Report.DecisionSourceBreakdown.PortalDeclinesInPeriod</td></tr>
        <tr><td>@Localizer["Reports_StaffApprovals"]</td><td>@Model.Report.DecisionSourceBreakdown.StaffApprovalsInPeriod</td></tr>
        <tr><td>@Localizer["Reports_StaffDeclines"]</td><td>@Model.Report.DecisionSourceBreakdown.StaffDeclinesInPeriod</td></tr>
        </tbody>
    </table>
}

<h2 class="h5">@Localizer["Reports_InvoiceState"]</h2>
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="border rounded p-3 bg-light">
            <div class="text-muted small">@Localizer["Reports_OutstandingInvoices"]</div>
            <div class="fs-4">@Model.Report.CurrentSnapshot.OutstandingInvoices</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3 bg-light">
            <div class="text-muted small">@Localizer["Status_Payment_Unpaid"]</div>
            <div class="fs-4">@Model.Report.CurrentInvoicePaymentStateBreakdown.Unpaid</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3 bg-light">
            <div class="text-muted small">@Localizer["Reports_PartiallyPaid"]</div>
            <div class="fs-4">@Model.Report.CurrentInvoicePaymentStateBreakdown.PartiallyPaid</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3 bg-light">
            <div class="text-muted small">@Localizer["Common_Paid"]</div>
            <div class="fs-4">@Model.Report.CurrentInvoicePaymentStateBreakdown.Paid</div>
        </div>
    </div>
</div>

<h3 class="h6">@Localizer["Reports_CurrentOutstanding"]</h3>
@if (Model.Report.CurrentSnapshot.CurrentOutstandingAmounts.Count == 0)
{
    <p class="text-muted">@Localizer["Reports_NoOutstanding"]</p>
}
else
{
    foreach (var amount in Model.Report.CurrentSnapshot.CurrentOutstandingAmounts)
    {
        <div>@ReportingDisplayFormatter.FormatMoney(amount)</div>
    }
}

<h2 class="h5 mt-4">@Localizer["Common_Period"] · @periodLabel</h2>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="border rounded p-3">
            <div class="text-muted small">@Localizer["Reports_InvoicesIssued"]</div>
            <div class="fs-4">@Model.Report.SelectedPeriod.InvoicesIssued</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-3">
            <div class="text-muted small">@Localizer["Reports_CommerciallyClosedJobs"]</div>
            <div class="fs-4">@Model.Report.SelectedPeriod.CommerciallyClosedJobs</div>
        </div>
    </div>
</div>

<h3 class="h6">@string.Format(Localizer["Reports_RecordedPayments"].Value, periodLabel)</h3>
@if (Model.Report.SelectedPeriod.RecordedPayments.Count == 0)
{
    <p class="text-muted">@Localizer["Common_NoActivityInPeriod"]</p>
}
else
{
    foreach (var payment in Model.Report.SelectedPeriod.RecordedPayments)
    {
        <div class="fs-5">@ReportingDisplayFormatter.FormatMoney(payment)</div>
    }
}

<h3 class="h6">@string.Format(Localizer["Reports_InvoicedAmounts"].Value, periodLabel)</h3>
@if (Model.Report.SelectedPeriod.InvoicedAmounts.Count == 0)
{
    <p class="text-muted">@Localizer["Common_NoActivityInPeriod"]</p>
}
else
{
    foreach (var amount in Model.Report.SelectedPeriod.InvoicedAmounts)
    {
        <div class="fs-5">@ReportingDisplayFormatter.FormatMoney(amount)</div>
    }
}

<p class="mt-4 text-muted small">
    @Localizer["Reports_PaymentsDisclaimer"]
</p>
