@model WorkshopOS.Web.Models.Reporting.OperationalReportViewModel
@using WorkshopOS.Domain.RepairOrders
@using WorkshopOS.Web.Models.Reporting
@{
    ViewData["Title"] = Localizer["Reports_OperationsTitle"].Value;
    var header = Model.Report.Header;
    var periodLabel = UiFormatting.FormatReportingPeriod(header);
    var locationLabel = UiFormatting.FormatLocationScope(header.WorkshopLocationName);
}

<header class="wos-page-header">
    <div>
        <p class="wos-page-eyebrow">@Localizer["Common_Reporting"]</p>
        <h1 class="wos-page-title">@Localizer["Reports_OperationsTitle"]</h1>
        <p class="wos-page-description">
            @locationLabel · @Localizer["Common_TimeZone"]: @header.TimeZoneId · @Localizer["Common_Generated"] @UiFormatting.FormatGeneratedAt(header.GeneratedAtUtc, header.TimeZoneId)
        </p>
    </div>
    <div class="wos-page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Dashboard" asp-action="Index">@Localizer["Common_Dashboard"]</a>
    </div>
</header>

@await Html.PartialAsync("_ReportingFilter", Model.Filter)

<h2 class="h5 mt-4">@Localizer["Reports_RoStatusActive"]</h2>
@if (Model.Report.RepairOrderStatusBreakdown.Count == 0)
{
    <p class="text-muted">@Localizer["Reports_NoActiveRo"]</p>
}
else
{
    <table class="table table-sm table-bordered">
        <thead><tr><th>@Localizer["Common_Status"]</th><th>@Localizer["Common_Count"]</th></tr></thead>
        <tbody>
        @foreach (var entry in Model.Report.RepairOrderStatusBreakdown.OrderBy(pair => pair.Key))
        {
            <tr><td>@entry.Key</td><td>@entry.Value</td></tr>
        }
        </tbody>
    </table>
}

<h2 class="h5">@Localizer["Reports_RoPriorityActive"]</h2>
<table class="table table-sm table-bordered">
    <thead><tr><th>@Localizer["Common_Priority"]</th><th>@Localizer["Common_Count"]</th></tr></thead>
    <tbody>
    @foreach (var entry in Model.Report.RepairOrderPriorityBreakdown.OrderBy(pair => pair.Key))
    {
        <tr><td>@entry.Key</td><td>@entry.Value</td></tr>
    }
    </tbody>
</table>

<h2 class="h5">@Localizer["Reports_AssignmentActive"]</h2>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="border rounded p-3 bg-light">
            <div class="text-muted small">@Localizer["Reports_AssignedCurrent"]</div>
            <div class="fs-4">@Model.Report.ActiveAssignedRepairOrders</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-3 bg-light">
            <div class="text-muted small">@Localizer["Reports_UnassignedCurrent"]</div>
            <div class="fs-4">@Model.Report.ActiveUnassignedRepairOrders</div>
        </div>
    </div>
</div>

<h2 class="h5">@string.Format(Localizer["Reports_AppointmentsPeriod"].Value, periodLabel)</h2>
<p class="text-muted small">@Localizer["Reports_AppointmentsScheduledHelp"]</p>
<div class="mb-2">@string.Format(Localizer["Reports_TotalScheduled"].Value, Model.Report.SelectedPeriod.AppointmentsScheduled)</div>
<table class="table table-sm table-bordered">
    <thead><tr><th>@Localizer["Common_Status"]</th><th>@Localizer["Common_Count"]</th></tr></thead>
    <tbody>
        <tr><td>@Localizer["Reports_Scheduled"]</td><td>@Model.Report.SelectedPeriod.AppointmentStatusBreakdown.Scheduled</td></tr>
        <tr><td>@Localizer["Reports_Confirmed"]</td><td>@Model.Report.SelectedPeriod.AppointmentStatusBreakdown.Confirmed</td></tr>
        <tr><td>@Localizer["Reports_CheckedIn"]</td><td>@Model.Report.SelectedPeriod.AppointmentStatusBreakdown.CheckedIn</td></tr>
        <tr><td>@Localizer["Common_Completed"]</td><td>@Model.Report.SelectedPeriod.AppointmentStatusBreakdown.Completed</td></tr>
        <tr><td>@Localizer["Status_Appointment_Cancelled"]</td><td>@Model.Report.SelectedPeriod.AppointmentStatusBreakdown.Cancelled</td></tr>
        <tr><td>@Localizer["Reports_NoShow"]</td><td>@Model.Report.SelectedPeriod.AppointmentStatusBreakdown.NoShow</td></tr>
    </tbody>
</table>

<h2 class="h5">@string.Format(Localizer["Reports_DviPeriod"].Value, periodLabel)</h2>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="border rounded p-3">
            <div class="text-muted small">@Localizer["Reports_InspectionsCompleted"]</div>
            <div class="fs-4">@Model.Report.SelectedPeriod.InspectionsCompleted</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-3">
            <div class="text-muted small">@Localizer["Reports_CriticalFindings"]</div>
            <div class="fs-4">@Model.Report.SelectedPeriod.CriticalInspectionFindings</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="border rounded p-3 bg-light">
            <div class="text-muted small">@Localizer["Reports_OpenDviCurrent"]</div>
            <div class="fs-4">@Model.Report.CurrentSnapshot.OpenDviInspections</div>
        </div>
    </div>
</div>

<h2 class="h5">@Localizer["Reports_TechnicianWorkload"]</h2>
@if (Model.Report.TechnicianWorkload.Count == 0)
{
    <p class="text-muted">@Localizer["Reports_NoActiveTechnicians"]</p>
}
else
{
    <table class="table table-bordered table-sm">
        <thead>
        <tr>
            <th>@Localizer["Common_Technician"]</th>
            <th>@Localizer["Common_Location"]</th>
            <th>@Localizer["Reports_ActiveAssigned"]</th>
            <th>@Localizer["Reports_InProgress"]</th>
            <th>@string.Format(Localizer["Reports_WorkCompletedPeriod"].Value, periodLabel)</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Report.TechnicianWorkload)
        {
            <tr>
                <td>@row.DisplayName</td>
                <td>@(row.WorkshopLocationName ?? Localizer["Common_NoValue"].Value)</td>
                <td>@row.ActiveAssignedJobs</td>
                <td>@row.InProgressJobs</td>
                <td>@row.WorkCompletedAssignmentsInPeriod</td>
            </tr>
        }
        </tbody>
    </table>
}

@if (Model.Report.LocationBreakdown.Count > 0)
{
    <h2 class="h5 mt-4">@Localizer["Reports_LocationBreakdown"]</h2>
    <table class="table table-bordered table-sm">
        <thead>
        <tr>
            <th>@Localizer["Common_Location"]</th>
            <th>@Localizer["Reports_ActiveRo"]</th>
            <th>@Localizer["Common_Unassigned"]</th>
            <th>@Localizer["Status_Priority_Urgent"]</th>
            <th>@Localizer["Reports_AppointmentsPeriodShort"]</th>
            <th>@Localizer["Reports_CompletedPeriod"]</th>
            <th>@Localizer["Reports_OpenDvi"]</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Report.LocationBreakdown)
        {
            <tr>
                <td>@row.Name</td>
                <td>@row.ActiveRepairOrders</td>
                <td>@row.UnassignedRepairOrders</td>
                <td>@row.UrgentRepairOrders</td>
                <td>@row.AppointmentsInPeriod</td>
                <td>@row.CompletedJobsInPeriod</td>
                <td>@row.OpenDviInspections</td>
            </tr>
        }
        </tbody>
    </table>
}

<p class="mt-4">
    <a asp-controller="Reports" asp-action="Commercial">@Localizer["Reports_CommercialLink"]</a> @Localizer["Reports_CommercialLinkSuffix"]
</p>
