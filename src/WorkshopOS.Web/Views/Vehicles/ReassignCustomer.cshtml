@model WorkshopOS.Web.Models.Vehicles.VehicleReassignViewModel
@{
    ViewData["Title"] = Localizer["Vehicles_ReassignTitle"];
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = Localizer["Vehicles_Eyebrow"].Value,
    Title = Localizer["Vehicles_ReassignTitle"].Value,
    Description = Model.VehicleSummary
})

<form asp-action="ReassignCustomer" asp-route-vehicleId="@Model.VehicleId" method="post" class="wos-form-shell">
    @Html.AntiForgeryToken()
    <partial name="_FormValidationSummary" />

    <section class="wos-form-section">
        <h2 class="wos-form-section-title">@Localizer["Vehicles_Section_CurrentOwnership"]</h2>
        <dl class="wos-dl">
            <div class="wos-dl-row">
                <dt>@Localizer["Field_CurrentCustomer"]</dt>
                <dd>@(Model.CurrentCustomerDisplayName ?? Localizer["Common_Unassigned"].Value)</dd>
            </div>
        </dl>
    </section>

    <section class="wos-form-section">
        <h2 class="wos-form-section-title">@Localizer["Vehicles_Section_NewCustomer"]</h2>
        <div class="wos-field wos-field-full">
            <label asp-for="NewCurrentCustomerId" class="wos-field-label"></label>
            <select asp-for="NewCurrentCustomerId" class="form-select">
                <option value="">@Localizer["Common_Unassigned"]</option>
                @foreach (var customer in Model.CustomerOptions)
                {
                    <option value="@customer.CustomerId">@customer.DisplayName</option>
                }
            </select>
            <span asp-validation-for="NewCurrentCustomerId" class="wos-field-error"></span>
        </div>
    </section>

    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">@Localizer["Common_Reassign"]</button>
        <a asp-action="Details" asp-route-vehicleId="@Model.VehicleId" class="btn btn-wos-quiet">@Localizer["Common_Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
