@model WorkshopOS.Web.Models.Vehicles.VehicleReassignViewModel
@{
    ViewData["Title"] = "Reassign customer";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Vehicles",
    Title = "Reassign customer",
    Description = Model.VehicleSummary
})

<form asp-action="ReassignCustomer" asp-route-vehicleId="@Model.VehicleId" method="post" class="wos-form-shell">
    @Html.AntiForgeryToken()
    <partial name="_FormValidationSummary" />

    <section class="wos-form-section">
        <h2 class="wos-form-section-title">Current ownership</h2>
        <dl class="wos-dl">
            <div class="wos-dl-row">
                <dt>Current customer</dt>
                <dd>@(Model.CurrentCustomerDisplayName ?? "Unassigned")</dd>
            </div>
        </dl>
    </section>

    <section class="wos-form-section">
        <h2 class="wos-form-section-title">New customer</h2>
        <div class="wos-field wos-field-full">
            <label asp-for="NewCurrentCustomerId" class="wos-field-label"></label>
            <select asp-for="NewCurrentCustomerId" class="form-select">
                <option value="">Unassigned</option>
                @foreach (var customer in Model.CustomerOptions)
                {
                    <option value="@customer.CustomerId">@customer.DisplayName</option>
                }
            </select>
            <span asp-validation-for="NewCurrentCustomerId" class="wos-field-error"></span>
        </div>
    </section>

    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">Reassign</button>
        <a asp-action="Details" asp-route-vehicleId="@Model.VehicleId" class="btn btn-wos-quiet">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
