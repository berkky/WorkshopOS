@model WorkshopOS.Web.Models.Vehicles.VehicleFormViewModel
@{
    ViewData["Title"] = Localizer["Vehicles_EditTitle"];
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = Localizer["Vehicles_Eyebrow"].Value,
    Title = Localizer["Vehicles_EditTitle"].Value,
    Description = $"{Model.Make} {Model.Model}"
})

<form asp-action="Edit" asp-route-vehicleId="@Model.VehicleId" method="post" class="wos-form-shell">
    @Html.AntiForgeryToken()
    <partial name="_VehicleFormFields" model="Model" />
    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">@Localizer["Common_SaveChanges"]</button>
        <a asp-action="Details" asp-route-vehicleId="@Model.VehicleId" class="btn btn-wos-quiet">@Localizer["Common_Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
