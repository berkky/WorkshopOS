@model WorkshopOS.Web.Models.Vehicles.VehicleFormViewModel
@{
    ViewData["Title"] = "Edit vehicle";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Vehicles",
    Title = "Edit vehicle",
    Description = $"{Model.Make} {Model.Model}"
})

<form asp-action="Edit" asp-route-vehicleId="@Model.VehicleId" method="post" class="wos-form-shell">
    @Html.AntiForgeryToken()
    <partial name="_VehicleFormFields" model="Model" />
    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">Save changes</button>
        <a asp-action="Details" asp-route-vehicleId="@Model.VehicleId" class="btn btn-wos-quiet">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
