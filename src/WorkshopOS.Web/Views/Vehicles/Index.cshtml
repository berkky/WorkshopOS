@model WorkshopOS.Web.Models.Vehicles.VehicleListViewModel
@{
    ViewData["Title"] = "Vehicles";
    var paginationRouteValues = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        paginationRouteValues["search"] = Model.Search;
    }
    if (Model.CurrentCustomerId.HasValue)
    {
        paginationRouteValues["currentCustomerId"] = Model.CurrentCustomerId.Value.ToString();
    }
}

<header class="wos-page-header">
    <div>
        <h1 class="wos-page-title">Vehicles</h1>
        @if (Model.CurrentCustomerId.HasValue && !string.IsNullOrWhiteSpace(Model.CurrentCustomerDisplayName))
        {
            <p class="wos-page-description">
                Showing vehicles for
                <a asp-controller="Customers" asp-action="Details" asp-route-customerId="@Model.CurrentCustomerId">@Model.CurrentCustomerDisplayName</a>
                — @Model.TotalCount vehicle(s)
            </p>
        }
        else
        {
            <p class="wos-page-description">@Model.TotalCount vehicle(s) in current view</p>
        }
    </div>
    @if (Model.CanManageVehicles)
    {
        <div class="wos-page-actions">
            <a class="btn btn-wos-primary"
               asp-action="Create"
               asp-route-currentCustomerId="@Model.CurrentCustomerId">Create vehicle</a>
        </div>
    }
</header>

<form asp-action="Index" method="get" class="wos-filter-bar row g-3 align-items-end mb-4">
    @if (Model.CurrentCustomerId.HasValue)
    {
        <input type="hidden" name="currentCustomerId" value="@Model.CurrentCustomerId" />
    }
    <div class="col-md-6">
        <label class="form-label">Search</label>
        <input name="search" value="@Model.Search" class="form-control" placeholder="Make, model, plate, VIN, or customer" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Search</button>
    </div>
</form>

@if (Model.Vehicles.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = "No vehicles", Description = "No vehicles match the current filters." })
}
else
{
    <div class="wos-table-wrap wos-desktop-table">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Vehicle</th>
                    <th>Plate</th>
                    <th>VIN</th>
                    <th>Customer</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var vehicle in Model.Vehicles)
            {
                <tr>
                    <td>@vehicle.Make @vehicle.Model@(vehicle.ModelYear.HasValue ? $" ({vehicle.ModelYear})" : "")</td>
                    <td>@(vehicle.RegistrationPlate ?? "—")</td>
                    <td>@(vehicle.Vin ?? "—")</td>
                    <td>@(vehicle.CurrentCustomerDisplayName ?? "Unassigned")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-vehicleId="@vehicle.VehicleId" class="btn btn-sm btn-outline-primary">View</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="wos-mobile-list">
        @foreach (var vehicle in Model.Vehicles)
        {
            <a asp-action="Details" asp-route-vehicleId="@vehicle.VehicleId" class="wos-list-card">
                <div class="wos-list-card-title">@vehicle.Make @vehicle.Model@(vehicle.ModelYear.HasValue ? $" ({vehicle.ModelYear})" : "")</div>
                <div class="wos-list-card-meta">
                    <span>@(vehicle.RegistrationPlate ?? "No plate")</span>
                    <span>@(vehicle.CurrentCustomerDisplayName ?? "Unassigned")</span>
                </div>
            </a>
        }
    </div>

    @await Html.PartialAsync("_Pagination", new PaginationViewModel
    {
        Action = "Index",
        Page = Model.Page,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        RouteValues = paginationRouteValues
    })
}
