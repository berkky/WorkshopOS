@model WorkshopOS.Web.Models.Vehicles.VehicleListViewModel
@{
    ViewData["Title"] = Localizer["Vehicles_Title"];
    var paginationRouteValues = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        paginationRouteValues["search"] = Model.Search;
    }
    if (Model.CurrentCustomerId.HasValue)
    {
        paginationRouteValues["currentCustomerId"] = Model.CurrentCustomerId.Value.ToString();
    }
}

<header class="wos-page-header">
    <div>
        <h1 class="wos-page-title">@Localizer["Vehicles_Title"]</h1>
        @if (Model.CurrentCustomerId.HasValue && !string.IsNullOrWhiteSpace(Model.CurrentCustomerDisplayName))
        {
            <p class="wos-page-description">
                @Localizer["Vehicles_ListCountForCustomer"]
                <a asp-controller="Customers" asp-action="Details" asp-route-customerId="@Model.CurrentCustomerId">@Model.CurrentCustomerDisplayName</a>
                @Localizer["Vehicles_ListCountSuffix", Model.TotalCount]
            </p>
        }
        else
        {
            <p class="wos-page-description">@Localizer["Vehicles_ListCount", Model.TotalCount]</p>
        }
    </div>
    @if (Model.CanManageVehicles)
    {
        <div class="wos-page-actions">
            <a class="btn btn-wos-primary"
               asp-action="Create"
               asp-route-currentCustomerId="@Model.CurrentCustomerId">@Localizer["Vehicles_Create"]</a>
        </div>
    }
</header>

<form asp-action="Index" method="get" class="wos-filter-bar row g-3 align-items-end mb-4">
    @if (Model.CurrentCustomerId.HasValue)
    {
        <input type="hidden" name="currentCustomerId" value="@Model.CurrentCustomerId" />
    }
    <div class="col-md-6">
        <label class="form-label">@Localizer["Common_Search"]</label>
        <input name="search" value="@Model.Search" class="form-control" placeholder="@Localizer["Vehicles_SearchPlaceholder"]" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">@Localizer["Common_Search"]</button>
    </div>
</form>

@if (Model.Vehicles.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = Localizer["Vehicles_Empty_Title"].Value, Description = Localizer["Vehicles_Empty_Description"].Value })
}
else
{
    <div class="wos-table-wrap wos-desktop-table">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@Localizer["Common_Vehicle"]</th>
                    <th>@Localizer["Vehicles_Column_Plate"]</th>
                    <th>@Localizer["Field_VinChassis"]</th>
                    <th>@Localizer["Common_Customer"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var vehicle in Model.Vehicles)
            {
                <tr>
                    <td>@vehicle.Make @vehicle.Model@(vehicle.ModelYear.HasValue ? $" ({vehicle.ModelYear})" : "")</td>
                    <td>@(vehicle.RegistrationPlate ?? Localizer["Common_NotAvailable"].Value)</td>
                    <td>@(vehicle.Vin ?? Localizer["Common_NotAvailable"].Value)</td>
                    <td>@(vehicle.CurrentCustomerDisplayName ?? Localizer["Common_Unassigned"].Value)</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-vehicleId="@vehicle.VehicleId" class="btn btn-sm btn-outline-primary">@Localizer["Common_View"]</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="wos-mobile-list">
        @foreach (var vehicle in Model.Vehicles)
        {
            <a asp-action="Details" asp-route-vehicleId="@vehicle.VehicleId" class="wos-list-card">
                <div class="wos-list-card-title">@vehicle.Make @vehicle.Model@(vehicle.ModelYear.HasValue ? $" ({vehicle.ModelYear})" : "")</div>
                <div class="wos-list-card-meta">
                    <span>@(vehicle.RegistrationPlate ?? Localizer["Common_NoPlate"].Value)</span>
                    <span>@(vehicle.CurrentCustomerDisplayName ?? Localizer["Common_Unassigned"].Value)</span>
                </div>
            </a>
        }
    </div>

    @await Html.PartialAsync("_Pagination", new PaginationViewModel
    {
        Action = "Index",
        Page = Model.Page,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        RouteValues = paginationRouteValues
    })
}
