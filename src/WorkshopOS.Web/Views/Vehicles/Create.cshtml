@model WorkshopOS.Web.Models.Vehicles.VehicleFormViewModel
@{
    ViewData["Title"] = "Create vehicle";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Vehicles",
    Title = "Create vehicle",
    Description = "Register a vehicle and optionally link it to a customer."
})

<form asp-action="Create" method="post" class="wos-form-shell">
    @Html.AntiForgeryToken()
    <partial name="_VehicleFormFields" model="Model" />
    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">Create vehicle</button>
        <a asp-action="Index" class="btn btn-wos-quiet">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
