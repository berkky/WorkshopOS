@model WorkshopOS.Web.Models.Vehicles.VehicleFormViewModel
@{
    ViewData["Title"] = "Create vehicle";
}

<h1 class="display-6">Create vehicle</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <partial name="_VehicleFormFields" model="Model" />
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
