@model WorkshopOS.Web.Models.Vehicles.VehicleFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Make" class="form-label"></label>
    <input asp-for="Make" class="form-control" />
    <span asp-validation-for="Make" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Model" class="form-label"></label>
    <input asp-for="Model" class="form-control" />
    <span asp-validation-for="Model" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="ModelYear" class="form-label"></label>
    <input asp-for="ModelYear" class="form-control" type="number" min="1886" />
    <span asp-validation-for="ModelYear" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Vin" class="form-label"></label>
    <input asp-for="Vin" class="form-control" autocomplete="off" />
    <span asp-validation-for="Vin" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="RegistrationPlate" class="form-label"></label>
    <input asp-for="RegistrationPlate" class="form-control" autocomplete="off" />
    <span asp-validation-for="RegistrationPlate" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Color" class="form-label"></label>
    <input asp-for="Color" class="form-control" />
    <span asp-validation-for="Color" class="text-danger"></span>
</div>

@if (!Model.VehicleId.HasValue)
{
    <div class="mb-3">
        <label asp-for="CurrentCustomerId" class="form-label"></label>
        <select asp-for="CurrentCustomerId" class="form-select">
            <option value="">Unassigned</option>
            @foreach (var customer in Model.CustomerOptions)
            {
                <option value="@customer.CustomerId">@customer.DisplayName</option>
            }
        </select>
        <span asp-validation-for="CurrentCustomerId" class="text-danger"></span>
    </div>
}
