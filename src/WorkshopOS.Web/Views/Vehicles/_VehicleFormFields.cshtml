@model WorkshopOS.Web.Models.Vehicles.VehicleFormViewModel

<partial name="_FormValidationSummary" />

<section class="wos-form-section">
    <h2 class="wos-form-section-title">@Localizer["Vehicles_Section_Identity"]</h2>
    <div class="wos-form-grid wos-form-grid-2">
        <div class="wos-field">
            <label asp-for="Make" class="wos-field-label"></label>
            <input asp-for="Make" class="form-control" />
            <span asp-validation-for="Make" class="wos-field-error"></span>
        </div>
        <div class="wos-field">
            <label asp-for="Model" class="wos-field-label"></label>
            <input asp-for="Model" class="form-control" />
            <span asp-validation-for="Model" class="wos-field-error"></span>
        </div>
        <div class="wos-field">
            <label asp-for="ModelYear" class="wos-field-label"></label>
            <input asp-for="ModelYear" class="form-control" type="number" min="1886" />
            <span asp-validation-for="ModelYear" class="wos-field-error"></span>
        </div>
        <div class="wos-field">
            <label asp-for="Color" class="wos-field-label"></label>
            <input asp-for="Color" class="form-control" />
            <span asp-validation-for="Color" class="wos-field-error"></span>
        </div>
        <div class="wos-field">
            <label asp-for="RegistrationPlate" class="wos-field-label"></label>
            <input asp-for="RegistrationPlate" class="form-control" autocomplete="off" />
            <span asp-validation-for="RegistrationPlate" class="wos-field-error"></span>
        </div>
        <div class="wos-field">
            <label asp-for="Vin" class="wos-field-label"></label>
            <input asp-for="Vin" class="form-control" autocomplete="off" />
            <span asp-validation-for="Vin" class="wos-field-error"></span>
        </div>
    </div>
</section>

@if (!Model.VehicleId.HasValue)
{
    <section class="wos-form-section">
        <h2 class="wos-form-section-title">@Localizer["Vehicles_Section_Ownership"]</h2>
        <div class="wos-field wos-field-full">
            <label asp-for="CurrentCustomerId" class="wos-field-label"></label>
            <select asp-for="CurrentCustomerId" class="form-select">
                <option value="">@Localizer["Common_Unassigned"]</option>
                @foreach (var customer in Model.CustomerOptions)
                {
                    <option value="@customer.CustomerId">@customer.DisplayName</option>
                }
            </select>
            <span asp-validation-for="CurrentCustomerId" class="wos-field-error"></span>
        </div>
    </section>
}
