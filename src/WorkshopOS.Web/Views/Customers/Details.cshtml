@model WorkshopOS.Web.Models.Customers.CustomerDetailsViewModel
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Model.DisplayName;
}

@await Html.PartialAsync("_DetailWorkspaceHeader", new DetailWorkspaceHeaderViewModel
{
    Eyebrow = Localizer["Customers_DetailEyebrow"].Value,
    Title = Model.DisplayName,
    Meta = new HtmlString($"""
        {(string.IsNullOrWhiteSpace(Model.Email) ? Localizer["Customers_NoEmailOnFile"].Value : Model.Email)}
        {(string.IsNullOrWhiteSpace(Model.Phone) ? "" : $" · {Model.Phone}")}
        """),
    StatusBadges = await Html.PartialAsync("_StatusBadge", StatusPresentation.ForActive(Model.IsActive))
})

<div class="wos-action-cluster mb-4">
    @if (Model.CanManageCustomers)
    {
        <a asp-action="Edit" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-secondary">@Localizer["Common_Edit"]</a>
        @if (Model.IsActive)
        {
            <form asp-action="Deactivate" asp-route-customerId="@Model.CustomerId" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-warning">@Localizer["Common_Deactivate"]</button>
            </form>
        }
        else
        {
            <form asp-action="Activate" asp-route-customerId="@Model.CustomerId" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-success">@Localizer["Common_Activate"]</button>
            </form>
        }
    }
    <a asp-action="Index" class="btn btn-wos-quiet">@Localizer["Common_BackToList"]</a>
</div>

<div class="wos-detail-grid">
    <section class="wos-detail-panel">
        <h2 class="wos-detail-panel-title">@Localizer["Customers_Information"]</h2>
        <dl class="wos-dl">
            <div class="wos-dl-row">
                <dt>@Localizer["Common_Status"]</dt>
                <dd><partial name="_StatusBadge" model="StatusPresentation.ForActive(Model.IsActive)" /></dd>
            </div>
            <div class="wos-dl-row">
                <dt>@Localizer["Common_Created"]</dt>
                <dd>@UiFormatting.FormatDateTime(Model.CreatedAtUtc)</dd>
            </div>
            <div class="wos-dl-row">
                <dt>@Localizer["Common_Updated"]</dt>
                <dd>@UiFormatting.FormatDateTime(Model.UpdatedAtUtc)</dd>
            </div>
        </dl>
    </section>
    <section class="wos-detail-panel">
        <h2 class="wos-detail-panel-title">@Localizer["Customers_ContactInformation"]</h2>
        <dl class="wos-dl">
            <div class="wos-dl-row">
                <dt>@Localizer["Common_Email"]</dt>
                <dd>@(Model.Email ?? Localizer["Common_NotAvailable"].Value)</dd>
            </div>
            <div class="wos-dl-row">
                <dt>@Localizer["Common_Phone"]</dt>
                <dd>@(Model.Phone ?? Localizer["Common_NotAvailable"].Value)</dd>
            </div>
        </dl>
    </section>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Notes))
{
    <section class="wos-workspace-section">
        <h2 class="wos-section-title">@Localizer["Common_Notes"]</h2>
        <div class="wos-note-block">@Model.Notes</div>
    </section>
}

<div class="wos-related-modules">
    @await Html.PartialAsync("_RelatedModule", new RelatedModuleViewModel
    {
        Title = Localizer["Customers_Related_Vehicles"].Value,
        Summary = Localizer["Customers_Related_VehiclesSummary", Model.VehicleCount].Value,
        PrimaryLinkText = Localizer["Customers_Related_ViewVehicles"].Value,
        PrimaryLinkUrl = Url.Action("Index", "Vehicles", new { currentCustomerId = Model.CustomerId })!,
        SecondaryLinkText = Model.CanManageCustomers ? Localizer["Customers_Related_AddVehicle"].Value : null,
        SecondaryLinkUrl = Model.CanManageCustomers ? Url.Action("Create", "Vehicles", new { currentCustomerId = Model.CustomerId }) : null
    })
    @await Html.PartialAsync("_RelatedModule", new RelatedModuleViewModel
    {
        Title = Localizer["Customers_Related_Appointments"].Value,
        Summary = Localizer["Customers_Related_AppointmentsSummary", Model.UpcomingAppointmentCount].Value,
        PrimaryLinkText = Localizer["Customers_Related_ViewAppointments"].Value,
        PrimaryLinkUrl = Url.Action("Index", "Appointments", new { customerId = Model.CustomerId })!
    })
    @await Html.PartialAsync("_RelatedModule", new RelatedModuleViewModel
    {
        Title = Localizer["Customers_Related_RepairOrders"].Value,
        Summary = Localizer["Customers_Related_RepairOrdersSummary", Model.RepairOrderCount].Value,
        PrimaryLinkText = Localizer["Customers_Related_ViewRepairOrders"].Value,
        PrimaryLinkUrl = Url.Action("Index", "RepairOrders", new { customerId = Model.CustomerId })!
    })
</div>

@if (Model.RecentRepairOrders.Count > 0)
{
    <section class="wos-workspace-section">
        <h2 class="wos-section-title">@Localizer["Customers_RecentRepairOrders"]</h2>
        <div class="wos-table-wrap">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>@Localizer["Common_Number"]</th>
                        <th>@Localizer["Common_Vehicle"]</th>
                        <th>@Localizer["Common_Status"]</th>
                        <th>@Localizer["Common_Opened"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var repairOrder in Model.RecentRepairOrders)
                {
                    <tr>
                        <td>@repairOrder.Number</td>
                        <td>@repairOrder.VehicleSummary</td>
                        <td><partial name="_StatusBadge" model="StatusPresentation.ForRepairOrder(repairOrder.Status)" /></td>
                        <td>@UiFormatting.FormatDateTime(repairOrder.OpenedAtUtc)</td>
                        <td class="text-end">
                            <a asp-controller="RepairOrders" asp-action="Details" asp-route-repairOrderId="@repairOrder.RepairOrderId" class="btn btn-sm btn-outline-primary">@Localizer["Common_View"]</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
