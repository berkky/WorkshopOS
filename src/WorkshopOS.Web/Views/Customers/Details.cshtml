@model WorkshopOS.Web.Models.Customers.CustomerDetailsViewModel
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = Model.DisplayName;
}

@await Html.PartialAsync("_DetailWorkspaceHeader", new DetailWorkspaceHeaderViewModel
{
    Eyebrow = "Customer",
    Title = Model.DisplayName,
    Meta = new HtmlString($"""
        {(string.IsNullOrWhiteSpace(Model.Email) ? "No email on file" : Model.Email)}
        {(string.IsNullOrWhiteSpace(Model.Phone) ? "" : $" · {Model.Phone}")}
        """),
    StatusBadges = await Html.PartialAsync("_StatusBadge", StatusPresentation.ForActive(Model.IsActive))
})

<div class="wos-action-cluster mb-4">
    @if (Model.CanManageCustomers)
    {
        <a asp-action="Edit" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-secondary">Edit</a>
        @if (Model.IsActive)
        {
            <form asp-action="Deactivate" asp-route-customerId="@Model.CustomerId" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-warning">Deactivate</button>
            </form>
        }
        else
        {
            <form asp-action="Activate" asp-route-customerId="@Model.CustomerId" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-success">Activate</button>
            </form>
        }
    }
    <a asp-action="Index" class="btn btn-wos-quiet">Back to list</a>
</div>

<div class="wos-detail-grid">
    <section class="wos-detail-panel">
        <h2 class="wos-detail-panel-title">Customer information</h2>
        <dl class="wos-dl">
            <div class="wos-dl-row">
                <dt>Status</dt>
                <dd><partial name="_StatusBadge" model="StatusPresentation.ForActive(Model.IsActive)" /></dd>
            </div>
            <div class="wos-dl-row">
                <dt>Created</dt>
                <dd>@Model.CreatedAtUtc.ToString("u")</dd>
            </div>
            <div class="wos-dl-row">
                <dt>Updated</dt>
                <dd>@Model.UpdatedAtUtc.ToString("u")</dd>
            </div>
        </dl>
    </section>
    <section class="wos-detail-panel">
        <h2 class="wos-detail-panel-title">Contact information</h2>
        <dl class="wos-dl">
            <div class="wos-dl-row">
                <dt>Email</dt>
                <dd>@(Model.Email ?? "—")</dd>
            </div>
            <div class="wos-dl-row">
                <dt>Phone</dt>
                <dd>@(Model.Phone ?? "—")</dd>
            </div>
        </dl>
    </section>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Notes))
{
    <section class="wos-workspace-section">
        <h2 class="wos-section-title">Notes</h2>
        <div class="wos-note-block">@Model.Notes</div>
    </section>
}

<div class="wos-related-modules">
    @await Html.PartialAsync("_RelatedModule", new RelatedModuleViewModel
    {
        Title = "Vehicles",
        Summary = $"{Model.VehicleCount} vehicle(s) currently linked.",
        PrimaryLinkText = "View vehicles",
        PrimaryLinkUrl = Url.Action("Index", "Vehicles", new { currentCustomerId = Model.CustomerId })!,
        SecondaryLinkText = Model.CanManageCustomers ? "Add vehicle" : null,
        SecondaryLinkUrl = Model.CanManageCustomers ? Url.Action("Create", "Vehicles", new { currentCustomerId = Model.CustomerId }) : null
    })
    @await Html.PartialAsync("_RelatedModule", new RelatedModuleViewModel
    {
        Title = "Appointments",
        Summary = $"{Model.UpcomingAppointmentCount} upcoming appointment(s).",
        PrimaryLinkText = "View appointments",
        PrimaryLinkUrl = Url.Action("Index", "Appointments", new { customerId = Model.CustomerId })!
    })
    @await Html.PartialAsync("_RelatedModule", new RelatedModuleViewModel
    {
        Title = "Repair orders",
        Summary = $"{Model.RepairOrderCount} repair order(s).",
        PrimaryLinkText = "View repair orders",
        PrimaryLinkUrl = Url.Action("Index", "RepairOrders", new { customerId = Model.CustomerId })!
    })
</div>

@if (Model.RecentRepairOrders.Count > 0)
{
    <section class="wos-workspace-section">
        <h2 class="wos-section-title">Recent repair orders</h2>
        <div class="wos-table-wrap">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Number</th>
                        <th>Vehicle</th>
                        <th>Status</th>
                        <th>Opened</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var repairOrder in Model.RecentRepairOrders)
                {
                    <tr>
                        <td>@repairOrder.Number</td>
                        <td>@repairOrder.VehicleSummary</td>
                        <td><partial name="_StatusBadge" model="StatusPresentation.ForRepairOrder(repairOrder.Status)" /></td>
                        <td>@repairOrder.OpenedAtUtc.ToString("u")</td>
                        <td class="text-end">
                            <a asp-controller="RepairOrders" asp-action="Details" asp-route-repairOrderId="@repairOrder.RepairOrderId" class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
