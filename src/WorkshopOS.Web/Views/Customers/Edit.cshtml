@model WorkshopOS.Web.Models.Customers.CustomerFormViewModel
@{
    ViewData["Title"] = Localizer["Customers_EditTitle"];
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = Localizer["Customers_Eyebrow"].Value,
    Title = Localizer["Customers_EditTitle"].Value,
    Description = Model.DisplayName
})

<form asp-action="Edit" asp-route-customerId="@Model.CustomerId" method="post" class="wos-form-shell">
    @Html.AntiForgeryToken()
    <partial name="_CustomerFormFields" model="Model" />
    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">@Localizer["Common_SaveChanges"]</button>
        <a asp-action="Details" asp-route-customerId="@Model.CustomerId" class="btn btn-wos-quiet">@Localizer["Common_Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
