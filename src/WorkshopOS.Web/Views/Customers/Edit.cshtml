@model WorkshopOS.Web.Models.Customers.CustomerFormViewModel
@{
    ViewData["Title"] = "Edit customer";
}

<h1 class="display-6">Edit customer</h1>

<form asp-action="Edit" asp-route-customerId="@Model.CustomerId" method="post">
    <partial name="_CustomerFormFields" model="Model" />
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-action="Details" asp-route-customerId="@Model.CustomerId" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
