@model WorkshopOS.Web.Models.Customers.CustomerListViewModel
@{
    ViewData["Title"] = Localizer["Customers_Title"];
}

<header class="wos-page-header">
    <div>
        <h1 class="wos-page-title">@Localizer["Customers_Title"]</h1>
        <p class="wos-page-description">@Localizer["Customers_ListCount", Model.TotalCount]</p>
    </div>
    @if (Model.CanManageCustomers)
    {
        <div class="wos-page-actions">
            <a class="btn btn-wos-primary" asp-action="Create">@Localizer["Customers_Create"]</a>
        </div>
    }
</header>

<form asp-action="Index" method="get" class="wos-filter-bar row g-3 align-items-end mb-4">
    <div class="col-md-6">
        <label class="form-label">@Localizer["Common_Search"]</label>
        <input name="search" value="@Model.Search" class="form-control" placeholder="@Localizer["Customers_SearchPlaceholder"]" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">@Localizer["Common_Search"]</button>
    </div>
</form>

@if (Model.Customers.Count == 0)
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Title = Localizer["Customers_Empty_Title"].Value, Description = Localizer["Customers_Empty_Description"].Value })
}
else
{
    <div class="wos-table-wrap">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>@Localizer["Common_Name"]</th>
                <th>@Localizer["Common_Email"]</th>
                <th>@Localizer["Common_Phone"]</th>
                <th>@Localizer["Common_Status"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var customer in Model.Customers)
        {
            <tr>
                <td>@customer.DisplayName</td>
                <td>@customer.Email</td>
                <td>@customer.Phone</td>
                <td><partial name="_StatusBadge" model="StatusPresentation.ForActive(customer.IsActive)" /></td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-customerId="@customer.CustomerId" class="btn btn-sm btn-outline-primary">@Localizer["Common_View"]</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>

    @await Html.PartialAsync("_Pagination", new PaginationViewModel
    {
        Action = "Index",
        Page = Model.Page,
        PageSize = Model.PageSize,
        TotalCount = Model.TotalCount,
        RouteValues = !string.IsNullOrWhiteSpace(Model.Search)
            ? new Dictionary<string, string> { ["search"] = Model.Search }
            : new Dictionary<string, string>()
    })
}
