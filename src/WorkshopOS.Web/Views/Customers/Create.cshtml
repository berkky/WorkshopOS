@model WorkshopOS.Web.Models.Customers.CustomerFormViewModel
@{
    ViewData["Title"] = "Create customer";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Eyebrow = "Customers",
    Title = "Create customer",
    Description = "Add a new customer to the workshop CRM."
})

<form asp-action="Create" method="post" class="wos-form-shell">
    @Html.AntiForgeryToken()
    <partial name="_CustomerFormFields" model="Model" />
    <div class="wos-form-actions">
        <button type="submit" class="btn btn-wos-primary">Create customer</button>
        <a asp-action="Index" class="btn btn-wos-quiet">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
